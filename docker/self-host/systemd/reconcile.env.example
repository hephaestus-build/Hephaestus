# Copy to /etc/hephaestus/reconcile.env (root:root, 0600) and adjust.

# Which channel on the deploy-state branch this host follows.
HEPHAESTUS_CHANNEL=staging

# The stacks this host owns, in any order; the reconciler applies them in dependency order.
# A host whose edge is owned by something else (a shared proxy, a PaaS) omits `proxy`.
HEPHAESTUS_STACKS="core app"

# Per-stack environment files: <stack>.env for every stack above, root-owned and 0600.
# A host whose stack is `chart` reads its site values from chart.yaml here instead.
HEPHAESTUS_SECRETS=/etc/hephaestus

# Only with HEPHAESTUS_STACKS=chart: the Helm release, its namespace, the chart profiles (each one
# applied over the one before it), the pinned Helm binary, and the cluster's kubeconfig.
# docs/admin/pull-based-deployment.mdx § Follow a channel with the chart.
# HEPHAESTUS_CHART_RELEASE=hephaestus
# HEPHAESTUS_CHART_NAMESPACE=hephaestus
# HEPHAESTUS_CHART_PROFILE="small small-16gib"
# HEPHAESTUS_HELM=/usr/local/bin/helm
# KUBECONFIG=/etc/rancher/k3s/k3s.yaml

# The identity allowed to move this host. Must be the promotion workflow, on the default branch.
HEPHAESTUS_PROMOTE_IDENTITY=https://github.com/hephaestus-build/Hephaestus/.github/workflows/promote.yml@refs/heads/main

# Optional: an existing node_exporter textfile collector path.
HEPHAESTUS_METRICS_FILE=

# How long to wait for a stack to report healthy. Must exceed each service's
# start_period + interval x retries, or a slow boot reads as a failed deploy. With the chart it is
# Helm's --timeout, 1200 when unset, longer than the 10 minutes that a new Pod waits for the schema.
HEPHAESTUS_WAIT_TIMEOUT=600

# Below this much free space, in GiB, the reconciler removes unkept release images and then
# refuses to pull a release.
HEPHAESTUS_MIN_FREE_GIB=10
