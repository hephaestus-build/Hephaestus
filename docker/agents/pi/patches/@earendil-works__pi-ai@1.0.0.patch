index 0000000000000000000000000000000000000000..9e6396bf842a2f24acd7519ea825a51f01b3f429
--- /dev/null
+++ b/dist/api/openai-call-diagnostics.js
@@ -0,0 +1,38 @@
+import OpenAI from "openai";
+/**
+ * Closed facts about why an OpenAI call failed, for a caller's diagnostics: the SDK's own error classes and numeric
+ * status, and the adapter's own named terminal branch. Never the error's text, body, headers or request.
+ */
+export function failureDetails(error, signal, adapterFailure, phase) {
+    let kind = "UNKNOWN";
+    let status;
+    if (signal?.aborted || error instanceof OpenAI.APIUserAbortError) {
+        kind = "ABORTED";
+    }
+    else if (adapterFailure) {
+        kind = adapterFailure;
+    }
+    else if (error instanceof OpenAI.APIConnectionTimeoutError) {
+        kind = "CONNECTION_TIMEOUT";
+    }
+    else if (error instanceof OpenAI.APIConnectionError) {
+        kind = "CONNECTION_ERROR";
+    }
+    else if (error instanceof OpenAI.APIError && Number.isInteger(error.status) && error.status >= 400 && error.status <= 599) {
+        kind = "HTTP_ERROR";
+        status = error.status;
+    }
+    return status === undefined ? { kind, phase } : { kind, phase, status };
+}
+/**
+ * When one call reached its boundaries, in whole milliseconds of the monotonic clock from just before the SDK request:
+ * the SDK response (its headers, not a first token) and the end of this message. The span includes request retries
+ * and their waits within the adapter. A boundary the call never reached is left out.
+ */
+export function callDetails(requestStartedAt, responseAt) {
+    const details = { elapsedMs: Math.round(performance.now() - requestStartedAt) };
+    if (responseAt !== undefined) {
+        details.responseMs = Math.round(responseAt - requestStartedAt);
+    }
+    return details;
+}
