diff --git adist/api/openai-token-usage.js b/dist/api/openai-token-usage.js
new file mode 100644
index 0000000000000000000000000000000000000000..677aeb64a3af465c10abbf6069c01512a7677aa5
--- /dev/null
+++ b/dist/api/openai-token-usage.js
@@ -0,0 +1,44 @@
+// Token usage reported by OpenAI-compatible APIs. Returns undefined when the counts are missing, not
+// non-negative 32-bit integers, contradictory, or when cache details exceed the inclusive input total.
+// Callers keep their earlier usage instead: unusable telemetry never becomes recorded spend and never
+// discards the response.
+const MAX_COUNT = 2147483647;
+function count(value) {
+    return Number.isInteger(value) && value >= 0 && value <= MAX_COUNT ? value : undefined;
+}
+function optionalCount(value) {
+    return value == null ? 0 : count(value);
+}
+/** Proxies name cache writes cache_write_tokens or created_cache_tokens; both present must agree. */
+function cacheWriteCount(details) {
+    const standard = details?.cache_write_tokens;
+    const alias = details?.created_cache_tokens;
+    if (standard != null && alias != null) {
+        return count(standard) !== undefined && standard === alias ? standard : undefined;
+    }
+    return optionalCount(standard ?? alias);
+}
+/**
+ * @param inclusiveInput prompt tokens, including cache reads and writes
+ * @param output output tokens, including reasoning
+ */
+export function openAITokenUsage({ inclusiveInput, output, cacheRead, inputDetails, reasoning }) {
+    const prompt = count(inclusiveInput);
+    const out = count(output);
+    const read = optionalCount(cacheRead);
+    const write = cacheWriteCount(inputDetails);
+    const reasoningTokens = optionalCount(reasoning);
+    if (prompt === undefined || out === undefined || read === undefined || write === undefined
+        || reasoningTokens === undefined || read + write > prompt) {
+        return undefined;
+    }
+    return {
+        input: prompt - read - write,
+        output: out,
+        cacheRead: read,
+        cacheWrite: write,
+        reasoning: reasoningTokens,
+        totalTokens: prompt + out,
+        cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+    };
+}
