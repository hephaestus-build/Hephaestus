{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:best-practices", ":semanticCommitTypeAll(chore)"],
	"labels": ["dependencies"],
	"prBodyNotes": [
		"**Human review required:** Passing CI checks does not approve this dependency update. A maintainer with write access must approve it before it can enter the merge queue; Renovate is not auto-approved. See the [review policy](https://docs.hephaestus.build/contributor/ci-cd#merge-policy)."
	],
	"assigneesFromCodeOwners": true,
	"timezone": "Europe/Berlin",
	"schedule": ["before 7am on monday"],
	"minimumReleaseAge": "3 days",
	"semanticCommitScope": "deps",
	"enabledManagers": [
		"npm",
		"gradle",
		"gradle-wrapper",
		"dockerfile",
		"docker-compose",
		"github-actions",
		"custom.regex"
	],
	"dependencyDashboard": true,
	"dependencyDashboardTitle": "Dependency Dashboard",
	"lockFileMaintenance": {
		"enabled": true,
		"schedule": ["before 7am on monday"]
	},
	"rangeStrategy": "replace",
	"constraints": { "java": "21" },
	"postUpdateOptions": ["pnpmDedupe"],
	"packageRules": [
		{
			"description": "CI tool checksums require independent supply-chain review",
			"matchManagers": ["custom.regex"],
			"matchDatasources": ["github-release-attachments"],
			"prBodyNotes": [
				"Independently verify every changed CI tool asset checksum and Cosign trust material before merge. Renovate obtains digests from the same upstream release; a matching digest proves download integrity, not publisher authenticity. Follow [Release tool downloads](https://docs.hephaestus.build/contributor/ci-cd#release-tool-downloads)."
			]
		},
		{
			"description": "Gradle updates include reviewed dependency locks and verification metadata, not just version pins",
			"matchManagers": ["gradle", "gradle-wrapper"],
			"prBodyNotes": [
				"Follow [Updating Java dependencies](https://docs.hephaestus.build/contributor/local-development#updating-java-dependencies): review lockfile changes and independently verify new checksums. Exercise changed generators and build tools, then verify with a fresh Gradle user home and no metadata-writing flags. Missing or failed Renovate artifact updates must be repaired before merging. If Quality → App Server reports unused verification entries, remove them as that page describes."
			]
		},
		{
			"description": "Workflows, their actions and the CI tools they pin move in one pull request",
			"matchFileNames": [".github/**"],
			"matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
			"groupName": "CI and build tooling"
		},
		{
			"description": "What the chart and the release image set ship moves in one pull request, after the images it replaces are stable",
			"matchDatasources": ["docker"],
			"matchFileNames": [
				"**/Dockerfile",
				"**/*compose*.yaml",
				"deploy/**",
				"security/release-images.json",
				"server/application/project.toml"
			],
			"matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
			"groupName": "runtime images"
		},
		{
			"matchDepNames": ["paketobuildpacks/**"],
			"matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
			"groupName": "runtime images",
			"prBodyNotes": [
				"A buildpack update can change the files that the buildpacks download. The App Server image build then fails and names each URI. Pin each file in .github/ci-tools/buildpack-*.json with the SHA-256 from the buildpack's buildpack.toml."
			]
		},
		{
			"matchManagers": ["npm"],
			"matchFileNames": ["package.json"],
			"matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
			"groupName": "repository tooling dependencies"
		},
		{
			"matchManagers": ["npm"],
			"matchFileNames": ["webapp/package.json", "extension/package.json"],
			"matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
			"groupName": "webapp and extension dependencies"
		},
		{
			"description": "A Gradle wrapper update moves the build-script locks and verification metadata, as a server dependency does",
			"matchManagers": ["gradle", "gradle-wrapper"],
			"matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
			"groupName": "server dependencies"
		},
		{
			"description": "The practice runtime's model SDK moves on its own, because each update needs the practice evaluation set run before and after",
			"matchManagers": ["npm"],
			"matchFileNames": ["docker/agents/practice-scripts/package.json"],
			"matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
			"groupName": "Practice runtime"
		},
		{
			"description": "Each practice-runtime update needs its code ported and the practice evaluation set run before and after, so a maintainer starts it from the dashboard",
			"matchFileNames": ["docker/agents/practice-scripts/package.json"],
			"dependencyDashboardApproval": true
		},
		{
			"description": "zizmor 1.31 adds the self-repository audit, which the Zizmor job fails on until the workflows adopt its syntax or turn it off. Its own group keeps the approval from holding the other CI updates",
			"matchDepNames": [
				"zizmorcore/zizmor",
				"zizmorcore/zizmor-action",
				"ghcr.io/zizmorcore/zizmor"
			],
			"groupName": "zizmor",
			"dependencyDashboardApproval": true
		},
		{
			"matchUpdateTypes": ["major"],
			"minimumReleaseAge": "7 days",
			"addLabels": ["breaking"],
			"groupName": null,
			"dependencyDashboardApproval": true
		},
		{
			"matchCurrentVersion": "/^v?0\\./",
			"matchUpdateTypes": ["minor"],
			"minimumReleaseAge": "7 days",
			"addLabels": ["breaking"],
			"groupName": null,
			"dependencyDashboardApproval": true
		},
		{
			"description": "Compatibility override for older transitive consumers: retain patched releases within the supported major, rather than forcing a breaking API",
			"matchManagers": ["npm"],
			"matchDepTypes": ["pnpm-workspace.overrides"],
			"matchDepNames": ["js-yaml@>=4.0.0"],
			"allowedVersions": "4.x"
		},
		{
			"description": "Compatibility override for older transitive consumers: retain patched releases within the supported major, rather than forcing a breaking API",
			"matchManagers": ["npm"],
			"matchDepTypes": ["pnpm-workspace.overrides"],
			"matchDepNames": ["uuid@<11.1.1"],
			"allowedVersions": "11.x"
		},
		{
			"description": "The stable API generator consumes the TypeScript 6 compiler API",
			"matchManagers": ["npm"],
			"matchFileNames": ["scripts/api-generator/package.json"],
			"matchPackageNames": ["typescript"],
			"allowedVersions": "6.x",
			"groupName": "Hey API"
		},
		{
			"description": "Both API clients use one stable generator; prerelease snapshots do not match npm advisory ranges",
			"matchManagers": ["npm"],
			"matchPackageNames": ["@hey-api/*"],
			"allowedVersions": "/^[0-9]+\\.[0-9]+\\.[0-9]+$/",
			"groupName": "Hey API",
			"prBodyNotes": [
				"Run `vp run generate:api:client` and commit both generated clients. Verify webapp and extension tests and builds.",
				"`@hey-api/openapi-ts` carries an owned patch. Make it again for the new version as `patches/NOTICE.md` describes."
			]
		},
		{
			"matchDepNames": ["node"],
			"groupName": "Node.js toolchain"
		},
		{
			"matchDepNames": ["pnpm", "ghcr.io/pnpm/pnpm"],
			"groupName": "pnpm toolchain"
		},
		{
			"description": "The SDK and the overrides that hold its own packages at its version move together",
			"matchPackageNames": ["@earendil-works/**"],
			"groupName": "Pi SDK"
		},
		{
			"matchDepNames": ["vite-plus"],
			"prBodyNotes": [
				"Run `vp run sync:toolchain-pins && vp install` and commit the result: the catalog must restate the versions this vite-plus bundles, and `gate:toolchain` fails until it does."
			]
		},
		{
			"description": "Bundled by vite-plus at exact versions: the catalog restates them and moves only with the vite-plus pin, which gate:toolchain enforces",
			"matchDepNames": [
				"vite",
				"oxfmt",
				"oxlint",
				"oxlint-tsgolint",
				"@oxlint/plugins",
				"vitest",
				"@vitest/browser",
				"@vitest/browser-playwright",
				"@vitest/coverage-v8"
			],
			"enabled": false
		},
		{
			"description": "Offer a cluster leg's node image the patches of its own minor, which a newer minor would otherwise hide",
			"matchDepNames": ["docker.io/rancher/k3s", "docker.io/kindest/node"],
			"separateMinorPatch": true
		},
		{
			"description": "A cluster leg's name states its Kubernetes minor, so moving a leg to another minor is a change to the workflow, not an image update",
			"matchDepNames": ["docker.io/rancher/k3s", "docker.io/kindest/node"],
			"matchUpdateTypes": ["major", "minor"],
			"enabled": false
		},
		{
			"description": "Platform updates keep chart, image, and installer pins consistent under human review",
			"matchFileNames": [
				"deploy/platform/k3s-platform.yaml",
				"deploy/platform/k3s-agent-sandbox.yaml",
				"deploy/platform/k3s-containerd.toml.tmpl"
			],
			"dependencyDashboardApproval": true,
			"groupName": "one-host platform",
			"prBodyNotes": [
				"Review chart and image versions together. For a k3s update, independently verify and update the installer SHA-256 on the pin line. Run the Platform pins check and the platform tests on the update branch. Review the rescan before merge. For an agent-sandbox or gVisor update, follow docs/contributor/release-management.mdx § Platform pins."
			]
		},
		{
			"description": "The Playwright image version must match the installed package",
			"matchDepNames": ["mcr.microsoft.com/playwright"],
			"matchUpdateTypes": ["major", "minor", "patch"],
			"enabled": false
		},
		{
			"description": "Lock file maintenance spans every package file, so the practice-runtime approval would hold it. It refreshes only transitive versions, so it runs on the weekly schedule. Last, so no earlier approval rule overrides it",
			"matchUpdateTypes": ["lockFileMaintenance"],
			"dependencyDashboardApproval": false
		}
	],
	"customManagers": [
		{
			"description": "Track Dockerfile ARG version pins",
			"customType": "regex",
			"managerFilePatterns": ["/(^|/)Dockerfile$/"],
			"matchStrings": [
				"# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?(?: extractVersion=(?<extractVersion>\\S+))?\\s*\\nARG [A-Z_]+_VERSION=(?<currentValue>\\S+)"
			],
			"versioningTemplate": "{{#if versioning}}{{versioning}}{{else}}semver{{/if}}"
		},
		{
			"description": "Track CI tool release tags and asset checksums together",
			"customType": "regex",
			"managerFilePatterns": ["/^\\.github/ci-tools/(cosign|pack|syft|trivy)\\.json$/"],
			"matchStrings": [
				"\"githubRelease\":\\s*\"(?<depName>[\\w.-]+/[\\w.-]+)\"[\\s\\S]*",
				"\"(?<depType>[\\w-]+)\":\\s*\\{\\s*\"version\":\\s*\"(?<currentValue>v[^\"]+)\",\\s*\"sha256\":\\s*\"(?<currentDigest>[a-f0-9]{64})\""
			],
			"versioningTemplate": "semver",
			"datasourceTemplate": "github-release-attachments",
			"matchStringsStrategy": "recursive"
		},
		{
			"description": "Track the Zizmor CLI version",
			"customType": "regex",
			"managerFilePatterns": ["/^\\.github/workflows/cicd\\.yml$/"],
			"matchStrings": [
				"# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+version: (?<currentValue>\\S+)"
			],
			"extractVersionTemplate": "^v(?<version>.*)$",
			"versioningTemplate": "semver"
		},
		{
			"description": "Track the buildpacks run image",
			"customType": "regex",
			"managerFilePatterns": ["/^\\.github/workflows/cicd\\.yml$/"],
			"matchStrings": [
				"# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+run-image: \"[^@\"]+@(?<currentDigest>sha256:[a-f0-9]{64})\""
			],
			"currentValueTemplate": "latest"
		},
		{
			"description": "Track the builder and buildpack images in the project descriptor",
			"customType": "regex",
			"managerFilePatterns": ["/^server/application/project\\.toml$/"],
			"matchStrings": [
				"(?:builder|uri) = \"(?:docker://)?(?<depName>[^@\"]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
			],
			"datasourceTemplate": "docker",
			"currentValueTemplate": "latest"
		},
		{
			"description": "Track the Node.js pin in devEngines",
			"customType": "regex",
			"managerFilePatterns": ["/^package\\.json$/"],
			"matchStrings": [
				"\"runtime\":\\s*\\{\\s*\"name\":\\s*\"node\",\\s*\"version\":\\s*\"(?<currentValue>[^\"]+)\""
			],
			"depNameTemplate": "node",
			"datasourceTemplate": "node-version",
			"versioningTemplate": "node"
		},
		{
			"description": "Track the pnpm pin in devEngines",
			"customType": "regex",
			"managerFilePatterns": ["/^package\\.json$/"],
			"matchStrings": [
				"\"packageManager\":\\s*\\{\\s*\"name\":\\s*\"pnpm\",\\s*\"version\":\\s*\"(?<currentValue>[^\"]+)\""
			],
			"depNameTemplate": "pnpm",
			"datasourceTemplate": "npm",
			"versioningTemplate": "npm"
		},
		{
			"description": "Track release image tags and digests",
			"customType": "regex",
			"managerFilePatterns": ["/^security/release-images\\.json$/"],
			"matchStrings": [
				"\"repository\": \"(?<depName>[^\"]+)\",\\s+\"tag\": \"(?<currentValue>[^\"]+)\",\\s+\"digest\": \"(?<currentDigest>sha256:[a-f0-9]{64})\""
			],
			"datasourceTemplate": "docker"
		},
		{
			"description": "Track the isolated Semgrep scanner image",
			"customType": "regex",
			"managerFilePatterns": ["/^\\.github/workflows/semgrep\\.yml$/"],
			"matchStrings": [
				"SEMGREP_IMAGE: (?<depName>semgrep/semgrep):(?<currentValue>[0-9.]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
			],
			"datasourceTemplate": "docker"
		},
		{
			"description": "Track the TruffleHog scanner image",
			"customType": "regex",
			"managerFilePatterns": ["/^\\.github/workflows/ci-security-scan\\.yml$/"],
			"matchStrings": [
				"image: (?<depName>ghcr.io/trufflesecurity/trufflehog)\\s+version: (?<currentValue>[0-9.]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
			],
			"datasourceTemplate": "docker"
		},
		{
			"description": "Track the Kubernetes node images of the cluster legs",
			"customType": "regex",
			"managerFilePatterns": ["/^\\.github/workflows/ci-kubernetes\\.yml$/"],
			"matchStrings": [
				"(?<depName>docker\\.io/(?:rancher/k3s|kindest/node)):(?<currentValue>v[0-9][^@\\s\"]*)@(?<currentDigest>sha256:[a-f0-9]{64})"
			],
			"datasourceTemplate": "docker",
			"versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:-k3s(?<build>\\d+))?$"
		},
		{
			"description": "Track platform chart versions",
			"customType": "regex",
			"managerFilePatterns": ["/^deploy/platform/k3s-platform\\.yaml$/"],
			"matchStrings": [
				"repo: (?<registryUrl>https://[^\\s]+)\\s+chart: (?<depName>[^\\s]+)\\s+version: (?<currentValue>[^\\s]+)"
			],
			"datasourceTemplate": "helm"
		},
		{
			"description": "Track platform image tags and digests",
			"customType": "regex",
			"managerFilePatterns": ["/^deploy/platform/k3s-platform\\.yaml$/"],
			"matchStrings": [
				"repository: (?<depName>[^\\s]+)\\s+tag: (?<currentValue>[^\\s]+)\\s+digest: (?<currentDigest>sha256:[a-f0-9]{64})"
			],
			"datasourceTemplate": "docker"
		},
		{
			"description": "Track the one-host k3s release",
			"customType": "regex",
			"managerFilePatterns": ["/^deploy/platform/k3s-platform\\.yaml$/"],
			"matchStrings": ["# pin: k3s v(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+\\+k3s[0-9]+) "],
			"depNameTemplate": "k3s-io/k3s",
			"datasourceTemplate": "github-releases",
			"extractVersionTemplate": "^v(?<version>.*)$",
			"versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\+k3s(?<build>\\d+)$"
		},
		{
			"description": "Track the agent-sandbox controller release",
			"customType": "regex",
			"managerFilePatterns": ["/^deploy/platform/k3s-agent-sandbox\\.yaml$/"],
			"matchStrings": ["# pin: agent-sandbox v(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+) "],
			"depNameTemplate": "kubernetes-sigs/agent-sandbox",
			"datasourceTemplate": "github-releases",
			"extractVersionTemplate": "^v(?<version>.*)$"
		},
		{
			"description": "Track the gVisor release of the one-host platform",
			"customType": "regex",
			"managerFilePatterns": ["/^deploy/platform/k3s-containerd\\.toml\\.tmpl$/"],
			"matchStrings": ["# pin: gvisor (?<currentValue>[0-9]{8}\\.[0-9]+) "],
			"depNameTemplate": "google/gvisor",
			"datasourceTemplate": "github-releases",
			"extractVersionTemplate": "^release-(?<version>.*)$",
			"versioningTemplate": "loose"
		},
		{
			"description": "Track the Playwright browser image digest with its package version",
			"customType": "regex",
			"managerFilePatterns": ["/^\\.github/playwright-image\\.json$/"],
			"matchStrings": [
				"\"repository\": \"(?<depName>[^\" ]+)\",\\s+\"tag\": \"(?<currentValue>[^\" ]+)\",\\s+\"digest\": \"(?<currentDigest>sha256:[a-f0-9]{64})\""
			],
			"datasourceTemplate": "docker"
		}
	],
	"vulnerabilityAlerts": {
		"rangeStrategy": "replace",
		"enabled": true,
		"labels": ["security", "dependencies"],
		"minimumReleaseAge": null,
		"dependencyDashboardApproval": false,
		"automerge": false,
		"groupName": null
	},
	"ignorePaths": ["**/node_modules/**", "**/target/**", "**/dist/**", "**/build/**"],
	"prConcurrentLimit": 2,
	"branchConcurrentLimit": 2,
	"prHourlyLimit": 2,
	"osvVulnerabilityAlerts": true,
	"dependencyDashboardOSVVulnerabilitySummary": "unresolved"
}
