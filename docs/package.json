{
	"name": "docs",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node ../scripts/docs-astro.ts dev --port 3000",
		"build": "node ../scripts/docs-astro.ts build && pagefind --site dist && node ../scripts/check-docs-links.ts && node ../scripts/check-docs-addresses.ts && node ../scripts/check-doc-targets.ts",
		"check": "node ../scripts/docs-astro.ts check",
		"serve": "node ../scripts/docs-astro.ts preview"
	},
	"dependencies": {
		"@astrojs/markdown-satteri": "0.4.10",
		"@astrojs/react": "7.1.9",
		"@fumadocs/astro": "0.3.0",
		"@fumadocs/satteri": "0.8.4",
		"astro": "7.4.13",
		"fumadocs-core": "16.18.4",
		"fumadocs-ui": "npm:@fumadocs/base-ui@16.18.4",
		"mermaid": "12.2.0",
		"react": "catalog:",
		"react-dom": "catalog:",
		"satteri": "0.11.7",
		"yaml": "2.9.1"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.12",
		"@tailwindcss/vite": "4.3.3",
		"@types/mdx": "2.0.14",
		"@types/node": "24.19.2",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"markdownlint-cli2": "0.24.0",
		"pagefind": "1.6.0",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3"
	}
}
