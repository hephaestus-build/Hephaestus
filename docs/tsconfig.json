{
	"compilerOptions": {
		"allowJs": true,
		"allowImportingTsExtensions": true,
		"esModuleInterop": true,
		"jsx": "preserve",
		"target": "ES2022",
		"lib": ["ES2022", "DOM"],
		"moduleResolution": "bundler",
		"module": "esnext",
		"noEmit": true,
		"paths": { "@site/*": ["./*"] },
		"skipLibCheck": true,
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true
	},
	"exclude": [".docusaurus", "build"]
}
