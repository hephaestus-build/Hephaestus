{
	"$schema": "../node_modules/oxlint/configuration_schema.json",

	// The Docusaurus site adds to the repository base and the React layer; neither is repeated here.
	"extends": ["../.oxlintrc.json", "../oxlint.react.jsonc"],

	// Only the file-naming rule is enabled from the house plugin. The rest hold the SPA's own
	// conventions — its Storybook stories, its Testing Library queries, its query keys, its clock —
	// and a Docusaurus site is not held to them.
	"jsPlugins": ["../webapp/tools/oxlint/index.ts"],

	// Kept in step with `tsconfig.json`'s `lib`.
	"env": { "browser": true, "node": true, "es2022": true },
	"settings": { "react": { "version": "19.2" } },

	"ignorePatterns": ["build/**", ".docusaurus/**"],

	"rules": {
		// Both want `toSorted`/`toReversed`, which `tsconfig.json`'s `lib` (ES2022) does not declare.
		// Copy before sorting an array a caller can observe.
		"unicorn/no-array-sort": "off",
		"unicorn/no-array-reverse": "off"
	},

	"overrides": [
		{
			// The lint config loader lives with the house plugin under `webapp/tools/oxlint/`, which this
			// tree already names by relative path in `jsPlugins`; there is no alias across the two trees.
			"files": ["vite.config.ts"],
			"rules": { "import/no-relative-parent-imports": "off" }
		}
	]
}
