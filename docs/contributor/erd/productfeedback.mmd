erDiagram
    %% Generated automatically from PostgreSQL database schema
    %% using scripts/generate-mermaid-erd.ts
    %% To regenerate: vp run db:generate-erd-docs

    direction LR

    ProductFeedback {
        UUID id PK
        BIGINT account_id FK,UK "NOT NULL"
        BIGINT workspace_id FK
        VARCHAR(16) kind "NOT NULL"
        VARCHAR(5000) message "NOT NULL"
        VARCHAR(500) page_path
        TIMESTAMPTZ created_at "NOT NULL"
        TIMESTAMPTZ submission_minute UK "NOT NULL"
        VARCHAR(64) app_version
        VARCHAR(500) user_agent
        TIMESTAMPTZ resolved_at
        BIGINT resolved_by_account_id FK
    }

    ProductSurvey {
        UUID id PK
        VARCHAR(160) title "NOT NULL"
        VARCHAR(500) description "NOT NULL"
        JSONB questions_json "NOT NULL"
        BIGINT workspace_id FK
        TIMESTAMPTZ starts_at "NOT NULL"
        TIMESTAMPTZ ends_at
        BOOLEAN active "NOT NULL"
        BIGINT created_by_account_id FK
        TIMESTAMPTZ created_at "NOT NULL"
        VARCHAR(200) research_organization
        TIMESTAMPTZ summary_queued_at
    }

    ProductSurveyEmailInvitation {
        UUID id PK
        TIMESTAMPTZ accepted_at
        BIGINT account_id FK,UK "NOT NULL"
        TIMESTAMPTZ cancelled_at
        TIMESTAMPTZ expires_at "NOT NULL"
        TIMESTAMPTZ reminder_accepted_at
        BOOLEAN reminder_enabled "NOT NULL"
        TIMESTAMPTZ reminder_requested_at
        TIMESTAMPTZ requested_at "NOT NULL"
        BIGINT requested_by_account_id FK
        UUID survey_id FK,UK "NOT NULL"
        BIGINT workspace_id FK
        BIGINT request_generation "NOT NULL"
    }

    ProductSurveyParticipation {
        UUID id PK
        UUID survey_id FK,UK "NOT NULL"
        BIGINT account_id FK,UK "NOT NULL"
        BIGINT workspace_id FK
        VARCHAR(16) status "NOT NULL"
        JSONB answers_json
        TIMESTAMPTZ invited_at "NOT NULL"
        TIMESTAMPTZ decided_at
    }

    Account["Account · Core"]
    Workspace["Workspace · Workspace (Tenancy)"]

    %% Relationships
    %% One-to-Many relationships
    Account ||--o{ ProductFeedback : account_id
    Account ||--o{ ProductFeedback : resolved_by_account_id
    Workspace ||--o{ ProductFeedback : has
    Account ||--o{ ProductSurvey : has
    Workspace ||--o{ ProductSurvey : has
    Account ||--o{ ProductSurveyEmailInvitation : account_id
    Account ||--o{ ProductSurveyEmailInvitation : requested_by_account_id
    ProductSurvey ||--o{ ProductSurveyEmailInvitation : has
    Workspace ||--o{ ProductSurveyEmailInvitation : has
    Account ||--o{ ProductSurveyParticipation : has
    ProductSurvey ||--o{ ProductSurveyParticipation : has
    Workspace ||--o{ ProductSurveyParticipation : has

    %% Styling
    classDef primaryEntity stroke:#0288d1,stroke-width:2px
    classDef associationEntity stroke:#8e24aa,stroke-width:2px
    classDef metadataEntity stroke:#43a047,stroke-width:2px
    classDef referenceEntity stroke-dasharray:5 5

    class Account referenceEntity
    class Workspace referenceEntity
