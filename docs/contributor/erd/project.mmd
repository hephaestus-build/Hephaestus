        TIMESTAMPTZ removed_at
    }

    ProjectTeamMember {
        UUID id PK
        BIGINT workspace_id FK "NOT NULL"
        UUID team_id FK,UK "NOT NULL"
        BIGINT account_id FK,UK "NOT NULL"
        TIMESTAMPTZ joined_at "NOT NULL"
    }

    ProjectTeamRepository {
        UUID id PK
        BIGINT workspace_id FK "NOT NULL"
        UUID team_id FK,UK "NOT NULL"
