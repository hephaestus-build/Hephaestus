        VARCHAR(16) status "NOT NULL"
        BIGINT approved_account_id FK
        TIMESTAMPTZ created_at "NOT NULL"
        TIMESTAMPTZ expires_at "NOT NULL"
    }

    ProjectTeam {
        UUID id PK,UK
        BIGINT workspace_id FK,UK "NOT NULL"
        VARCHAR(100) name "NOT NULL"
