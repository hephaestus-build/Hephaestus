    Account["Account · Core"]
    Organization["Organization · Integration"]

    %% Relationships
    %% One-to-One relationships
    Organization ||--|| Workspace : has
    Workspace ||--|| WorkspaceOnboardingSetting : has

    %% One-to-Many relationships
    Account ||--o{ Membership : belongs_to
    Workspace ||--o{ Membership : belongs_to
    Workspace ||--o{ RepositoryToMonitor : monitors
    Workspace ||--o{ WorkspaceSlugHistory : has

    %% Many-to-Many relationships
    RepositoryToMonitor }o--o{ ReviewScopeRepository : reviewed
    Workspace }o--o{ ReviewScopeRepository : reviewed

    %% Styling
    classDef primaryEntity stroke:#0288d1,stroke-width:2px
    classDef associationEntity stroke:#8e24aa,stroke-width:2px
    classDef metadataEntity stroke:#43a047,stroke-width:2px
    classDef referenceEntity stroke-dasharray:5 5

    class Account referenceEntity
    class Organization referenceEntity
    class RepositoryToMonitor metadataEntity
    class Workspace primaryEntity
