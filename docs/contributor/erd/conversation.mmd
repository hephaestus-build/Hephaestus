    direction LR

    Conversation {
        UUID id PK,UK
        TIMESTAMPTZ created_at "NOT NULL"
        TIMESTAMPTZ last_activity_at "NOT NULL"
        UUID parent_conversation_id FK
        UUID parent_entry_id FK,UK
        VARCHAR(32) slack_channel_id
        VARCHAR(32) slack_team_id
        VARCHAR(32) slack_user_id
        BIGINT account_id FK "NOT NULL"
        BIGINT workspace_id FK,UK "NOT NULL"
        TIMESTAMPTZ last_read_at
    }

    ConversationEntry {
        UUID id PK,UK
        UUID conversation_id FK,UK "NOT NULL"
        TIMESTAMPTZ created_at "NOT NULL"
        TIMESTAMPTZ edited_at
        VARCHAR(16) kind "NOT NULL"
        JSONB payload
        TIMESTAMPTZ redacted_at
        VARCHAR(200) request_id
        TEXT search_text "NOT NULL"
        BIGINT seq UK "NOT NULL"
        VARCHAR(32) slack_ts UK
        VARCHAR(8) surface "NOT NULL"
        TEXT text "NOT NULL"
        UUID turn_id FK
        VARCHAR(16) vote
        BIGINT workspace_id FK,UK "NOT NULL"
    }

    ConversationTurn {
        UUID id PK,UK
        JSONB admission
        INTEGER attempt "NOT NULL"
        UUID conversation_id FK "NOT NULL"
        TIMESTAMPTZ created_at "NOT NULL"
        TEXT error
        TIMESTAMPTZ finished_at
        VARCHAR(200) request_id UK "NOT NULL"
        TIMESTAMPTZ started_at
        VARCHAR(16) status "NOT NULL"
        VARCHAR(8) surface "NOT NULL"
        BIGINT workspace_id FK,UK "NOT NULL"
        VARCHAR(500) page_context
        VARCHAR(64) failed_call
        INTEGER failed_call_status
        VARCHAR(200) failure_cause
        TIMESTAMPTZ queued_at "NOT NULL"
        INTEGER tools_loads "NOT NULL"
        UUID run_id FK,UK "NOT NULL"
    }

    Account["Account · Core"]
    AgentRun["AgentRun · Agent"]
    Workspace["Workspace · Workspace (Tenancy)"]

    %% Relationships
    %% One-to-One relationships
    ConversationEntry ||--|| Conversation : references
    AgentRun ||--|| ConversationTurn : has

    %% One-to-Many relationships
    Account ||--o{ Conversation : has
    Conversation ||--o{ Conversation : has
    Workspace ||--o{ Conversation : has
    Conversation ||--o{ ConversationEntry : has
    ConversationTurn ||--o{ ConversationEntry : has
    Workspace ||--o{ ConversationEntry : has
    Conversation ||--o{ ConversationTurn : has
    Workspace ||--o{ ConversationTurn : has

    %% Styling
    classDef primaryEntity stroke-width:2px
    classDef associationEntity stroke-width:1px
    classDef metadataEntity stroke-width:1px
