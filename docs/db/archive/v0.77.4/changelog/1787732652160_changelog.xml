<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet author="hephaestus" id="1787732652160-1">
        <preConditions onFail="MARK_RAN" onFailMessage="observation.workspace_id already present">
            <not><columnExists tableName="observation" columnName="workspace_id"/></not>
        </preConditions>
        <comment>Give every observation an explicit tenant and enforce that it matches its practice.</comment>
        <addColumn tableName="observation">
            <column name="workspace_id" type="BIGINT"/>
        </addColumn>
        <sql>UPDATE observation o SET workspace_id = p.workspace_id FROM practice p WHERE p.id = o.practice_id</sql>
        <addNotNullConstraint tableName="observation" columnName="workspace_id" columnDataType="BIGINT"/>
        <addUniqueConstraint tableName="practice" columnNames="id,workspace_id"
                             constraintName="uk_practice_workspace_id"/>
        <dropForeignKeyConstraint baseTableName="observation" constraintName="fk_observation_practice"/>
        <addForeignKeyConstraint baseTableName="observation" baseColumnNames="practice_id,workspace_id"
                                 constraintName="fk_observation_practice" referencedTableName="practice"
                                 referencedColumnNames="id,workspace_id"/>
        <addForeignKeyConstraint baseTableName="observation" baseColumnNames="workspace_id"
                                 constraintName="fk_observation_workspace" referencedTableName="workspace"
                                 referencedColumnNames="id"/>
        <createIndex tableName="observation" indexName="idx_observation_workspace">
            <column name="workspace_id"/>
        </createIndex>
        <rollback>
            <dropIndex tableName="observation" indexName="idx_observation_workspace"/>
            <dropForeignKeyConstraint baseTableName="observation" constraintName="fk_observation_workspace"/>
            <dropForeignKeyConstraint baseTableName="observation" constraintName="fk_observation_practice"/>
            <addForeignKeyConstraint baseTableName="observation" baseColumnNames="practice_id"
                                     constraintName="fk_observation_practice" referencedTableName="practice"
                                     referencedColumnNames="id"/>
            <dropUniqueConstraint tableName="practice" constraintName="uk_practice_workspace_id"/>
            <dropColumn tableName="observation" columnName="workspace_id"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
