<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="1788595793303-1" author="hephaestus">
        <preConditions onFail="MARK_RAN"><not><indexExists indexName="idx_survey_submission_account"/></not></preConditions>
        <createIndex indexName="idx_survey_submission_account" tableName="product_survey_submission">
            <column name="account_id"/>
        </createIndex>
        <rollback><dropIndex indexName="idx_survey_submission_account" tableName="product_survey_submission"/></rollback>
    </changeSet>
    <!--
        Account erasure keeps the account row as a tombstone, so the ON DELETE CASCADE on account_id
        never fired and submissions of already-erased accounts stayed behind. The erasure path deletes
        them from now on; this clears what earlier releases left. Deleting personal data is not
        reversible, so the rollback is empty rather than wrong.
    -->
    <changeSet id="1788595793303-2" author="hephaestus">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="product_feedback"/>
            <tableExists tableName="product_survey_submission"/>
        </preConditions>
        <delete tableName="product_feedback">
            <where>account_id IN (SELECT id FROM account WHERE status = 'DELETED')</where>
        </delete>
        <delete tableName="product_survey_submission">
            <where>account_id IN (SELECT id FROM account WHERE status = 'DELETED')</where>
        </delete>
        <rollback/>
    </changeSet>
</databaseChangeLog>
