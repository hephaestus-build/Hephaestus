<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet author="hephaestus" id="1787788661301-1">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="workspace_agent_binding" columnName="timeout_seconds"/>
        </preConditions>
        <comment>Set the default agent run timeout to three hours.</comment>
        <addDefaultValue
            tableName="workspace_agent_binding"
            columnName="timeout_seconds"
            columnDataType="INTEGER"
            defaultValueNumeric="10800"/>
        <rollback>
            <addDefaultValue
                tableName="workspace_agent_binding"
                columnName="timeout_seconds"
                columnDataType="INTEGER"
                defaultValueNumeric="600"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
