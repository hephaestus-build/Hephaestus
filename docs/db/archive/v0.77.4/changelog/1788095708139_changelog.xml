<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="1788095708139-1" author="hephaestus">
        <preConditions onFail="MARK_RAN"><not><tableExists tableName="product_survey"/></not></preConditions>
        <createTable tableName="product_survey">
            <column name="id" type="uuid"><constraints primaryKey="true" nullable="false"/></column>
            <column name="title" type="varchar(160)"><constraints nullable="false"/></column>
            <column name="description" type="varchar(500)"><constraints nullable="false"/></column>
            <column name="questions_json" type="jsonb"><constraints nullable="false"/></column>
            <column name="workspace_id" type="bigint"/>
            <column name="starts_at" type="timestamp with time zone"><constraints nullable="false"/></column>
            <column name="ends_at" type="timestamp with time zone"/>
            <column name="active" type="boolean"><constraints nullable="false"/></column>
            <column name="created_by_account_id" type="bigint"/>
            <column name="created_at" type="timestamp with time zone"><constraints nullable="false"/></column>
        </createTable>
        <addForeignKeyConstraint baseTableName="product_survey" baseColumnNames="workspace_id" referencedTableName="workspace" referencedColumnNames="id" constraintName="fk_product_survey_workspace" onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="product_survey" baseColumnNames="created_by_account_id" referencedTableName="account" referencedColumnNames="id" constraintName="fk_product_survey_creator" onDelete="SET NULL"/>
        <rollback><dropTable tableName="product_survey"/></rollback>
    </changeSet>
    <changeSet id="1788095708139-2" author="hephaestus">
        <preConditions onFail="MARK_RAN"><not><tableExists tableName="product_survey_submission"/></not></preConditions>
        <createTable tableName="product_survey_submission">
            <column name="id" type="uuid"><constraints primaryKey="true" nullable="false"/></column>
            <column name="survey_id" type="uuid"><constraints nullable="false"/></column>
            <column name="account_id" type="bigint"><constraints nullable="false"/></column>
            <column name="workspace_id" type="bigint"/>
            <column name="disposition" type="varchar(16)"><constraints nullable="false"/></column>
            <column name="answers_json" type="jsonb"/>
            <column name="created_at" type="timestamp with time zone"><constraints nullable="false"/></column>
        </createTable>
        <addUniqueConstraint tableName="product_survey_submission" columnNames="survey_id,account_id" constraintName="uk_survey_submission_account"/>
        <addForeignKeyConstraint baseTableName="product_survey_submission" baseColumnNames="survey_id" referencedTableName="product_survey" referencedColumnNames="id" constraintName="fk_survey_submission_survey" onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="product_survey_submission" baseColumnNames="account_id" referencedTableName="account" referencedColumnNames="id" constraintName="fk_survey_submission_account" onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="product_survey_submission" baseColumnNames="workspace_id" referencedTableName="workspace" referencedColumnNames="id" constraintName="fk_survey_submission_workspace" onDelete="CASCADE"/>
        <rollback><dropTable tableName="product_survey_submission"/></rollback>
    </changeSet>
    <changeSet id="1788095708139-3" author="hephaestus">
        <preConditions onFail="MARK_RAN"><not><tableExists tableName="product_feedback"/></not></preConditions>
        <createTable tableName="product_feedback">
            <column name="id" type="uuid"><constraints primaryKey="true" nullable="false"/></column>
            <column name="account_id" type="bigint"><constraints nullable="false"/></column>
            <column name="workspace_id" type="bigint"/>
            <column name="kind" type="varchar(16)"><constraints nullable="false"/></column>
            <column name="message" type="varchar(5000)"><constraints nullable="false"/></column>
            <column name="page_path" type="varchar(500)"/>
            <column name="created_at" type="timestamp with time zone"><constraints nullable="false"/></column>
            <column name="submission_minute" type="timestamp with time zone"><constraints nullable="false"/></column>
        </createTable>
        <addUniqueConstraint tableName="product_feedback" columnNames="account_id,submission_minute" constraintName="uk_product_feedback_rate_limit"/>
        <addForeignKeyConstraint baseTableName="product_feedback" baseColumnNames="account_id" referencedTableName="account" referencedColumnNames="id" constraintName="fk_product_feedback_account" onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="product_feedback" baseColumnNames="workspace_id" referencedTableName="workspace" referencedColumnNames="id" constraintName="fk_product_feedback_workspace" onDelete="CASCADE"/>
        <rollback><dropTable tableName="product_feedback"/></rollback>
    </changeSet>
</databaseChangeLog>
