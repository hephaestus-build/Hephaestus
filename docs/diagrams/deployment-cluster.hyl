// Deployment view: Hephaestus on a managed Kubernetes cluster, as a UML 2.5.1 § 19 allocation view.
// Page: docs/admin/kubernetes.mdx. Nodes: the cluster, its worker nodes and the API server. Each «Pod» is an execution
// environment that holds the image («artifact») it runs; its namespace is a tagged value. A solid line is a communication
// path labelled with its protocol and port; its arrow points from the side that opens the connection.
// Generated by the lane script deployment.py: change the script, not the numbers.
umlDiagram(showComponentKeyword = false) {
    // @shared-style

    node("Managed Kubernetes cluster", keywords = list("cluster admin")) layout {
        pos = apos(15, 190)
        width = 710
        height = 1220
    }
    node("Worker nodes ×N", keywords = list("cluster admin")) layout {
        pos = apos(5, 215)
        width = 630
        height = 830
    }
    gateway = node("Gateway data plane", keywords = list("cluster admin")) styles {
        class += "admin"
    } layout {
        pos = apos(-190, -300)
        width = 200
        height = 80
    }
    apiServer = node("Kubernetes API server", keywords = list("cluster admin")) styles {
        class += "admin"
    } layout {
        pos = apos(230, -300)
        width = 200
        height = 80
    }
    serverPod = node("Server Pods ×N {namespace=release}", keywords = list("Pod", "Hephaestus chart")) layout {
        pos = apos(20, -30)
        width = 420
        height = 200
    }
    artifact("hephaestus server image") layout {
        pos = apos(10, 24)
        width = 290
    }
    pgPod = node("PostgreSQL Pod {namespace=release}", keywords = list("Pod", "Hephaestus chart")) layout {
        pos = apos(-105, 232)
        width = 210
        height = 224
    }
    artifact("PostgreSQL image") layout {
        pos = apos(-117, 290)
        width = 150
    }
    ctlPod = node("agent-sandbox controller Pod {namespace=release}", keywords = list("Pod", "Hephaestus chart")) layout {
        pos = apos(155, 232)
        width = 250
        height = 224
    }
    artifact("controller image") layout {
        pos = apos(145, 290)
        width = 170
    }
    sandboxPod = node("Sandbox Pod per subject {namespace=sandboxes}", keywords = list("Pod", "created at runtime")) layout {
        pos = apos(110, 512)
        width = 310
        height = 180
    }
    artifact("agent image") layout {
        pos = apos(100, 560)
        width = 200
    }
    pv = node("Persistent volume", keywords = list("cluster admin")) styles {
        class += "admin"
    } layout {
        pos = apos(-210, 720)
        width = 150
        height = 110
    }
    browser = component("Browser", keywords = list("external")) styles {
        class += "ext"
    } layout {
        pos = apos(-190, -480)
        width = 170
    }
    providers = component("GitHub, GitLab, Slack, Outline", keywords = list("external")) styles {
        class += "ext"
    } layout {
        pos = apos(-495, -178)
        width = 150
        height = 324
    }
    services = component("Model provider, email server", keywords = list("external")) styles {
        class += "ext"
    } layout {
        pos = apos(-495, 62)
        width = 150
        height = 110
    }
    browser --> gateway with {
        over = start(0.25).line(end(0.75))
        label("HTTPS", 0.5, -34)
    }
    providers --> gateway with {
        over = start(0.9213).line(end(0.4375))
        label("HTTPS", 0.3, 20)
    }
    serverPod --> providers with {
        over = start(0.49).line(end(0.1204))
        label("HTTPS", 0.2, -22)
    }
    serverPod --> services with {
        over = start(0.4).line(end(0.9727))
        label("HTTPS, SMTP", 0.286, -22)
    }
    gateway --> serverPod with {
        over = start(0.2028).line(end(0.6312))
        label("HTTP 8080", 0.75, -58)
    }
    serverPod --> apiServer with {
        over = start(0.8333).line(end(0.3375))
        label("HTTPS, API port", 0.88, 82)
    }
    ctlPod --> apiServer with {
        over = start(0.845).line(end(0.2185))
        label("HTTPS, API port", 0.12, 80)
    }
    serverPod --> pgPod with {
        over = start(0.3333).line(end(0.7278))
        label("TCP 5432", 0.35, -46)
    }
    sandboxPod --> serverPod with {
        over = start(0.657).line(end(0.256))
        label("HTTP 8081", 0.2, 46)
    }
    pgPod -- pv with {
        over = start(0.3274).line(end(0.8167))
        label("volume mount", 0.5, -56)
    }
    legendDeployment(-460, 910)
}
