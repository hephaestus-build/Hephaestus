---
/*
 * A Mermaid diagram, drawn in the browser like the old site. `gate:diagrams` checks its source. The script loads only
 * on a page with a diagram, and draws again when the theme changes or the client router opens another page.
 */
interface Props {
	chart: string;
}
const { chart } = Astro.props;
---

<pre class="mermaid not-prose my-6 flex justify-center bg-transparent [&_svg]:h-auto [&_svg]:max-w-full" data-pagefind-ignore data-chart={chart}>{chart}</pre>

<script>
	// Astro bundles this script as a module, so its names stay local to it.
	const draw = async (): Promise<void> => {
		const nodes = [...document.querySelectorAll<HTMLElement>("pre.mermaid[data-chart]")];
		if (nodes.length === 0) {
			return;
		}
		const { default: mermaid } = await import("mermaid");
		// The neutral and dark themes are monochrome, and Roboto is the font of the HyLiMo views, so all diagrams read as one set.
		// A diagram asks for ELK in its own front matter.
		mermaid.initialize({
			startOnLoad: false,
			theme: document.documentElement.classList.contains("dark") ? "dark" : "neutral",
			layout: "dagre",
			look: "classic",
			fontFamily: "Roboto, ui-sans-serif, system-ui, sans-serif",
		});
		for (const node of nodes) {
			delete node.dataset.processed;
			node.textContent = node.dataset.chart ?? "";
		}
		await mermaid.run({ nodes });
	};
	// One draw at a time: a theme change during a page load must not run two renders on the same diagrams.
	let drawing = Promise.resolve();
	const drawAfter = async (previous: Promise<void>): Promise<void> => {
		await previous.catch(() => undefined);
		await draw();
	};
	const queue = (): void => {
		drawing = drawAfter(drawing);
	};
	document.addEventListener("astro:page-load", queue);
	new MutationObserver(queue).observe(document.documentElement, { attributeFilter: ["class"] });
</script>
