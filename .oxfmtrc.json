{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"tabWidth": 2,
	"printWidth": 100,
	"singleQuote": false,
	"jsxSingleQuote": false,
	"quoteProps": "as-needed",
	"trailingComma": "all",
	"semi": true,
	"arrowParens": "always",
	"bracketSameLine": false,
	"bracketSpacing": true,
	"sortImports": {
		"newlinesBetween": false,
		"partitionByNewline": true
	},
	"sortPackageJson": true,
	"sortTailwindcss": {
		"stylesheet": "./webapp/src/styles.css",
		"functions": ["cn", "cva"]
	},
	"ignorePatterns": [
		"webapp/src/api/**",
		"webapp/src/routeTree.gen.ts",
		"webapp/public/mockServiceWorker.js"
	]
}
