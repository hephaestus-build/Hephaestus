{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"tabWidth": 2,
	"printWidth": 100,
	"singleQuote": false,
	"jsxSingleQuote": false,
	"quoteProps": "as-needed",
	"trailingComma": "all",
	"semi": true,
	"arrowParens": "always",
	"bracketSameLine": false,
	"bracketSpacing": true,
	"sortImports": {
		"newlinesBetween": false,
		"partitionByNewline": true
	},
	"sortPackageJson": true,
	"sortTailwindcss": {
		"stylesheet": "./webapp/src/styles.css",
		"functions": ["cn", "cva"]
	},
	"ignorePatterns": [
		"webapp/src/api/**",
		"webapp/src/routeTree.gen.ts",
		"webapp/.storybook/public/mockServiceWorker.js",
		"extension/src/api/**",
		"extension/.output/**",
		"extension/.wxt/**",
		"server/**/*.{json,yml,yaml,graphql}",
		"**/*.mdx",
		".vale/styles/**",
		".vale/fixtures/**",
		".claude/skills/**",
		".agents/skills/**",
		"scripts/feedback-eval/**/*.json",
		"docker/agents/pi/package.json",
		"deploy/chart/**/templates/**",
		"deploy/platform/k3s-agent-sandbox.yaml"
	]
}
