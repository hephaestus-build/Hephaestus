<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>
    <groupId>de.tum.cit.aet</groupId>
    <artifactId>hephaestus-server-parent</artifactId>
    <version>0.0.0-development</version>
    <packaging>pom</packaging>
    <name>Hephaestus server reactor</name>
    <modules>
        <module>generated-clients</module>
        <module>application</module>
    </modules>
    <properties>
        <java.version>21</java.version>
        <spring-boot.version>4.1.1</spring-boot.version>
        <netty.version>4.2.17.Final</netty.version>
        <!--
          Ahead of the Spring Boot BOM, which manages Tomcat 11.0.24: the release vulnerability
          gate rejects it over CVE-2026-65182, CVE-2026-65905 and CVE-2026-68525, all fixed in
          11.0.25. The BOM derives every org.apache.tomcat and org.apache.tomcat.embed artifact
          from this one property, so the servlet container moves as a set. Drop this line once
          the managed version reaches 11.0.25, rather than carrying a version we own forever.
        -->
        <tomcat.version>11.0.25</tomcat.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp>
        <graphql-codegen.version>5.10.0</graphql-codegen.version>
        <openapi-generator.version>7.25.0</openapi-generator.version>
        <spotless-maven-plugin.version>3.10.2</spotless-maven-plugin.version>
        <palantir-java-format.version>2.97.0</palantir-java-format.version>
    </properties>
</project>
