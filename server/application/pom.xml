    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit</artifactId>
                <version>${archunit.version}</version>
            </dependency>
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>okhttp-bom</artifactId>
                <version>${okhttp.version}</version>
                <scope>import</scope>
                <type>pom</type>
            </dependency>
            <!-- All three move together: Bouncy Castle only supports a matched provider, util and
                 PKIX set. docker-java's TLS path (CertificateUtils, LocalDirectorySSLConfig) is the
                 only consumer, and it links against PEMParser, JcaPEMKeyConverter,
                 JcaX509CertificateConverter and BouncyCastleProvider, all unchanged in 1.84. -->
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcutil-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcpkix-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <build>
        <plugins>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless-maven-plugin.version}</version>
                <configuration>
                    <upToDateChecking>
                        <enabled>true</enabled>
                        <indexFile>${project.build.directory}/spotless-index</indexFile>
                    </upToDateChecking>
                    <java>
                        <palantirJavaFormat>
                            <version>${palantir-java-format.version}</version>
                        </palantirJavaFormat>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <id>check-java-formatting</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>${java.version}</release>
                    <compilerArgs>
                        <arg>-Xlint:all,-deprecation</arg>
                        <arg>-XDcompilePolicy=simple</arg>
                        <arg>--should-stop=ifError=FLOW</arg>
                        <arg>-XDaddTypeAnnotationsToSymbol=true</arg>
                        <!-- javac requires the Error Prone plugin and its options in one compiler argument. -->
                        <arg>-Xplugin:ErrorProne -XepDisableAllChecks -Xep:NullAway:ERROR -Xep:RequireExplicitNullMarking:ERROR -XepExcludedPaths:.*[\\/]target[\\/]generated-sources[\\/].* -XepOpt:NullAway:AnnotatedPackages=de.tum.cit.aet.hephaestus -XepOpt:NullAway:JSpecifyMode=true -XepOpt:NullAway:TreatGeneratedAsUnannotated=true -XepOpt:NullAway:HandleTestAssertionLibraries=true</arg>
                    </compilerArgs>
                    <showWarnings>false</showWarnings>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                        <path>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-configuration-processor</artifactId>
                        </path>
                        <path>
                            <groupId>com.github.therapi</groupId>
                            <artifactId>therapi-runtime-javadoc-scribe</artifactId>
                            <version>${therapi.version}</version>
                        </path>
                        <path>
                            <groupId>com.google.errorprone</groupId>
                            <artifactId>error_prone_core</artifactId>
                            <version>${error-prone.version}</version>
                        </path>
                        <path>
                            <groupId>com.uber.nullaway</groupId>
                            <artifactId>nullaway</artifactId>
                            <version>${nullaway.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <executions>
                    <execution>
                        <id>default-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <skip>${skipCoverage}</skip>
                        </configuration>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <skip>${skipCoverage}</skip>
                        </configuration>
                    </execution>
                    <execution>
                        <id>check-coverage</id>
                        <phase>test</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <skip>${skipCoverage}</skip>
                            <rules>
                                <!-- Per-package BRANCH floors. There is deliberately no whole-bundle rule: a minimum any
                                     code can clear reads as a guarantee while providing none.

                                     Whole-package figures, including the Spring-wired credential adapters: a rule's
                                     includes/excludes match the element name, so a class glob cannot narrow a
                                     PACKAGE rule. Floors sit below the measured ratios because surefire runs tests
                                     in parallel and the numbers move several points between runs. They are a
                                     ratchet against regression — raise one whenever its package clears the next
                                     step with room to spare. -->
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>de.tum.cit.aet.hephaestus.integration.core.webhook</include>
                                        <include>de.tum.cit.aet.hephaestus.integration.scm.github.webhook</include>
                                        <include>de.tum.cit.aet.hephaestus.integration.scm.gitlab.webhook</include>
                                        <include>de.tum.cit.aet.hephaestus.integration.outline.webhook</include>
                                        <include>de.tum.cit.aet.hephaestus.agent.context</include>
                                        <include>de.tum.cit.aet.hephaestus.agent.context.providers</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.70</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>de.tum.cit.aet.hephaestus.integration.slack.webhook</include>
                                        <include>de.tum.cit.aet.hephaestus.evidence</include>
                                        <include>de.tum.cit.aet.hephaestus.evidence.internal</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.60</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Memory and JVM settings - @{argLine} is replaced by JaCoCo.
                         4GB heap: the unit+architecture surefire run loads ArchUnit + Spring
                         Modulith's full class graph (1000+ classes) in the same fork as the
                         regular unit tests. 2GB OOMs on CI under that load. The dedicated
                         `architecture-tests` profile uses the same 4GB ceiling. -->
                    <argLine>@{argLine} ${hephaestus.test.jvmArgs} -Xmx${hephaestus.surefire.maxHeap} -Dspring.profiles.active=test -Dfile.encoding=UTF-8
                        -XX:+EnableDynamicAgentLoading -XX:+ExitOnOutOfMemoryError
                    </argLine>
                    <printSummary>true</printSummary>
                    <redirectTestOutputToFile>false</redirectTestOutputToFile>
                    <forkCount>${hephaestus.surefire.forkCount}</forkCount>
                    <reuseForks>true</reuseForks>
                    <!-- Integration tests override method parallelism because they share database state. -->
                    <parallel>methods</parallel>
                    <threadCount>4</threadCount>
                    <perCoreThreadCount>true</perCoreThreadCount>
                    <forkedProcessTimeoutInSeconds>${hephaestus.surefire.timeout}</forkedProcessTimeoutInSeconds>
                    <forkedProcessExitTimeoutInSeconds>180</forkedProcessExitTimeoutInSeconds>
                    <!-- Enable process checker so forkedProcessTimeoutInSeconds actually works.
                         Without this, Surefire 3.x ignores the timeout and hung forks run forever. -->
                    <enableProcessChecker>ping</enableProcessChecker>
                    <groups>${surefire.includedGroups}</groups>
                    <excludedGroups>${surefire.excludedGroups}</excludedGroups>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
<!-- EnableDynamicAgentLoading mirrors surefire: without it Byte Buddy cannot
                         self-attach on JDK 21+ and every Mockito-using integration test fails to
                         initialize. -->
                    <argLine>@{argLine} ${hephaestus.test.jvmArgs} -Xmx4096m -Dspring.profiles.active=test -Dfile.encoding=UTF-8
                        -XX:+EnableDynamicAgentLoading
                    </argLine>
                    <groups>${failsafe.includedGroups}</groups>
                    <excludedGroups>${failsafe.excludedGroups}</excludedGroups>
                    <includes>
                        <include>**/*IntegrationTest.java</include>
                        <include>**/*LiquibaseTest.java</include>
                    </includes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals><goal>build-info</goal></goals>
                        <configuration>
                            <additionalProperties>
                                <commit>${build.commit}</commit>
                            </additionalProperties>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <profiles>${app.profiles}</profiles>
                    <jvmArguments>-XX:+EnableDynamicAgentLoading --enable-native-access=ALL-UNNAMED</jvmArguments>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>3.28.0</version>
                <configuration>
                    <rulesets>
                        <ruleset>${maven.multiModuleProjectDirectory}/pmd-ruleset.xml</ruleset>
                    </rulesets>
                    <targetJdk>${java.version}</targetJdk>
                    <includeTests>false</includeTests>
                    <linkXRef>false</linkXRef>
                    <printFailingErrors>true</printFailingErrors>
                    <failOnViolation>true</failOnViolation>
                    <excludeRoots>
                        <excludeRoot>${project.build.directory}/generated-sources</excludeRoot>
                        <excludeRoot>${project.build.directory}/generated-test-sources</excludeRoot>
                    </excludeRoots>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.liquibase</groupId>
                <artifactId>liquibase-maven-plugin</artifactId>
                <version>${liquibase.version}</version>
                <configuration>
                    <changeLogFile>db/master.xml</changeLogFile>
                    <diffChangeLogFile>${project.build.directory}/changelog_new.xml</diffChangeLogFile>
                    <searchPath>${project.basedir}/src/main/resources</searchPath>
                    <driver>org.postgresql.Driver</driver>
                    <url>jdbc:postgresql://localhost:${postgres.port}/hephaestus</url>
                    <username>root</username>
                    <password>root</password>
                    <referenceUrl>
                        hibernate:spring:de.tum.cit.aet.hephaestus?dialect=org.hibernate.dialect.PostgreSQLDialect&amp;hibernate.physical_naming_strategy=org.hibernate.boot.model.naming.CamelCaseToUnderscoresNamingStrategy&amp;hibernate.implicit_naming_strategy=org.springframework.boot.hibernate.SpringImplicitNamingStrategy
                    </referenceUrl>
                    <!--
                        Schema objects Hibernate cannot emit, excluded by type and naming convention so
                        the JPA-vs-DB diff stays empty without a hand-maintained name list:
                        - shedlock and auth_rate_limit_bucket have no JPA entity;
                        - auth_event_default and auth_event_p<n> are PostgreSQL partitions of auth_event,
                          which Liquibase reads as extra tables (liquibase/liquibase#1874);
                        - sfk_* is a foreign key backing a scalar id column with no JPA association
                          (ADR 0017). An association's foreign key keeps the fk_* name and is
                          drift-checked; a misnamed constraint fails the gate in either direction.
                    -->
                    <diffExcludeObjects>table:shedlock,table:auth_rate_limit_bucket,table:auth_event_default,table:auth_event_p\d+,foreignkey:sfk_.*</diffExcludeObjects>
                    <verbose>true</verbose>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.liquibase.ext</groupId>
                        <artifactId>liquibase-hibernate7</artifactId>
                        <version>${liquibase-hibernate7.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-starter-data-jpa</artifactId>
                        <version>${spring-boot.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>jakarta.validation</groupId>
                        <artifactId>jakarta.validation-api</artifactId>
                        <version>${jakarta-validation.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.postgresql</groupId>
                        <artifactId>postgresql</artifactId>
                        <version>${postgresql.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>ci-build-identity</id>
            <activation><property><name>env.GITHUB_SHA</name></property></activation>
            <properties><build.commit>${env.GITHUB_SHA}</build.commit></properties>
        </profile>
        <profile>
            <id>live-tests</id>
            <properties>
                <surefire.excludedGroups />
                <surefire.includedGroups>live</surefire.includedGroups>
                <failsafe.excludedGroups />
                <failsafe.includedGroups />
                <!--
                  A single-test invocation (`-Dtest=…LiveLlmTest`) can match zero classes when
                  the gating env var is unset. Without these flags Maven fails the build on
                  "no tests matched", which masks the real "gate skipped" outcome.
                -->
                <surefire.failIfNoSpecifiedTests>false</surefire.failIfNoSpecifiedTests>
                <failsafe.failIfNoSpecifiedTests>false</failsafe.failIfNoSpecifiedTests>
            </properties>
        </profile>
        <profile>
            <id>architecture-tests</id>
            <properties>
                <surefire.excludedGroups />
                <surefire.includedGroups>architecture</surefire.includedGroups>
                <failsafe.excludedGroups />
                <failsafe.includedGroups />
            </properties>
        </profile>
        <profile>
            <id>pitest</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>1.30.0</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>1.2.3</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <!-- Surefire's JaCoCo argLine is invalid in PIT minion JVMs. -->
                            <parseSurefireConfig>false</parseSurefireConfig>
                            <!-- Keep peak PIT resource use within the advisory runner budget. -->
                            <threads>1</threads>
                            <failWhenNoMutations>true</failWhenNoMutations>
                            <!-- Account for cold minion startup on the application classpath. -->
                            <timeoutConstant>30000</timeoutConstant>
                            <jvmArgs>
                                <value>-Xmx1g</value>
                                <value>-XX:+EnableDynamicAgentLoading</value>
                            </jvmArgs>
                            <targetClasses>
                                <param>de.tum.cit.aet.hephaestus.core.security.ServerUrlValidator</param>
                                <param>de.tum.cit.aet.hephaestus.core.security.PrivateAddressGuard</param>
                                <param>de.tum.cit.aet.hephaestus.core.security.OutlineOriginPolicy</param>
                                <param>de.tum.cit.aet.hephaestus.core.security.ImpersonationGuard</param>
                                <param>de.tum.cit.aet.hephaestus.integration.core.oauth.state.HmacOAuthStateService</param>
                                <param>de.tum.cit.aet.hephaestus.core.auth.oauth.AdminBootstrapPolicy</param>
                                <param>de.tum.cit.aet.hephaestus.core.auth.oauth.ReturnToValidator</param>
                                <param>de.tum.cit.aet.hephaestus.core.auth.oauth.AuthIntentCookie</param>
                                <param>de.tum.cit.aet.hephaestus.core.auth.oauth.CookieOAuth2AuthorizationRequestRepository</param>
                                <param>de.tum.cit.aet.hephaestus.integration.core.connection.EncryptionContext</param>
                                <param>de.tum.cit.aet.hephaestus.integration.scm.gitlab.webhook.GitlabWebhookSignatureVerifier</param>
                            </targetClasses>
                            <targetTests>
                                <param>de.tum.cit.aet.hephaestus.core.security.ServerUrlValidatorTest</param>
                                <param>de.tum.cit.aet.hephaestus.core.security.PrivateAddressGuardTest</param>
                                <param>de.tum.cit.aet.hephaestus.core.security.OutlineOriginPolicyTest</param>
                                <param>de.tum.cit.aet.hephaestus.core.security.ImpersonationGuardTest</param>
                                <param>de.tum.cit.aet.hephaestus.integration.core.oauth.state.HmacOAuthStateServiceTest</param>
                                <param>de.tum.cit.aet.hephaestus.core.auth.oauth.AdminBootstrapPolicyTest</param>
                                <param>de.tum.cit.aet.hephaestus.core.auth.oauth.ReturnToValidatorTest</param>
                                <param>de.tum.cit.aet.hephaestus.core.auth.oauth.AuthIntentCookieTest</param>
                                <param>de.tum.cit.aet.hephaestus.core.auth.oauth.CookieOAuth2AuthorizationRequestRepositoryTest</param>
                                <param>de.tum.cit.aet.hephaestus.integration.core.connection.EncryptionContextTest</param>
                                <param>de.tum.cit.aet.hephaestus.integration.scm.gitlab.webhook.GitlabWebhookSignatureVerifierTest</param>
                            </targetTests>
                            <outputFormats>
                                <param>HTML</param>
                                <param>XML</param>
                            </outputFormats>
                            <timestampedReports>false</timestampedReports>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- AOT output is used only when the runtime enables spring.aot.enabled. -->
        <profile>
            <id>aot</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>process-aot</id>
                                <goals>
                                    <goal>process-aot</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
