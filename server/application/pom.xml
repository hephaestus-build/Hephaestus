        <!--
            Bucket4j token-bucket rate limiting for the hot auth endpoints (core.auth.ratelimit).
            Library-only (no Spring Boot starter): the community starter
            `com.giffing.bucket4j.spring.boot.starter` does not yet declare Boot 4.0 compatibility,
            and Bucket4j itself is framework-agnostic, so we wire a small OncePerRequestFilter by
            hand. JDK17 classifier artifacts (8.16.0+ split by JDK). The postgresql module backs a
            SELECT … FOR UPDATE ProxyManager so limits are SHARED across replicas (no Redis).
        -->
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j_jdk17-core</artifactId>
            <version>${bucket4j.version}</version>
        </dependency>
