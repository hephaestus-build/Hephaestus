<?xml version="1.0" encoding="UTF-8"?>
<!-- The integration tier fails on any park of 20 ms or more that pinned a virtual thread (application/build.gradle.kts). -->
<configuration version="2.0" label="Pinned virtual threads">
  <event name="jdk.VirtualThreadPinned">
    <setting name="enabled">true</setting>
    <setting name="stackTrace">true</setting>
    <setting name="threshold">20 ms</setting>
  </event>
</configuration>
