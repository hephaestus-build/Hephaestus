{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://hephaestus.aet.cit.tum.de/contracts/artifact-source/1.0.0/artifact-source-manifest.schema.json",
	"title": "Artifact source manifest",
	"description": "Immutable record of the evidence captured, omitted, or withheld for one automated-review invocation.",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"contractVersion",
		"catalogDigest",
		"artifactKind",
		"capturedAt",
		"sources"
	],
	"properties": {
		"contractVersion": {
			"const": "1.0.0",
			"description": "Source contract used to interpret every source state in this manifest."
		},
		"catalogDigest": {
			"const": "df44eb8884ed8bd60f60984d0d9c9c76c76543a096449530514a85d6a66e12b6",
			"description": "SHA-256 digest of the exact source catalog used by the runtime."
		},
		"artifactKind": {
			"enum": [
				"scm.pull_request",
				"scm.issue",
				"chat.conversation_thread",
				"docs.document"
			],
			"description": "Kind of work this invocation reviewed, which fixes the evidence sources that apply."
		},
		"capturedAt": {
			"type": "string",
			"format": "date-time",
			"description": "Time at which this invocation finished recording its source captures."
		},
		"sources": {
			"type": "array",
			"minItems": 1,
			"items": {
				"$ref": "#/$defs/capture"
			},
			"allOf": [
				{
					"contains": {
						"type": "object",
						"properties": {
							"kind": {
								"const": "scm.pull-request.core",
								"type": "string"
							}
						},
						"required": [
							"kind"
						]
					},
					"minContains": 0,
					"maxContains": 1
				},
				{
					"contains": {
						"type": "object",
						"properties": {
							"kind": {
								"const": "scm.pull-request.diff",
								"type": "string"
							}
						},
						"required": [
							"kind"
						]
					},
					"minContains": 0,
					"maxContains": 1
				},
				{
					"contains": {
						"type": "object",
						"properties": {
							"kind": {
								"const": "scm.pull-request.comments",
								"type": "string"
							}
						},
						"required": [
							"kind"
						]
					},
					"minContains": 0,
					"maxContains": 1
				},
				{
					"contains": {
						"type": "object",
						"properties": {
							"kind": {
								"const": "scm.repository.tree",
								"type": "string"
							}
						},
						"required": [
							"kind"
						]
					},
					"minContains": 0,
					"maxContains": 1
				},
				{
					"contains": {
						"type": "object",
						"properties": {
							"kind": {
								"const": "scm.issue.core",
								"type": "string"
							}
						},
						"required": [
							"kind"
						]
					},
					"minContains": 0,
					"maxContains": 1
				},
				{
					"contains": {
						"type": "object",
						"properties": {
							"kind": {
								"const": "scm.issue.comments",
								"type": "string"
							}
						},
						"required": [
							"kind"
						]
					},
					"minContains": 0,
					"maxContains": 1
				},
				{
					"contains": {
						"type": "object",
						"properties": {
							"kind": {
								"const": "slack.conversation.thread",
								"type": "string"
							}
						},
						"required": [
							"kind"
						]
					},
					"minContains": 0,
					"maxContains": 1
				},
				{
					"contains": {
						"type": "object",
						"properties": {
							"kind": {
								"const": "scm.linked-work-items",
