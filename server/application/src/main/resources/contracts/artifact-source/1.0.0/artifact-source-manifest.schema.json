					"contains": {
						"type": "object",
						"properties": {
							"kind": {
								"const": "outline.documents",
								"type": "string"
							}
						},
						"required": [
							"kind"
						]
					},
					"minContains": 0,
					"maxContains": 1
				},
				{
					"contains": {
						"type": "object",
						"properties": {
							"kind": {
								"const": "docs.document.core",
								"type": "string"
							}
						},
						"required": [
							"kind"
						]
					},
					"minContains": 0,
					"maxContains": 1
				}
