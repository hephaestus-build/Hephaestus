							}
						},
						"required": [
							"kind"
						]
					},
					"minContains": 0,
					"maxContains": 1
				},
				{
					"contains": {
						"type": "object",
						"properties": {
							"kind": {
								"const": "scm.pull-request.commits",
								"type": "string"
							}
						},
						"required": [
							"kind"
						]
					},
					"minContains": 0,
					"maxContains": 1
				},
				{
					"contains": {
						"type": "object",
						"properties": {
							"kind": {
								"const": "workspace.project-inventory",
								"type": "string"
							}
						},
						"required": [
							"kind"
						]
					},
					"minContains": 0,
					"maxContains": 1
