{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://hephaestus.aet.cit.tum.de/contracts/item-source/3.0.0/automated-review-readiness-report.schema.json",
	"title": "Practice review readiness report",
	"description": "Per-practice capture readiness and applicability decisions for one captured evidence manifest.",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"contractVersion",
		"catalogDigest",
		"itemKind",
		"manifestCapturedAt",
		"decidedAt",
		"decisions",
		"applicability"
	],
	"properties": {
		"contractVersion": {
			"const": "3.0.0",
			"description": "Source contract used to interpret the referenced manifest and source checks."
		},
		"catalogDigest": {
			"const": "01b9ea3673a3b7b5b0870ea660eff53d3102599e1aa3b2907cefc5e5a3252027",
			"description": "SHA-256 digest of the exact source catalog used by the runtime."
		},
		"itemKind": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
			"description": "Kind of the item whose captured evidence this report checks."
		},
		"manifestCapturedAt": {
			"type": "string",
			"format": "date-time",
			"description": "Capture time of the evidence manifest checked by this report."
		},
		"decidedAt": {
			"type": "string",
			"format": "date-time",
			"description": "Time at which all readiness decisions in this report were made."
		},
		"decisions": {
			"type": "array",
			"minItems": 1,
			"items": {
				"$ref": "#/$defs/decision"
			},
			"uniqueItems": true,
			"description": "One capture-readiness decision for each practice considered by the invocation."
		},
		"applicability": {
			"type": "object",
			"additionalProperties": {
				"$ref": "#/$defs/applicability"
			},
			"description": "Mechanical Applies when decisions keyed by practice slug. Practices withheld by capture readiness have no applicability decision."
		}
	},
	"$defs": {
		"decision": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"practiceSlug",
				"decidedAt",
				"ready",
				"reasonCodes",
				"sourceChecks"
			],
			"properties": {
				"practiceSlug": {
					"type": "string",
					"minLength": 1,
					"description": "Stable identifier of the practice being considered."
				},
				"decidedAt": {
					"type": "string",
					"format": "date-time",
					"description": "Time this automated-review readiness decision was made."
				},
				"ready": {
					"type": "boolean",
					"description": "Whether the practice and its captured sources meet readiness requirements. Applicability is recorded separately."
				},
				"sourceChecks": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/sourceCheck"
					},
					"allOf": [
						{
							"contains": {
								"type": "object",
								"properties": {
									"sourceKind": {
										"const": "scm.pull-request.core",
										"type": "string"
									}
								},
								"required": [
									"sourceKind"
								]
							},
							"minContains": 0,
							"maxContains": 1
						},
						{
							"contains": {
								"type": "object",
								"properties": {
									"sourceKind": {
										"const": "scm.pull-request.diff",
										"type": "string"
									}
								},
								"required": [
									"sourceKind"
								]
							},
							"minContains": 0,
							"maxContains": 1
						},
						{
							"contains": {
								"type": "object",
								"properties": {
									"sourceKind": {
										"const": "scm.pull-request.comments",
										"type": "string"
									}
								},
								"required": [
									"sourceKind"
								]
							},
							"minContains": 0,
							"maxContains": 1
						},
						{
							"contains": {
								"type": "object",
								"properties": {
									"sourceKind": {
										"const": "scm.repository.tree",
										"type": "string"
									}
								},
								"required": [
									"sourceKind"
								]
							},
							"minContains": 0,
							"maxContains": 1
						},
						{
							"contains": {
								"type": "object",
								"properties": {
									"sourceKind": {
										"const": "scm.issue.core",
										"type": "string"
									}
								},
								"required": [
									"sourceKind"
								]
							},
							"minContains": 0,
							"maxContains": 1
						},
						{
							"contains": {
								"type": "object",
								"properties": {
									"sourceKind": {
										"const": "scm.issue.comments",
										"type": "string"
									}
								},
								"required": [
									"sourceKind"
								]
							},
							"minContains": 0,
							"maxContains": 1
						},
						{
							"contains": {
								"type": "object",
								"properties": {
									"sourceKind": {
										"const": "slack.conversation.thread",
										"type": "string"
									}
								},
								"required": [
									"sourceKind"
								]
							},
							"minContains": 0,
							"maxContains": 1
						},
						{
							"contains": {
								"type": "object",
								"properties": {
									"sourceKind": {
										"const": "scm.linked-work-items",
										"type": "string"
									}
								},
								"required": [
									"sourceKind"
								]
							},
							"minContains": 0,
							"maxContains": 1
						},
						{
							"contains": {
								"type": "object",
								"properties": {
									"sourceKind": {
										"const": "scm.review-threads",
										"type": "string"
									}
								},
								"required": [
									"sourceKind"
								]
							},
							"minContains": 0,
							"maxContains": 1
						},
						{
							"contains": {
								"type": "object",
								"properties": {
									"sourceKind": {
										"const": "scm.general-review-comments",
										"type": "string"
									}
								},
								"required": [
									"sourceKind"
								]
							},
							"minContains": 0,
							"maxContains": 1
						},
						{
							"contains": {
								"type": "object",
								"properties": {
									"sourceKind": {
										"const": "scm.pull-request.checks",
										"type": "string"
									}
								},
								"required": [
									"sourceKind"
								]
							},
							"minContains": 0,
							"maxContains": 1
						}
					],
					"description": "Checks for every required source; empty when a non-source prerequisite fails."
				},
				"reasonCodes": {
					"type": "array",
					"uniqueItems": true,
					"items": {
						"enum": [
							"NO_AUTOMATED_REVIEW",
							"DECLARED_EVIDENCE_INSUFFICIENT"
						]
					},
					"description": "Non-source reasons the practice must be skipped."
				}
			},
			"allOf": [
				{
					"if": {
						"type": "object",
						"properties": {
							"ready": {
								"const": true
							}
						},
						"required": [
							"ready"
						]
					},
					"then": {
						"properties": {
							"sourceChecks": {
								"type": "array",
								"minItems": 1,
								"items": {
									"allOf": [
										{
											"$ref": "#/$defs/sourceCheck"
										},
										{
											"type": "object",
											"properties": {
												"meetsRequirements": {
													"const": true
												}
											}
										}
									]
								}
							}
						}
					},
					"else": {
						"anyOf": [
							{
								"properties": {
									"reasonCodes": {
										"type": "array",
										"minItems": 1
									}
								}
							},
							{
								"properties": {
									"sourceChecks": {
										"type": "array",
										"contains": {
											"type": "object",
											"properties": {
												"meetsRequirements": {
													"const": false
												}
											},
											"required": [
												"meetsRequirements"
											]
										}
									}
								}
							}
						]
					}
				},
				{
					"if": {
						"properties": {
							"ready": {
								"const": true
							}
						},
						"required": [
							"ready"
						]
					},
					"then": {
						"properties": {
							"reasonCodes": {
								"type": "array",
								"maxItems": 0
							}
						}
					}
				}
			],
			"description": "Readiness decision for one exact practice version."
		},
		"sourceCheck": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"sourceKind",
				"sourceContractVersion",
				"checkedAt",
				"temporalAnchor",
				"meetsRequirements",
				"reasonCodes"
			],
			"properties": {
				"sourceKind": {
					"enum": [
						"scm.pull-request.core",
						"scm.pull-request.checks",
						"scm.pull-request.diff",
						"scm.pull-request.comments",
						"scm.repository.tree",
						"scm.issue.core",
						"scm.issue.comments",
						"docs.document.core",
						"slack.conversation.thread",
						"scm.linked-work-items",
						"scm.review-threads",
						"scm.general-review-comments"
					],
					"description": "Required logical source being checked."
				},
				"sourceContractVersion": {
					"const": "3.0.0",
					"description": "Source contract that defines the expected source semantics."
				},
				"checkedAt": {
					"type": "string",
					"format": "date-time",
					"description": "Time this check was evaluated."
				},
				"temporalAnchor": {
					"type": "string",
					"format": "date-time",
					"description": "Review submission time against which freshness is evaluated."
				},
				"meetsRequirements": {
					"type": "boolean",
					"description": "Whether this source passes all requirements declared by the practice."
				},
				"reasonCodes": {
					"type": "array",
					"uniqueItems": true,
					"items": {
						"enum": [
							"SOURCE_NOT_AVAILABLE",
							"SOURCE_INCOMPLETE",
							"REPOSITORY_FETCH_FAILED",
							"REVIEW_VERSION_UNAVAILABLE"
						]
					},
					"description": "Stable reasons this required source did not pass."
				}
			},
			"allOf": [
				{
					"if": {
						"type": "object",
						"properties": {
							"meetsRequirements": {
								"const": true
							}
						},
						"required": [
							"meetsRequirements"
						]
					},
					"then": {
						"properties": {
							"reasonCodes": {
								"type": "array",
								"maxItems": 0
							}
						}
					},
					"else": {
						"properties": {
							"reasonCodes": {
								"type": "array",
								"minItems": 1
							}
						}
					}
				}
			],
			"description": "Result of checking one required source against the practice requirements."
		},
		"applicability": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"absent",
				"otherwise",
				"clauses"
			],
			"description": "A practice is absent only when every clause proves absence in complete captured evidence.",
			"properties": {
				"absent": {
					"type": "boolean",
					"description": "Whether every declared clause returned NOT_FOUND."
				},
				"otherwise": {
					"type": "string",
					"minLength": 1,
					"description": "Authored reason recorded when the practice does not apply."
				},
				"clauses": {
					"type": "array",
					"minItems": 1,
					"items": {
						"$ref": "#/$defs/applicabilityClause"
					},
					"description": "Decision and owning evidence source for each declared condition."
				}
			}
		},
		"applicabilityClause": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"aspect",
				"readFrom",
				"result"
			],
			"description": "A neutral decision returned by the integration that captured the evidence.",
			"properties": {
				"aspect": {
					"enum": [
						"CHANGED_PATH",
						"DIFF_CONTAINS",
						"HAS_ITEMS"
					],
					"description": "The kind of condition evaluated."
				},
				"readFrom": {
					"$ref": "#/$defs/sourceCheck/properties/sourceKind",
					"description": "The source that owns the captured evidence, including a named collection."
				},
				"result": {
					"enum": [
						"FOUND",
						"NOT_FOUND",
						"UNDECIDABLE"
					],
					"description": "Whether the condition matched, was proven absent, or could not be decided."
				}
			}
		}
	},
	"allOf": [
		{
			"if": {
				"type": "object",
				"properties": {
					"itemKind": {
						"enum": [
							"scm.pull_request",
							"scm.pull_request_review"
						]
					}
				},
				"required": [
					"itemKind"
				]
			},
			"then": {
				"type": "object",
				"properties": {
					"decisions": {
						"type": "array",
						"items": {
							"allOf": [
								{
									"$ref": "#/$defs/decision"
								},
								{
									"type": "object",
									"properties": {
										"sourceChecks": {
											"type": "array",
											"items": {
												"allOf": [
													{
														"$ref": "#/$defs/sourceCheck"
													},
													{
														"type": "object",
														"properties": {
															"sourceKind": {
																"enum": [
																	"scm.pull-request.core",
																	"scm.pull-request.checks",
																	"scm.pull-request.diff",
																	"scm.pull-request.comments",
																	"scm.repository.tree",
																	"scm.linked-work-items",
																	"scm.review-threads",
																	"scm.general-review-comments"
																]
															}
														},
														"required": [
															"sourceKind"
														]
													}
												]
											}
										}
									}
								}
							]
						}
					}
				}
			}
		},
		{
			"if": {
				"type": "object",
				"properties": {
					"itemKind": {
						"const": "scm.issue"
					}
				},
				"required": [
					"itemKind"
				]
			},
			"then": {
				"type": "object",
				"properties": {
					"decisions": {
						"type": "array",
						"items": {
							"allOf": [
								{
									"$ref": "#/$defs/decision"
								},
								{
									"type": "object",
									"properties": {
										"sourceChecks": {
											"type": "array",
											"items": {
												"allOf": [
													{
														"$ref": "#/$defs/sourceCheck"
													},
													{
														"type": "object",
														"properties": {
															"sourceKind": {
																"enum": [
																	"scm.issue.core",
																	"scm.issue.comments"
																]
															}
														},
														"required": [
															"sourceKind"
														]
													}
												]
											}
										}
									}
								}
							]
						}
					}
				}
			}
		},
		{
			"if": {
				"type": "object",
				"properties": {
					"itemKind": {
						"const": "chat.thread"
					}
				},
				"required": [
					"itemKind"
				]
			},
			"then": {
				"type": "object",
				"properties": {
					"decisions": {
						"type": "array",
						"items": {
							"allOf": [
								{
									"$ref": "#/$defs/decision"
								},
								{
									"type": "object",
									"properties": {
										"sourceChecks": {
											"type": "array",
											"items": {
												"allOf": [
													{
														"$ref": "#/$defs/sourceCheck"
													},
													{
														"type": "object",
														"properties": {
															"sourceKind": {
																"enum": [
																	"slack.conversation.thread"
																]
															}
														},
														"required": [
															"sourceKind"
														]
													}
												]
											}
										}
									}
								}
							]
						}
					}
				}
			}
		},
		{
			"if": {
				"type": "object",
				"properties": {
					"itemKind": {
						"const": "docs.document"
					}
				},
				"required": [
					"itemKind"
				]
			},
			"then": {
				"type": "object",
				"properties": {
					"decisions": {
						"type": "array",
						"items": {
							"allOf": [
								{
									"$ref": "#/$defs/decision"
								},
								{
									"type": "object",
									"properties": {
										"sourceChecks": {
											"type": "array",
											"items": {
												"allOf": [
													{
														"$ref": "#/$defs/sourceCheck"
													},
													{
														"type": "object",
														"properties": {
															"sourceKind": {
																"enum": [
																	"docs.document.core"
																]
															}
														},
														"required": [
															"sourceKind"
														]
													}
												]
											}
										}
									}
								}
							]
						}
					}
				}
			}
		}
	]
}
