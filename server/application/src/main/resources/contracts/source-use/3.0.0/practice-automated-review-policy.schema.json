{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "hephaestus:reviewed-by:3.0.0",
	"title": "Reviewed by",
	"description": "Who reviews a practice, why a person is needed, and the limits of automated review.",
	"type": "object",
	"additionalProperties": false,
	"required": ["by", "humanReason", "limits"],
	"properties": {
		"by": {
			"description": "Whether Hephaestus, people, or nobody reviews this practice.",
			"enum": ["HEPHAESTUS", "PEOPLE", "NOBODY"]
		},
		"humanReason": {
			"description": "Reason this practice needs a person when reviewed by people; otherwise null.",
			"anyOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["code", "description"],
					"properties": {
						"code": {
							"type": "string",
							"minLength": 1,
							"maxLength": 64
						},
						"description": {
							"type": "string",
							"minLength": 1,
							"maxLength": 2000
						}
					}
				},
				{
					"type": "null"
				}
			]
		},
		"limits": {
			"description": "Known limits of reviewing this practice from captured evidence.",
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["code", "description"],
				"properties": {
					"code": {
						"type": "string",
						"minLength": 1,
						"maxLength": 64
					},
					"description": {
						"type": "string",
						"minLength": 1,
						"maxLength": 2000
					}
				}
			},
			"minItems": 0,
			"maxItems": 100
		}
	},
	"allOf": [
		{
			"if": {
				"properties": {
					"by": {
						"const": "PEOPLE"
					}
				}
			},
			"then": {
				"properties": {
					"humanReason": {
						"type": "object",
						"additionalProperties": false,
						"required": ["code", "description"],
						"properties": {
							"code": {
								"type": "string",
								"minLength": 1,
								"maxLength": 64
							},
							"description": {
								"type": "string",
								"minLength": 1,
								"maxLength": 2000
							}
						}
					}
				}
			},
			"else": {
				"properties": {
					"humanReason": {
						"type": "null"
					}
				}
			}
		}
	]
}
