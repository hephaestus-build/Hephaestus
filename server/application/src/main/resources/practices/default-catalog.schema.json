{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://hephaestus.aet.cit.tum.de/schemas/practices/default-catalog.schema.json",
	"title": "Bundled practice catalog",
	"description": "Practice groups and practice definitions offered by the shipped catalog.",
	"type": "object",
	"additionalProperties": false,
	"required": ["$schema", "version", "criteriaPreambles", "groups"],
	"properties": {
		"$schema": {
			"description": "Schema used to validate this catalog.",
			"const": "./default-catalog.schema.json"
		},
		"version": {
			"description": "Version of the bundled practice catalog format.",
			"const": "2.0.1"
		},
		"criteriaPreambles": {
			"description": "Named text that the catalog loader adds before practice criteria.",
			"type": "object",
			"additionalProperties": {
				"type": "string"
			}
		},
		"groups": {
			"description": "Practice groups and their bundled practices, in catalog order.",
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["slug", "name", "practices"],
				"properties": {
					"slug": {
						"type": "string",
						"pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
					},
					"name": {
						"type": "string"
					},
					"description": {
						"type": ["string", "null"]
					},
					"icon": {
						"type": ["string", "null"]
					},
					"color": {
						"type": ["string", "null"]
					},
					"practices": {
						"type": "array",
						"items": {
							"type": "object",
							"additionalProperties": false,
							"required": ["slug", "kind", "definition"],
							"properties": {
								"slug": {
									"type": "string",
									"pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
								},
								"kind": {
									"type": "string",
									"pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
								},
								"definition": {
									"$schema": "https://json-schema.org/draft/2020-12/schema",
									"type": "object",
									"additionalProperties": false,
									"required": [
										"name",
										"reviewOn",
										"about",
										"reads",
										"reviewedBy",
										"criteria",
										"lineNotes",
										"guidance"
									],
									"properties": {
										"name": {
											"type": "string",
											"minLength": 3,
											"maxLength": 128
										},
										"reviewOn": {
											"type": "object",
											"additionalProperties": false,
											"required": ["events", "state"],
											"properties": {
												"events": {
													"type": "array",
													"items": {
														"type": "string",
														"pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
														"maxLength": 128
													},
													"minItems": 0,
													"maxItems": 100,
													"uniqueItems": true
												},
												"state": {
													"type": "object",
													"additionalProperties": {
														"type": "array",
														"items": {
															"type": "string",
															"minLength": 1,
															"maxLength": 200
														},
														"minItems": 1,
														"maxItems": 100,
														"uniqueItems": true
													}
												}
											}
										},
										"appliesWhen": {
											"anyOf": [
												{
													"type": "object",
													"additionalProperties": false,
													"required": ["anyOf", "otherwise"],
													"properties": {
														"anyOf": {
															"type": "array",
															"items": {
																"oneOf": [
																	{
																		"type": "object",
																		"additionalProperties": false,
																		"required": ["changedPath"],
																		"properties": {
																			"changedPath": {
																				"type": "array",
																				"items": {
																					"type": "string",
																					"minLength": 1,
																					"maxLength": 200
																				},
																				"minItems": 1,
																				"maxItems": 100,
																				"uniqueItems": true
																			}
																		}
																	},
																	{
																		"type": "object",
																		"additionalProperties": false,
																		"required": ["diffContains"],
																		"properties": {
																			"diffContains": {
																				"type": "array",
																				"items": {
																					"type": "string",
																					"minLength": 1,
																					"maxLength": 200
																				},
																				"minItems": 1,
																				"maxItems": 100,
																				"uniqueItems": true
																			}
																		}
																	},
																	{
																		"type": "object",
																		"additionalProperties": false,
																		"required": ["hasItems"],
																		"properties": {
																			"hasItems": {
																				"type": "string",
																				"minLength": 1,
																				"maxLength": 4096
																			}
																		}
																	},
																	{
																		"type": "object",
																		"additionalProperties": false,
																		"required": ["merged"],
																		"properties": {
																			"merged": {
																				"const": true
																			}
																		}
																	}
																]
															},
															"minItems": 1,
															"maxItems": 100
														},
														"otherwise": {
															"type": "string",
															"minLength": 1,
															"maxLength": 1000
														}
													}
												},
												{
													"type": "null"
												}
											]
										},
										"about": {
											"enum": ["AUTHOR", "REVIEWER", "ASSIGNEE", "MERGER", null]
										},
										"reads": {
											"$ref": "#/$defs/practiceReads"
										},
										"reviewedBy": {
											"type": "object",
											"additionalProperties": false,
											"required": ["by", "limits"],
											"properties": {
												"by": {
													"enum": ["HEPHAESTUS", "PEOPLE", "NOBODY"]
												},
												"humanReason": {
													"anyOf": [
														{
															"type": "object",
															"additionalProperties": false,
															"required": ["code", "description"],
															"properties": {
																"code": {
																	"type": "string",
																	"minLength": 1,
																	"maxLength": 64
																},
																"description": {
																	"type": "string",
																	"minLength": 1,
																	"maxLength": 2000
																}
															}
														},
														{
															"type": "null"
														}
													]
												},
												"limits": {
													"type": "array",
													"items": {
														"type": "object",
														"additionalProperties": false,
														"required": ["code", "description"],
														"properties": {
															"code": {
																"type": "string",
																"minLength": 1,
																"maxLength": 64
															},
															"description": {
																"type": "string",
																"minLength": 1,
																"maxLength": 2000
															}
														}
													},
													"minItems": 0,
													"maxItems": 100
												}
											},
											"allOf": [
												{
													"if": {
														"properties": {
															"by": {
																"const": "PEOPLE"
															}
														}
													},
													"then": {
														"properties": {
															"humanReason": {
																"type": "object",
																"additionalProperties": false,
																"required": ["code", "description"],
																"properties": {
																	"code": {
																		"type": "string",
																		"minLength": 1,
																		"maxLength": 64
																	},
																	"description": {
																		"type": "string",
																		"minLength": 1,
																		"maxLength": 2000
																	}
																}
															}
														}
													},
													"else": {
														"properties": {
															"humanReason": {
																"type": "null"
															}
														}
													}
												}
											]
										},
										"criteria": {
											"type": "string",
											"minLength": 1,
											"maxLength": 50000
										},
										"script": {
											"anyOf": [
												{
													"type": "string",
													"minLength": 1,
													"maxLength": 100000
												},
												{
													"type": "null"
												}
											]
										},
										"scan": {
											"anyOf": [
												{
													"type": "object",
													"additionalProperties": false,
													"required": ["itemKind", "include", "exclude", "context", "reads"],
													"properties": {
														"itemKind": {
															"type": "string",
															"pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
															"maxLength": 64
														},
														"include": {
															"type": "array",
															"items": {
																"type": "string",
																"minLength": 1,
																"maxLength": 512
															},
															"minItems": 1,
															"maxItems": 64,
															"uniqueItems": true
														},
														"exclude": {
															"type": "array",
															"items": {
																"type": "string",
																"minLength": 1,
																"maxLength": 512
															},
															"minItems": 0,
															"maxItems": 64,
															"uniqueItems": true
														},
														"context": {
															"type": "array",
															"items": {
																"type": "string",
																"minLength": 1,
																"maxLength": 512
															},
															"minItems": 0,
															"maxItems": 64,
															"uniqueItems": true
														},
														"reads": {
															"$ref": "#/$defs/practiceReads"
														}
													}
												},
												{
													"type": "null"
												}
											]
										},
										"lineNotes": {
											"type": "boolean"
										},
										"guidance": {
											"type": "object",
											"additionalProperties": false,
											"required": ["whyItMatters", "whatGoodLooksLike", "goingWell"],
											"properties": {
												"whyItMatters": {
													"anyOf": [
														{
															"type": "string",
															"maxLength": 2000
														},
														{
															"type": "null"
														}
													]
												},
												"whatGoodLooksLike": {
													"anyOf": [
														{
															"type": "string",
															"maxLength": 2000
														},
														{
															"type": "null"
														}
													]
												},
												"goingWell": {
													"anyOf": [
														{
															"type": "string",
															"maxLength": 2000
														},
														{
															"type": "null"
														}
													]
												},
												"visual": {
													"anyOf": [
														{
															"type": "object",
															"additionalProperties": false,
															"required": ["svg", "alt"],
															"properties": {
																"svg": {
																	"type": "string",
																	"minLength": 1
																},
																"alt": {
																	"type": "string",
																	"minLength": 1
																}
															}
														},
														{
															"type": "null"
														}
													]
												},
												"guide": {
													"anyOf": [
														{
															"type": "object",
															"additionalProperties": false,
															"required": ["markdown", "figures"],
															"properties": {
																"markdown": {
																	"type": "string"
																},
																"figures": {
																	"type": "object",
																	"additionalProperties": {
																		"type": "string",
																		"minLength": 1
																	}
																}
															}
														},
														{
															"type": "null"
														}
													]
												}
											}
										}
									},
									"$defs": {
										"practiceReads": {
											"type": "object",
											"additionalProperties": false,
											"required": ["contract", "sources"],
											"properties": {
												"contract": {
													"type": "string",
													"minLength": 1,
													"maxLength": 32
												},
												"sources": {
													"type": "array",
													"items": {
														"type": "object",
														"additionalProperties": false,
														"required": ["source", "need"],
														"properties": {
															"source": {
																"type": "string",
																"minLength": 1,
																"maxLength": 4096
															},
															"need": {
																"enum": ["REQUIRED", "COMPLETE", "OPTIONAL"]
															}
														}
													},
													"minItems": 0,
													"maxItems": 100
												}
											}
										}
									},
									"$id": "hephaestus:bundled-practice-definition:v1"
								},
								"scriptResource": {
									"type": "string",
									"pattern": "^practices/scripts/[a-z0-9-]+\\.ts$"
								},
								"preamble": {
									"type": "string"
								},
								"visualResource": {
									"type": "object",
									"additionalProperties": false,
									"required": ["file", "alt"],
									"properties": {
										"file": {
											"type": "string"
										},
										"alt": {
											"type": "string",
											"minLength": 1
										}
									}
								},
								"guideResource": {
									"type": "string"
								}
							}
						}
					}
				}
			}
		}
	}
}
