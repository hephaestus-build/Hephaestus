<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <preConditions onFail="HALT" onError="HALT" onFailMessage="Database prerequisites failed. PostgreSQL 18 is required. This database was created by a Hephaestus release before 1.0.0-rc.1, and Hephaestus 1.x starts from 1.0.0-rc.1: install 1.0.0-rc.1 and complete its upgrade first, then upgrade to 1.x. A new installation needs an empty database. Follow the upgrade guide: https://docs.hephaestus.build/admin/upgrade.">
        <dbms type="postgresql"/>
        <sqlCheck expectedResult="18">SELECT current_setting('server_version_num')::integer / 10000</sqlCheck>
        <!-- Global preconditions also run before changeLogSyncToTag; changeset preconditions do not. -->
        <or>
            <not>
                <tableExists tableName="databasechangelog"/>
            </not>
            <sqlCheck expectedResult="0">SELECT count(*) FROM databasechangelog</sqlCheck>
            <changeSetExecuted id="1.0.0-tag" author="hephaestus" changeLogFile="db/changelog/1.0.0/baseline.xml"/>
            <changeSetExecuted id="1793504565891-1" author="hephaestus"
                               changeLogFile="db/changelog/next/20261101103000-erasure-history-redaction.xml"/>
        </or>
    </preConditions>
    <include file="./changelog/1.0.0/baseline.xml" relativeToChangelogFile="true"/>
    <includeAll path="./changelog/next" relativeToChangelogFile="true" errorIfMissingOrEmpty="false" endsWithFilter=".xml" maxDepth="1"/>
</databaseChangeLog>
