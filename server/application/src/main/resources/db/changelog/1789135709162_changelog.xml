<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="1789135709162-1" author="hephaestus">
        <addColumn tableName="git_commit">
            <column name="git_details_captured_at" type="TIMESTAMP(6) WITH TIME ZONE"/>
        </addColumn>
    </changeSet>
    <changeSet id="1789135709162-2" author="hephaestus">
        <createTable tableName="pull_request_closing_issue">
            <column name="pull_request_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pull_request_closing_issuePK"/>
            </column>
            <column name="issue_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pull_request_closing_issuePK"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1789135709162-3" author="hephaestus">
        <addColumn tableName="issue">
            <column name="head_check_sha" type="VARCHAR(40)"/>
        </addColumn>
    </changeSet>
    <changeSet id="1789135709162-4" author="hephaestus">
        <addColumn tableName="issue">
            <column name="head_check_state" type="VARCHAR(16)"/>
        </addColumn>
    </changeSet>
    <changeSet id="1789135709162-5" author="hephaestus">
        <addColumn tableName="pull_request_review_thread">
            <column name="resolved_at" type="TIMESTAMP(6) WITH TIME ZONE"/>
        </addColumn>
    </changeSet>
    <changeSet id="1789135709162-6" author="hephaestus">
        <addForeignKeyConstraint baseColumnNames="issue_id" baseTableName="pull_request_closing_issue" constraintName="fk_pull_request_closing_issue_issue" deferrable="false" initiallyDeferred="false" referencedColumnNames="id" referencedTableName="issue" validate="true"/>
    </changeSet>
    <changeSet id="1789135709162-7" author="hephaestus">
        <addForeignKeyConstraint baseColumnNames="pull_request_id" baseTableName="pull_request_closing_issue" constraintName="fk_pull_request_closing_issue_pull_request" deferrable="false" initiallyDeferred="false" referencedColumnNames="id" referencedTableName="issue" validate="true"/>
    </changeSet>
</databaseChangeLog>
