<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="1794654136087-1" author="hephaestus">
        <comment>Each signed Slack interactivity request is handled once.</comment>
        <createTable tableName="slack_request_claim">
            <column name="signature" type="VARCHAR(80)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="slack_request_claim_pkey"/>
            </column>
            <column name="claimed_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="ix_slack_request_claim_claimed_at" tableName="slack_request_claim">
            <column name="claimed_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
