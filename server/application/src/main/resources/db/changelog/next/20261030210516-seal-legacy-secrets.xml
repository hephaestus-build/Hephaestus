<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog logicalFilePath="db/changelog/1793394316000_changelog.xml" xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="1793394316000-1" author="hephaestus">
        <preConditions onFail="HALT" onError="HALT">
            <columnExists tableName="login_provider" columnName="id"/>
            <columnExists tableName="login_provider" columnName="client_secret"/>
            <columnExists tableName="llm_connection" columnName="id"/>
            <columnExists tableName="llm_connection" columnName="api_key"/>
            <columnExists tableName="workspace_llm_connection" columnName="id"/>
            <columnExists tableName="workspace_llm_connection" columnName="api_key"/>
            <columnExists tableName="jwt_signing_key" columnName="kid"/>
            <columnExists tableName="jwt_signing_key" columnName="private_key_pem"/>
            <columnExists tableName="jwt_signing_key" columnName="encryption_key_id"/>
            <columnExists tableName="connection" columnName="id"/>
            <columnExists tableName="connection" columnName="workspace_id"/>
            <columnExists tableName="connection" columnName="kind"/>
            <columnExists tableName="connection" columnName="instance_key"/>
            <columnExists tableName="connection" columnName="credentials_encrypted"/>
            <columnExists tableName="connection" columnName="credentials_alg"/>
            <columnExists tableName="connection" columnName="credentials_key_version"/>
            <columnExists tableName="connection" columnName="credentials_rotation_failed_at"/>
            <columnExists tableName="connection" columnName="updated_at"/>
            <columnExists tableName="connection" columnName="version"/>
        </preConditions>
        <comment>Encrypt legacy plaintext secrets and unsealed JWT keys. Repair connection credentials whose released backfill omitted the key version. Preserve signing identities and connection state.</comment>
        <customChange class="de.tum.cit.aet.hephaestus.core.database.LegacySecretsChange"/>
        <customChange class="de.tum.cit.aet.hephaestus.integration.core.connection.migration.LegacyConnectionSecretsChange"/>
        <sql>ALTER TABLE connection ADD CONSTRAINT ck_connection_encrypted_requires_key_version CHECK (credentials_encrypted IS NULL OR credentials_key_version IS NOT NULL)</sql>
        <rollback>
            <stop>Restore the verified pre-upgrade database backup and its matching encryption keys before starting the previous release.</stop>
        </rollback>
    </changeSet>
</databaseChangeLog>
