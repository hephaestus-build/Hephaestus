<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="1793653500000-1" author="hephaestus">
        <comment>GitLab numbers issues and merge requests in separate sequences, so a provider id is unique per item type only.</comment>
        <addUniqueConstraint tableName="issue" columnNames="provider_id, issue_type, native_id" constraintName="uq_issue_provider_type_native_id"/>
        <dropUniqueConstraint tableName="issue" constraintName="uq_issue_provider_native_id"/>
    </changeSet>
</databaseChangeLog>
