<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="1793168406889-1" author="hephaestus">
        <addColumn tableName="issued_jwt">
            <column name="predecessor_jti" type="UUID"/>
        </addColumn>
        <!-- A rollback drops successor tracking and ends no session. Stale tokens can stay live for up to accessTtl (24h by default) after a rollback. -->
        <rollback>
            <dropColumn tableName="issued_jwt" columnName="predecessor_jti"/>
        </rollback>
    </changeSet>
    <changeSet id="1793168406889-2" author="hephaestus">
        <createIndex indexName="ix_issued_jwt_predecessor_jti" tableName="issued_jwt">
            <column name="account_id"/>
            <column name="predecessor_jti"/>
        </createIndex>
        <rollback>
            <dropIndex tableName="issued_jwt" indexName="ix_issued_jwt_predecessor_jti"/>
        </rollback>
    </changeSet>
    <changeSet id="1793168406889-3" author="hephaestus">
        <addColumn tableName="issued_jwt"><column name="used_at" type="TIMESTAMP WITH TIME ZONE"/></addColumn>
        <rollback><dropColumn tableName="issued_jwt" columnName="used_at"/></rollback>
    </changeSet>
    <changeSet id="1793168406889-4" author="hephaestus">
        <sql>CREATE UNIQUE INDEX uq_issued_jwt_live_successor ON issued_jwt (predecessor_jti) WHERE predecessor_jti IS NOT NULL AND revoked_at IS NULL</sql>
        <rollback><sql>DROP INDEX uq_issued_jwt_live_successor</sql></rollback>
    </changeSet>
</databaseChangeLog>
