            </column>
            <column name="parent_conversation_id" type="UUID"/>
            <column name="parent_entry_id" type="UUID"/>
            <column name="slack_channel_id" type="VARCHAR(32)"/>
            <column name="slack_team_id" type="VARCHAR(32)"/>
            <column name="slack_user_id" type="VARCHAR(32)"/>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="workspace_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
