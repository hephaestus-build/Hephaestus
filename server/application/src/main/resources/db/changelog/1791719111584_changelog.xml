<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="1791719111584-1" author="hephaestus">
        <preConditions onFail="HALT" onError="HALT">
            <tableExists tableName="chat_thread"/>
            <tableExists tableName="chat_message"/>
            <tableExists tableName="chat_message_vote"/>
            <tableExists tableName="mentor_slack_thread"/>
            <columnExists tableName="feedback_placement" columnName="chat_message_id"/>
        </preConditions>
        <comment>Drop the Heph chat tables. Conversational placements keep their feedback without the message.</comment>
        <dropForeignKeyConstraint baseTableName="feedback_placement" constraintName="sfk_feedback_placement_chat_message"/>
        <sql>UPDATE feedback_placement SET chat_message_id = NULL WHERE chat_message_id IS NOT NULL</sql>
        <renameColumn tableName="feedback_placement" oldColumnName="chat_message_id" newColumnName="mentor_entry_id" columnDataType="UUID"/>
        <dropTable tableName="mentor_slack_thread" cascadeConstraints="true"/>
        <dropTable tableName="chat_message_vote" cascadeConstraints="true"/>
        <dropTable tableName="chat_message" cascadeConstraints="true"/>
        <dropTable tableName="chat_thread" cascadeConstraints="true"/>
        <rollback>
            <stop>Restore the verified pre-upgrade backup; this migration does not keep the earlier Heph chat history.</stop>
        </rollback>
    </changeSet>
    <changeSet id="1791719111584-2" author="hephaestus">
