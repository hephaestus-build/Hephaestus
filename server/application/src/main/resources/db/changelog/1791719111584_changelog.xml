    <changeSet id="1791719111584-15" author="hephaestus">
        <comment>Value and shape rules of the Heph ledger that JPA does not express.</comment>
        <sql splitStatements="true" endDelimiter=";"><![CDATA[
            ALTER TABLE mentor_conversation ADD CONSTRAINT chk_mentor_conversation_thread
                CHECK ((parent_conversation_id IS NULL) = (parent_entry_id IS NULL));
            ALTER TABLE mentor_conversation ADD CONSTRAINT chk_mentor_conversation_slack
                CHECK ((slack_team_id IS NULL AND slack_user_id IS NULL AND slack_channel_id IS NULL)
                    OR (slack_team_id IS NOT NULL AND slack_user_id IS NOT NULL AND slack_channel_id IS NOT NULL
                        AND parent_conversation_id IS NULL));
            ALTER TABLE mentor_entry ADD CONSTRAINT chk_mentor_entry_kind
                CHECK (kind IN ('USER', 'HEPH', 'TOOL_RESULT', 'SYSTEM', 'SUMMARY', 'DIGEST'));
            ALTER TABLE mentor_entry ADD CONSTRAINT chk_mentor_entry_surface
                CHECK (surface IN ('APP', 'SLACK', 'SYSTEM'));
            ALTER TABLE mentor_entry ADD CONSTRAINT chk_mentor_entry_slack_delivery
                CHECK (slack_delivery IS NULL OR slack_delivery IN ('PENDING', 'DELIVERED', 'UNCERTAIN', 'FAILED'));
            ALTER TABLE mentor_entry ADD CONSTRAINT chk_mentor_entry_vote
                CHECK (vote IS NULL OR vote IN ('HELPFUL', 'NOT_HELPFUL'));
            ALTER TABLE mentor_entry ADD CONSTRAINT chk_mentor_entry_payload_shape
                CHECK (payload IS NULL OR jsonb_typeof(payload) = 'object');
            ALTER TABLE mentor_turn ADD CONSTRAINT chk_mentor_turn_status
                CHECK (status IN ('QUEUED', 'RUNNING', 'DONE', 'FAILED', 'STOPPED'));
            ALTER TABLE mentor_turn ADD CONSTRAINT chk_mentor_turn_surface
                CHECK (surface IN ('APP', 'SLACK'));
        ]]></sql>
    </changeSet>
    <changeSet id="1791719111584-16" author="hephaestus">
        <comment>Partial indexes and storage settings of the Heph ledger and its feedback placements that JPA does not express.</comment>
        <sql splitStatements="true" endDelimiter=";"><![CDATA[
            CREATE UNIQUE INDEX ux_mentor_conversation_main ON mentor_conversation (workspace_id, user_id)
                WHERE parent_conversation_id IS NULL;
            CREATE INDEX idx_mentor_conversation_slack ON mentor_conversation (slack_user_id, slack_team_id)
                WHERE slack_user_id IS NOT NULL;
            CREATE UNIQUE INDEX ux_mentor_entry_request ON mentor_entry (request_id) WHERE request_id IS NOT NULL;
            CREATE INDEX ix_mentor_entry_text_search ON mentor_entry USING gin (to_tsvector('simple'::regconfig, text))
                WHERE kind IN ('USER', 'HEPH', 'DIGEST');
            CREATE INDEX ix_mentor_entry_slack_question_unsettled ON mentor_entry (turn_id)
                WHERE kind = 'USER' AND surface = 'SLACK'
                    AND (slack_delivery IS NULL OR slack_delivery IN ('PENDING', 'UNCERTAIN'));
            CREATE INDEX ix_mentor_entry_digest_unsettled ON mentor_entry (created_at)
                WHERE kind = 'DIGEST' AND slack_delivery IN ('PENDING', 'UNCERTAIN');
            CREATE INDEX ix_feedback_placement_mentor_entry ON feedback_placement (mentor_entry_id)
                WHERE mentor_entry_id IS NOT NULL;
            CREATE UNIQUE INDEX ux_mentor_turn_running ON mentor_turn (conversation_id) WHERE status = 'RUNNING';
            CREATE INDEX idx_mentor_turn_leased_until ON mentor_turn (leased_until) WHERE leased_until IS NOT NULL;
            ALTER TABLE mentor_turn SET (fillfactor = 50);
        ]]></sql>
    </changeSet>
    <changeSet id="1791719111584-17" author="hephaestus">
        <comment>Workspace, conversation and turn ownership of the Heph ledger, and the Heph answer that delivered a conversational placement.</comment>
        <sql splitStatements="true" endDelimiter=";"><![CDATA[
            ALTER TABLE mentor_conversation ADD CONSTRAINT sfk_mentor_conversation_workspace
                FOREIGN KEY (workspace_id) REFERENCES workspace (id) ON DELETE CASCADE;
            ALTER TABLE mentor_conversation ADD CONSTRAINT sfk_mentor_conversation_user
                FOREIGN KEY (user_id) REFERENCES "user" (id) ON DELETE CASCADE;
            ALTER TABLE mentor_conversation ADD CONSTRAINT sfk_mentor_conversation_parent
                FOREIGN KEY (parent_conversation_id) REFERENCES mentor_conversation (id) ON DELETE CASCADE;
            ALTER TABLE mentor_entry ADD CONSTRAINT sfk_mentor_entry_workspace
                FOREIGN KEY (workspace_id) REFERENCES workspace (id) ON DELETE CASCADE;
            ALTER TABLE mentor_entry ADD CONSTRAINT sfk_mentor_entry_conversation
                FOREIGN KEY (conversation_id) REFERENCES mentor_conversation (id) ON DELETE CASCADE;
            ALTER TABLE mentor_conversation ADD CONSTRAINT sfk_mentor_conversation_parent_entry
                FOREIGN KEY (parent_entry_id) REFERENCES mentor_entry (id) ON DELETE CASCADE;
            ALTER TABLE mentor_turn ADD CONSTRAINT sfk_mentor_turn_workspace
                FOREIGN KEY (workspace_id) REFERENCES workspace (id) ON DELETE CASCADE;
            ALTER TABLE mentor_turn ADD CONSTRAINT sfk_mentor_turn_conversation
                FOREIGN KEY (conversation_id) REFERENCES mentor_conversation (id) ON DELETE CASCADE;
            ALTER TABLE mentor_entry ADD CONSTRAINT sfk_mentor_entry_turn
                FOREIGN KEY (turn_id) REFERENCES mentor_turn (id) ON DELETE SET NULL;
            ALTER TABLE feedback_placement ADD CONSTRAINT sfk_feedback_placement_mentor_entry
                FOREIGN KEY (mentor_entry_id) REFERENCES mentor_entry (id) ON DELETE SET NULL;
        ]]></sql>
    </changeSet>
