<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="1793137687696-1" author="hephaestus">
        <addColumn tableName="review_job">
            <column name="leased_until" type="TIMESTAMP(6) WITH TIME ZONE"/>
        </addColumn>
    </changeSet>
    <changeSet id="1793137687696-2" author="hephaestus">
        <comment>Each heartbeat renews and each lease check reads only the running attempts.</comment>
        <sql>CREATE INDEX ix_review_job_running_lease ON review_job (worker_id, leased_until) WHERE status = 'RUNNING';</sql>
    </changeSet>
</databaseChangeLog>
