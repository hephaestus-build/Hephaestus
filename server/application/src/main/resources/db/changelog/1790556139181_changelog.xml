<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="1790556139181-1" author="hephaestus">
        <createIndex indexName="idx_observation_workspace_observed" tableName="observation">
            <column name="workspace_id"/>
            <column name="observed_at"/>
        </createIndex>
    </changeSet>
    <!-- idx_observation_workspace_observed leads with workspace_id, so it serves every lookup by workspace alone. -->
    <changeSet id="1790556139181-2" author="hephaestus">
        <preConditions onFail="MARK_RAN">
            <indexExists tableName="observation" indexName="idx_observation_workspace"/>
        </preConditions>
        <dropIndex tableName="observation" indexName="idx_observation_workspace"/>
        <rollback>
            <createIndex tableName="observation" indexName="idx_observation_workspace">
                <column name="workspace_id"/>
            </createIndex>
        </rollback>
    </changeSet>
</databaseChangeLog>
