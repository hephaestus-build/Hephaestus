    <changeSet id="1788900580363-16" author="hephaestus">
        <comment>Native authority is acquired atomically; different workspaces cannot overlap organization and team scopes.</comment>
        <sql>
            ALTER TABLE github_access_target ADD CONSTRAINT ck_github_access_target_native_scope
                CHECK ((organization_id IS NULL OR organization_id &gt; 0)
                    AND (scope_id IS NULL OR (scope_id &gt;= 0 AND scope_id &lt; 9223372036854775807))
                    AND (NOT authority_held OR (organization_id IS NOT NULL AND scope_id IS NOT NULL)));
            ALTER TABLE github_access_target ADD CONSTRAINT ex_github_access_authority
                EXCLUDE USING gist (organization_id WITH =,
                    (CASE WHEN scope_id = 0 THEN int8range(NULL, NULL)
                        ELSE int8range(scope_id, scope_id, '[]') END) WITH &amp;&amp;,
                    workspace_id WITH &lt;&gt;) WHERE (authority_held);
            CREATE UNIQUE INDEX uq_github_access_held_scope ON github_access_target (workspace_id, organization_id, scope_id)
                WHERE authority_held;
            ALTER TABLE github_access_target ADD CONSTRAINT ck_github_access_target_status CHECK (status IN ('DRAFT','ACTIVE','ENDING','ENDED'));
            ALTER TABLE github_access_target ADD CONSTRAINT ck_github_access_target_groups CHECK (jsonb_typeof(draft_group_ids) = 'array' AND jsonb_typeof(approved_group_ids) = 'array');
            ALTER TABLE github_access_target ADD CONSTRAINT ck_github_access_target_configuration CHECK (configuration_version &gt; 0 AND pending_installation_id &gt; 0);
            ALTER TABLE github_access_action ADD CONSTRAINT ck_github_access_action_scope CHECK (organization_id &gt; 0 AND scope_id &gt;= 0 AND github_user_id &gt; 0 AND configuration_version &gt; 0);
            ALTER TABLE github_access_action ADD CONSTRAINT ck_github_access_action_type CHECK (type IN ('GRANT','REVOKE'));
            ALTER TABLE github_access_action ADD CONSTRAINT ck_github_access_action_status CHECK (status IN ('PENDING','CONFIRMED','INVALIDATED','MANUAL_RECOVERY'));
            ALTER TABLE github_access_membership ADD CONSTRAINT ck_github_access_membership_native_id CHECK (github_user_id &gt; 0);
            CREATE UNIQUE INDEX uq_github_access_unresolved_action ON github_access_action (membership_id)
                WHERE status IN ('PENDING', 'MANUAL_RECOVERY');
        </sql>
    </changeSet>
