    <changeSet id="1788900580363-30" author="hephaestus">
        <comment>Eligibility sources retain distinct provenance; a held request team scope pins its approved local team.</comment>
        <sql><![CDATA[
            UPDATE github_access_target SET preview = NULL;
            ALTER TABLE github_access_target ADD CONSTRAINT ck_github_access_target_source CHECK (
                (source = 'DIRECTORY' AND directory_provider_id IS NOT NULL AND registration_id IS NOT NULL
                    AND issuer IS NOT NULL AND request_team_id IS NULL)
                OR (source = 'REQUEST' AND directory_provider_id IS NULL AND registration_id IS NULL
                    AND issuer IS NULL AND draft_group_ids = '[]'::jsonb AND approved_group_ids = '[]'::jsonb
                    AND (request_team_id IS NULL OR request_team_id > 0)
                    AND (NOT authority_held OR (scope_id = 0 AND request_team_id IS NULL)
                        OR (scope_id > 0 AND request_team_id IS NOT NULL)))
            );
        ]]></sql>
    </changeSet>
