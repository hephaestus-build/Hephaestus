# The template of server/.env, the local settings of this checkout.
# `vp run dev:env` creates server/.env from it, and so do the dev and database commands that run it first.
# Edit server/.env; never copy this file over it: it holds generated values your database needs.
# docs/contributor/local-development.mdx § Local settings.

# =============================================================================
# HOST PORTS
# =============================================================================
# `vp run dev:env` gives each worktree its own host ports at the end of this file:
# docs/contributor/local-development.mdx § Port map.

# =============================================================================
# GENERATED VALUES
# =============================================================================
# `vp run dev:env` adds the generated values at the end of this file and never replaces a value:
# docs/contributor/local-development.mdx § Local settings.

# =============================================================================
# AUTHENTICATION (Hephaestus-native — no Keycloak; ADR 0017)
# =============================================================================
# GitHub OAuth App (https://github.com/settings/developers), callback:
#   http://localhost:8080/login/oauth2/code/github
# Blank skips GitHub login. The first boot with a value stores it as a login provider.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Default GitLab login slot (registration id "gitlab"), redirect URI
#   http://localhost:8080/login/oauth2/code/gitlab , scope read_user (OAuth2 flow, not OIDC).
# Leave the client id blank to disable this slot. For a self-hosted instance you can either point
# base-url at it, OR — to give it a descriptive, stable id and/or run SEVERAL GitLab instances —
# declare keyed providers directly (see the block below) and leave this blank.
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
# GitLab instance the login federates to (defaults to https://gitlab.com; e.g. https://gitlab.lrz.de)
# and the login-button label (defaults to GitLab).
GITLAB_OAUTH_BASE_URL=https://gitlab.com
GITLAB_OAUTH_DISPLAY_NAME=GitLab

# Additional / instance-specific login providers (multiple per instance supported). Each is a keyed
# entry under hephaestus.auth.login-providers.<registrationId> — the key is the OAuth callback segment
# AND the permanent identity key, so pick it deliberately (e.g. gitlab-lrz). Register this redirect URI
# on the OAuth app: http://localhost:8080/login/oauth2/code/<registrationId> . Scope is derived from
# type (GitLab → read_user only, never openid). github.com is the only supported GitHub host (GHE is
# out of scope); GitLab works against any instance (one provider per distinct base-url). Example:
#   hephaestus.auth.login-providers.gitlab-lrz.type=GITLAB
#   hephaestus.auth.login-providers.gitlab-lrz.base-url=https://gitlab.lrz.de
#   hephaestus.auth.login-providers.gitlab-lrz.client-id=replace-with-gitlab-client-id
#   hephaestus.auth.login-providers.gitlab-lrz.client-secret=replace-with-gitlab-client-secret
#   hephaestus.auth.login-providers.gitlab-lrz.display-name=GitLab LRZ

# Base64-encoded 32-byte AES-256 key sealing the short-lived OAuth state cookies.
# Blank in local dev → an ephemeral per-boot key is generated (in-flight logins don't
# survive a restart). MUST be set in production. Generate: openssl rand -base64 32
#HEPHAESTUS_AUTH_STATE_COOKIE_KEY=
# Public issuer origin (prod only; defaults to http://localhost:8080 in dev).
#HEPHAESTUS_AUTH_ISSUER=https://hephaestus.example.com

# GITHUB_PAT for GitHub API authentication (as alternative for env variable)
#GITHUB_PAT=replace-with-github-pat
# =============================================================================
# HEPH RUNTIME (advanced — usually leave defaults)
# =============================================================================
# Heph is on in a workspace while its Heph model binding is enabled (workspace admin, AI models).
# Running a live turn needs sandboxes in Kubernetes. Start them with vp run dev:kubernetes.
# Host bootRun leaves AGENT_ENABLED off.
# Tunables. Leave unset for the defaults in docs/admin/runtime-roles.mdx § Tunables.
# HEPHAESTUS_MENTOR_TURN_CAPACITY=
# HEPHAESTUS_MENTOR_TURN_LEASE=
# HEPHAESTUS_MENTOR_TURN_MAX_FOLLOW_UPS=

# Sandbox configuration: docs/admin/kubernetes.mdx.

# Passkey policy. Production requires passkeys for instance administration by default.
#HEPHAESTUS_AUTH_PASSKEYS_INSTANCE_ADMIN_REQUIRED=true
#HEPHAESTUS_AUTH_PASSKEYS_WORKSPACE_ADMIN_REQUIRED=false
#HEPHAESTUS_AUTH_PASSKEYS_RP_ID=hephaestus.example.com
#HEPHAESTUS_AUTH_PASSKEYS_ALLOWED_ORIGINS=https://hephaestus.example.com

# Stored secrets and JWT signing keys require encryption keys, including local development.
# Keep the existing keys and versions when you reuse a database.
HEPHAESTUS_SECURITY_ENCRYPTION_KEY=
HEPHAESTUS_SECURITY_CREDENTIAL_ENCRYPTION_KEY=
