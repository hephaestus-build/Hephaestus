<?xml version="1.0"?>
<ruleset name="Hephaestus PMD Test Rules"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">

    <description>Rules for test sources. The main rules in pmd-ruleset.xml do not apply to tests.</description>

    <rule name="SleepInTest" language="java"
          class="net.sourceforge.pmd.lang.rule.xpath.XPathRule"
          message="Wait for the event, not for elapsed time: use Awaitility or a latch. Suppress with the reason only when the elapsed time is the behaviour under test.">
        <description>A fixed sleep makes a test slow when the event is early and flaky when it is late.</description>
        <priority>2</priority>
        <properties>
            <property name="xpath">
                <value><![CDATA[
                    //MethodCall[
                      pmd-java:matchesSig('java.lang.Thread#sleep(long)')
                      or pmd-java:matchesSig('java.lang.Thread#sleep(long,int)')
                      or pmd-java:matchesSig('java.lang.Thread#sleep(java.time.Duration)')
                      or pmd-java:matchesSig('java.util.concurrent.TimeUnit#sleep(long)')
                    ]
                ]]></value>
            </property>
        </properties>
    </rule>

    <rule ref="category/java/documentation.xml/CommentContent">
        <properties>
            <property name="forbiddenRegex" value="\b(TODO|FIXME|HACK|XXX)\b"/>
        </properties>
    </rule>
</ruleset>
