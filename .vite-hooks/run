#!/bin/sh
# Starts every Git hook of this repository: `.vite-hooks/run <hook> <command...>`.
# core.hooksPath names this tracked directory, so each worktree runs its own hooks from its first
# checkout. A generated dispatcher exists only after an install, and Git silently runs no hook
# when the configured directory is missing. Without an install the hook refuses instead of skipping.
hook=$1
shift
if [ "${VP_GIT_HOOKS-}" = "0" ] || [ "${HUSKY-}" = "0" ] || [ "$(git config --type=bool vp.hooks.disabled 2>/dev/null)" = "true" ]; then
	exit 0
fi
root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
if [ ! -x "$root/node_modules/.bin/vp" ]; then
	echo "hooks: $root has no install, so its $hook checks cannot run." >&2
	echo "hooks: run 'pnpm install --frozen-lockfile' in this worktree and retry, or set VP_GIT_HOOKS=0 to skip the hooks once." >&2
	exit 1
fi
PATH="$root/node_modules/.bin:$PATH"
export PATH
exec "$@"
