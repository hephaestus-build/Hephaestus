{
	"include": ["**/*.ts", "**/*.tsx", ".storybook/**/*.ts", ".storybook/**/*.tsx"],
	// The Playwright tree runs on Node and carries its own `tsconfig.json`.
	"exclude": ["e2e"],
	"compilerOptions": {
		"target": "ES2022",
		"jsx": "react-jsx",
		"module": "ESNext",
		// Vite's default browser target decides the lib; `toSorted` and `Promise.withResolvers` are
		// past it, so a helper that needs one belongs to the test tree, which runs on Node.
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["vite/client"],
		/* Bundler mode */
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		/* Linting */
		"skipLibCheck": true,
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedSideEffectImports": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"noImplicitReturns": true,
		"allowUnreachableCode": false,
		"allowUnusedLabels": false,
		"paths": {
			"@/*": ["./src/*"]
		}
	}
}
