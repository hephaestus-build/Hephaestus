{
	"extends": "../tsconfig.json",
	"include": ["**/*.ts"],
	// Inherited as-is, the SPA's exclusion of this tree would leave the project with no inputs.
	"exclude": [],
	"compilerOptions": {
		// Playwright runs on Node, whose promise API is past the browser lib the SPA targets.
		"lib": ["ES2024", "DOM"],
		"types": ["node"]
	}
}
