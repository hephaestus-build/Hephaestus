{
	"extends": "../tsconfig.json",
	"include": ["**/*.ts"],
	// Inherited as-is, the SPA's exclusion of this tree would leave the project with no inputs.
	"exclude": [],
	"compilerOptions": {
		// Playwright runs on Node, whose promise API is past the browser lib the SPA targets. `DOM` is
		// there for the functions `page.evaluate` ships into the browser, which the accessibility spec
		// uses to read focus and layout; every other spec reaches the page through locators.
		"lib": ["ES2024", "DOM"],
		"types": ["node"]
	}
}
