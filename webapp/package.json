{
	"name": "webapp",
	"version": "0.0.0-development",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vp dev",
		"start": "vp dev",
		"build": "vp build && vp lint --type-aware --type-check .",
		"serve": "vp preview",
		"test": "vp test --run --exclude 'tools/oxlint/rules/**' --maxWorkers=4 && vp run test:lint-rules",
		"test:watch": "vp test --exclude 'tools/oxlint/rules/**' --maxWorkers=4",
		"test:coverage": "vp test --run --coverage --exclude 'tools/oxlint/rules/**' --maxWorkers=4",
		"test:lint-rules": "vp test --run tools/oxlint/rules --maxWorkers=1 --outputFile.junit=./test-results/junit-webapp-lint-rules.xml",
		"test:storybook": "vp test --run --config vitest.config.storybook.ts",
		"typecheck": "vp lint --type-aware --type-check .",
		"format": "cd .. && vp fmt --write 'webapp/**/*.{js,jsx,ts,tsx,json,jsonc,css}'",
		"format:check": "cd .. && vp fmt --check 'webapp/**/*.{js,jsx,ts,tsx,json,jsonc,css}'",
		"lint": "vp lint .",
		"lint:fix": "vp lint --fix .",
		"check": "vp check",
		"check:fix": "vp check --fix",
		"build-storybook": "vp exec storybook build --stats-json",
		"chromatic": "chromatic --exit-zero-on-changes",
		"chromatic:ci": "chromatic --only-changed",
		"chromatic:dry-run": "chromatic --dry-run",
		"test:e2e": "playwright test",
		"export:assets": "node scripts/export-assets.ts",
		"storybook:dev": "storybook dev -p 6006",
		"generate:api": "openapi-ts"
	},
	"dependencies": {
		"@ai-sdk/react": "4.0.96",
		"@base-ui/react": "1.8.0",
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/modifiers": "^9.0.0",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@monaco-editor/react": "^4.7.0",
		"@primer/octicons-react": "19.33.0",
		"@sentry/react": "10.73.0",
		"@shadcn/react": "0.3.1",
		"@tanstack/react-query": "5.102.8",
		"@tanstack/react-query-devtools": "5.102.8",
		"@tanstack/react-router": "1.170.32",
		"@tanstack/react-router-devtools": "1.167.1",
		"@tanstack/react-table": "9.2.4",
		"ai": "7.0.93",
		"class-variance-authority": "0.7.1",
		"cn": "0.2.6",
		"date-fns": "4.4.0",
		"fast-deep-equal": "3.1.3",
		"lucide-react": "1.41.0",
		"motion": "13.2.0",
		"react": "19.2.8",
		"react-day-picker": "10.0.1",
		"react-dom": "19.2.8",
		"sonner": "2.0.8",
		"spin-delay": "2.0.1",
		"streamdown": "2.6.0",
		"use-sync-external-store": "1.6.0",
		"usehooks-ts": "3.1.1",
		"uuid": "14.0.2",
		"zod": "4.5.4",
		"zustand": "5.0.15"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "5.3.1",
		"@fontsource-variable/inter": "5.3.0",
		"@gitlab/svgs": "3.164.0",
		"@hey-api/openapi-ts": "0.0.0-next-20260824173136",
		"@oxlint/plugins": "catalog:",
		"@playwright/test": "1.63.0",
		"@primer/primitives": "11.10.0",
		"@sentry/vite-plugin": "5.4.0",
		"@storybook/addon-a11y": "10.6.0",
		"@storybook/addon-docs": "10.6.0",
		"@storybook/addon-onboarding": "10.6.0",
		"@storybook/addon-themes": "10.6.0",
		"@storybook/addon-vitest": "10.6.0",
		"@storybook/react": "10.6.0",
		"@storybook/react-vite": "10.6.0",
		"@tailwindcss/typography": "0.5.20",
		"@tailwindcss/vite": "4.3.3",
		"@tanstack/router-plugin": "1.168.35",
		"@testing-library/dom": "10.4.1",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.7",
		"@types/hast": "3.0.5",
		"@types/node": "24.13.3",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.7",
		"@vitejs/plugin-react": "6.1.1",
		"@vitest/browser": "catalog:",
		"@vitest/browser-playwright": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"chromatic": "18.7.2",
		"jsdom": "30.0.1",
		"msw": "2.15.0",
		"msw-storybook-addon": "2.0.7",
		"oxc-transform-react": "0.145.0",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"playwright": "1.63.0",
		"storybook": "10.6.0",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "1.4.0",
		"typescript": "7.0.2",
		"vite": "8.2.2",
		"vite-plugin-terminal": "1.4.0",
		"vitest": "catalog:"
	},
	"msw": {
		"workerDirectory": [
			"public"
		]
	}
}
