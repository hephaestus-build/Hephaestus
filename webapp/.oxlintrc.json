{
	"$schema": "./node_modules/oxlint/configuration_schema.json",

	"extends": ["../oxlint.app.jsonc"],

	"jsPlugins": ["./tools/oxlint/index.ts", "@shadcn/lint"],

	// Kept in step with `tsconfig.json`'s `lib`.
	"env": { "browser": true, "es2022": true },
	"settings": {
		"react": { "version": "19.2" },
		"jsx-a11y": { "components": { "Label": "label", "FieldLabel": "label" } }
	},

	"ignorePatterns": [
		// Generated.
		"src/api",
		"src/routeTree.gen.ts",
		// Vendored by `msw init`.
		"public/mockServiceWorker.js",
		// Build output, and neither is in `.gitignore`, which oxlint would otherwise honour.
		"playwright-report",
		"coverage"
	],

	"rules": {
		// -- Design system ---------------------------------------------------------------------------
		// No `settings.shadcn`: `components.json` names the theme CSS and the registry path.
		// `shadcn/require-static-classes` stays off: it cannot resolve an imported vocabulary map or a
		// CVA result without duplicating their owners.
		"shadcn/no-unknown-classes": "error",
		"shadcn/no-raw-colors": "error",
		"shadcn/no-inline-styles": "error",
		// Allow-listed, so a value not named here is reported and each addition argues for itself.
		// `layout` keeps measured tracks, viewport maths and the sizes a library asks for; the rest are
		// formulas over theme variables, CSS keywords, transition property lists and the drawer's swipe
		// physics. A one-off elsewhere is a call-site suppression with its reason, and the registry's
		// own arbitrary sizes and radii snap to the nearest step of the scale.
		"shadcn/no-arbitrary-values": [
			"error",
			{
				"allow": [
					"layout",
					"transition-*",
					"rounded-[inherit]",
					"rounded-[min(var(--radius-md),10px)]",
					"rounded-[min(var(--radius-md),12px)]",
					"rounded-[calc(var(--radius)-3px)]",
					"rounded-[calc(var(--radius)-5px)]",
					"text-[length:inherit]",
					"opacity-[0.9999]",
					"opacity-[max(var(--drawer-overlay-min-opacity,0),calc(1-var(--drawer-swipe-progress)))]",
					"duration-[calc(var(--drawer-swipe-strength)*400ms)]"
				]
			}
		],
		"shadcn/no-restyle": [
			"error",
			{
				// A caller styles a component only where its role makes that property the caller's;
				// everywhere else it picks a variant. Each contract names that role, and restates
				// `layout` because a contract's `allow` replaces the global one.
				"allow": ["layout"],
				"contracts": [
					// Button: `size` owns the padding box and `shape` the radius scale, so `rounded` is
					// denied while squaring one corner to meet an edge stays composition. Tone comes from
					// vocabularies Button does not own (status tones, the provider palette, a placeholder
					// state), `size="inline"` takes its type from the prose around it, and a floating
					// button carries its own lift and transition because Button has no elevation axis.
					{
						"pattern": "^Button$",
						"allow": ["layout", "typography", "color", "shape", "effects", "motion"],
						"deny": ["rounded"]
					},
					// Badge: monospace is a content decision for an identifier, not a restyle.
					{ "pattern": "^Badge$", "allow": ["layout", "font-mono"] },
					// Card: elevation depends on where the card sits; `outline-none` is for a region focused
					// by script, which must not ring.
					{ "pattern": "^Card$", "allow": ["layout", "effects", "outline-none"] },
					// A box the caller fills: its padding and gap are the caller's.
					{
						"pattern": "^(AlertDescription|CardContent|CardHeader|CardFooter|DialogBody|DialogHeader|DrawerBody|DrawerHeader|FieldGroup|HoverCardContent|ItemActions|ItemContent|ItemGroup|PaginationContent|PopoverContent|QuestionnaireChoices|SidebarGroup|Tabs|TabsList|ToggleGroup)$",
						"allow": ["layout", "spacing"]
					},
					// A layout root — a grid, a flex column, a bare trigger — has nothing to restyle;
					// whatever is written on it is the caller composing.
					{
						"pattern": "^(Accordion|CollapsibleContent|CollapsibleTrigger|Field|FieldSet|RadioGroup)$",
						"allow": ["*"]
					},
					// A text slot: its type, tone, and the padding or gap around what it holds follow the
					// text around it.
					{
						"pattern": "^(AccordionContent|ButtonGroupText|CardTitle|DialogTitle|DrawerTitle|DropdownMenuLabel|FieldDescription|FieldLegend|ItemDescription|ItemTitle|Label|PopoverTitle|TableCell|TableHead)$",
						"allow": ["layout", "typography", "color", "spacing"]
					},
					// A label that wraps its control takes that control's surface, dimming and easing, and
					// its weight and tone from the field's place in the form.
					{
						"pattern": "^FieldLabel$",
						"allow": ["layout", "typography", "color", "spacing", "effects", "motion"]
					},
					// Renders the caller's content: what is inside is typeset and spaced by the caller.
					{
						"pattern": "^(ComboboxItem|DropdownMenuCheckboxItem|DropdownMenuItem|TabsTrigger|TooltipContent|TooltipTrigger)$",
						"allow": ["layout", "typography", "spacing"]
					},
					// The contract above, and a trigger disabled to pin an item open is not unavailable and
					// must not look it.
					{
						"pattern": "^AccordionTrigger$",
						"allow": ["layout", "typography", "spacing", "effects"]
					},
					// The contract above, plus the faceted-filter idiom: a dashed edge says the filter is not
					// yet set.
					{ "pattern": "^ComboboxTrigger$", "allow": ["layout", "typography", "border-dashed"] },
					// A row being dragged fades — the drag's state, not the component's — and its padding
					// and gap are the list's.
					{ "pattern": "^(AccordionItem|Item)$", "allow": ["layout", "spacing", "effects"] },
					// The leading icon's tone follows the row's meaning.
					{ "pattern": "^ItemMedia$", "allow": ["layout", "color"] },
					// A stand-in takes the shape, and for a toned badge the tint, of what it stands for.
					{ "pattern": "^Skeleton$", "allow": ["layout", "shape", "color"] },
					// An avatar's corner says what it depicts — round for a person, squared for a workspace —
					// and its ring, lift and the fallback's type and tone follow the surface it sits on.
					{
						"pattern": "^(Avatar|AvatarFallback)$",
						"allow": ["layout", "shape", "typography", "color", "effects"]
					},
					// A scroll region clips to the radius of what it sits in and pads what it scrolls.
					{ "pattern": "^ScrollArea$", "allow": ["layout", "spacing", "shape"] },
					// A meter's fill carries the meter's meaning — severity, league, level — in its tone,
					// gradient, shape and pace; the primitive draws it and does not decide it.
					{
						"pattern": "^(ProgressTrack|ProgressIndicator)$",
						"allow": ["layout", "color", "shape", "motion", "effects"]
					},
					// A spinner inherits `currentColor`; where it sits decides its tone.
					{ "pattern": "^Spinner$", "allow": ["layout", "color"] },
					// A swatch is painted by the group-colour vocabulary; the cell itself is a variant.
					{ "pattern": "^ToggleGroupItem$", "allow": ["layout", "color"] }
				]
			}
		],

		// -- Where this tree decides a base rule differently -----------------------------------------
		// Both want `toSorted`/`toReversed`, past `tsconfig.json`'s `lib` (it says why). Copy before
		// sorting an array a caller can observe — that mutation is the bug these describe.
		"unicorn/no-array-sort": "off",
		"unicorn/no-array-reverse": "off",
		// The `??=` and `||=` these two propose are ones the React Compiler does not lower
		// (`react/todo` names them), and a ref initialiser is exactly where that `if` sits. Where a
		// blank string should fall through, the question is asked by name (`hasText` /
		// `firstNonBlank` in `@/lib/text`), so `ignorePrimitives` stays off.
		"typescript/prefer-nullish-coalescing": ["error", { "ignoreIfStatements": true }],
		"logical-assignment-operators": "off",
		// Reads `.catch` by name, so zod's `.catch(undefined)` on every search-param schema is reported
		// as a promise chain.
		"promise/prefer-await-to-then": "off",
		// Cyclomatic complexity counts every `&&`, `??` and `?.` in JSX, so at the default 20 it grades
		// how many optional props a page has. Forty is the line between that and a function doing
		// several components' work.
		"complexity": ["error", { "max": 40 }],
		// `webapp/AGENTS.md` § File naming: a file that exports a component is PascalCase.
		"unicorn/filename-case": ["error", { "cases": { "kebabCase": true, "pascalCase": true } }],
		// TanStack Router signals redirects and 404s by throwing them; everything else must be an Error.
		"typescript/only-throw-error": [
			"error",
			{
				"allow": [
					{ "from": "package", "package": "@tanstack/router-core", "name": "Redirect" },
					{ "from": "package", "package": "@tanstack/router-core", "name": "NotFoundError" }
				]
			}
		],

		// -- What only this tree has -----------------------------------------------------------------
		// CSS side effects and module augmentation.
		"import/no-unassigned-import": [
			"error",
			{ "allow": ["**/*.css", "@tanstack/react-router", "react"] }
		],
		// This kit is Base UI, not Radix: a slot is passed as an element through `render=`.
		"react/forbid-component-props": [
			"error",
			{ "forbid": [{ "propName": "asChild", "message": "Base UI slots through `render={<X/>}`." }] }
		],
		// Maps a role to a tag without asking whether the tag's other semantics fit — `<output>` for
		// `status` carries a form association, `<li>` for `listitem` is only valid inside a list,
		// `<fieldset>` for `group` is a form control group, `<img>` cannot replace an inline SVG — and
		// half of what it reports is vendored registry markup.
		"jsx-a11y/prefer-tag-over-role": "off",
		// Base UI passes the control through `render=` and keeps the label in the wrapper's children,
		// where no jsx-a11y rule can see it. It also does not model `<datalist>`, where a valueless
		// `<option>` is the correct spelling. Expect this from any rule that inspects children.
		"jsx-a11y/control-has-associated-label": "off",
		// Same shape, plus `renderPageLink`: the `<a>`'s content comes from whoever renders it.
		"jsx-a11y/anchor-has-content": "off",
		// Flags `const Icon = iconFor(kind)`, where the helper returns one of a fixed set of
		// module-level icons. `react/no-unstable-nested-components` still catches a component defined
		// inside another's body.
		"react/static-components": "off",

		// -- House rules, defined in `tools/oxlint/` --------------------------------------------------
		// Each states in its own `meta.docs.description` what it asks.
		"hephaestus/no-manual-query-key": "error"
		// The rules that read a Storybook story object are scoped to story files in `overrides`.
	},

	// Never configure one rule for the same file from two entries: where two overrides match a file,
	// the later one's copy of a rule REPLACES the earlier one's options instead of merging with them.
	// Entries whose globs overlap but set different rules are fine, and there are several below.
	"overrides": [
		{
			// Vocabulary maps are consumed indirectly, beyond the plugin's one-hop analysis.
			// Scanning all strings everywhere misreads element ids such as "outline-token" as CSS.
			"files": [
				"src/lib/**",
				"src/components/layout/Header.tsx",
				"src/components/site/landing/LandingVisuals.tsx"
			],
			"rules": { "shadcn/no-raw-colors": ["error", { "scanAllStrings": true }] }
		},
		{
			// `@/` maps to `src/`, so nothing here can spell a sibling any other way. This is a
			// self-contained tool, not part of the app tree.
			"files": ["tools/**"],
			"rules": { "import/no-relative-parent-imports": "off" }
		},
		{
			"files": ["src/lib/**", "src/stores/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"paths": [
							{
								"name": "react",
								"importNames": ["useMemo", "useCallback", "memo", "forwardRef"],
								"allowTypeImports": true,
								"message": "React Compiler memoises at build time; `ref` is a plain prop in React 19."
							}
						],
						"patterns": [
							{
								"group": ["@/components/**"],
								"message": "Logic and state must not reach into the view layer."
							},
							{
								"group": ["@/routes/**"],
								"message": "Logic and state must not reach into the router."
							}
						]
					}
				]
			}
		},
		{
			"files": ["src/components/ui/**"],
			"rules": {
				// A registry file styles the primitives it composes; the contract is with callers outside it.
				"shadcn/no-restyle": "off",
				"no-restricted-imports": [
					"error",
					{
						"paths": [
							{
								"name": "react",
								"importNames": ["useMemo", "useCallback", "memo", "forwardRef"],
								"allowTypeImports": true,
								"message": "React Compiler memoises at build time; `ref` is a plain prop in React 19."
							}
						],
						"patterns": [
							{
								"group": ["@/routes/**"],
								"message": "A UI primitive cannot depend on a route. Take what it needs as a prop."
							},
							{
								"group": ["@/components/**", "!@/components/ui/**"],
								"message": "A UI primitive cannot depend on a feature component; the dependency runs the other way."
							}
						]
					}
				]
			}
		},
		{
			// A UI primitive gets the stricter entry above instead; `excludeFiles` keeps the two apart.
			"files": ["src/components/**"],
			"excludeFiles": ["src/components/ui/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"paths": [
							{
								"name": "react",
								"importNames": ["useMemo", "useCallback", "memo", "forwardRef"],
								"allowTypeImports": true,
								"message": "React Compiler memoises at build time; `ref` is a plain prop in React 19."
							}
						],
						"patterns": [
							{
								"group": ["@/routes/**"],
								"message": "A component cannot import a route; routes compose components."
							}
						]
					}
				]
			}
		},
		{
			// SPA source only. E2E and build tooling may use globals that do not belong in a bundled module.
			"files": ["src/**"],
			"rules": {
				// `AGENTS.md` § Data fetching: server data is the generated client plus TanStack Query, which
				// is also what attaches the CSRF header (`applyStateChangingHeaders`). A bare request skips
				// the header, the cache and the shared error handling at once.
				"no-restricted-globals": [
					"error",
					{
						"name": "fetch",
						"message": "Server data goes through the generated client and TanStack Query."
					},
					{
						"name": "XMLHttpRequest",
						"message": "Server data goes through the generated client and TanStack Query."
					}
				],
				// Vite substitutes `import.meta.env`, never `process.env`, and an unsubstituted
				// `process.env.X` is not a build error — it reads as `undefined` in the browser, so the
				// failure surfaces wherever the value was needed rather than here. The two legitimate
				// sources are separate: `import.meta.env` carries the build-time mode flags (`DEV`), while
				// runtime configuration reaches the bundle through `window.__ENV__`, wrapped by
				// `@/environment` and filled in by the container entrypoint.
				"no-restricted-properties": [
					"error",
					{
						"object": "process",
						"property": "env",
						"message": "Not substituted in the browser bundle. Build mode is `import.meta.env`; runtime configuration is `@/environment`."
					},
					{
						"object": "Date",
						"property": "now",
						"message": "Component code takes the time from `use-now`, a story from `story-clock`; scheduling and persistence read it directly and say so in a suppression."
					}
				]
			}
		},
		{
			// TanStack Router derives URL segments from these filenames and owns their naming.
			"files": ["src/routes/**"],
			"rules": { "unicorn/filename-case": "off" }
		},
		{
			// A test that asserts a `javascript:` URL is rejected has to name one. And jest-dom is not
			// registered in the Vitest project (`vite.config.ts` sets up `setup-msw.ts` alone), so its
			// matchers throw `Invalid Chai property` at runtime with `tsc` perfectly happy.
			"files": ["**/*.test.ts", "**/*.test.tsx"],
			"rules": {
				"no-script-url": "off",
				"vitest/no-restricted-matchers": [
					"error",
					{
						"toBeInTheDocument": "Not registered here. Use `expect(el).not.toBeNull()`, or `queryBy*` with `toBeNull()` for absence.",
						"toHaveAttribute": "Not registered here. Read the attribute and assert on it.",
						"toBeDisabled": "Not registered here. Query with the element type and read `.disabled`.",
						"toBeVisible": "Not registered here. Assert on the value you mean.",
						"toHaveTextContent": "Not registered here. Assert on `el.textContent`.",
						"toHaveClass": "Not registered here. Assert on `el.className`."
					}
				]
			}
		},
		{
			// Playwright names its fixture callback `use`, which the React plugin reads as the hook.
			"files": ["e2e/**"],
			"rules": { "react-hooks/rules-of-hooks": "off" }
		}
	]
}
