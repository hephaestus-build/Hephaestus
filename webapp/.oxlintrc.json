{
	"$schema": "./node_modules/oxlint/configuration_schema.json",

	"plugins": ["typescript", "unicorn", "oxc", "import", "react", "jsx-a11y", "vitest", "promise"],
	"jsPlugins": ["./tools/oxlint/index.ts"],

	// No `warn` tier: oxlint exits 0 on warnings unless `--deny-warnings` is passed.
	"categories": {
		"correctness": "error",
		"suspicious": "error",
		// React Compiler runs at build time and this repo bans hand-written `useMemo`/`useCallback`
		// (`AGENTS.md`), so `perf` — and the `react-perf` plugin, left out of `plugins` — asks for the
		// memoisation the compiler exists to remove.
		"perf": "off",
		"pedantic": "off",
		"style": "off",
		"restriction": "off"
	},

	// Kept in step with `tsconfig.json`'s `lib`.
	"env": { "browser": true, "es2022": true },
	"settings": {
		"react": { "version": "19.2" },
		"jsx-a11y": { "components": { "Label": "label", "FieldLabel": "label" } }
	},

	"ignorePatterns": [
		// Generated.
		"src/api",
		"src/routeTree.gen.ts",
		// Vendored by `msw init`.
		"public/mockServiceWorker.js",
		// Build output, and neither is in `.gitignore`, which oxlint would otherwise honour.
		"playwright-report",
		"coverage"
	],

	"rules": {
		// -- On, despite their category being off ---------------------------------------------------
		"no-else-return": "error",
		"prefer-const": "error",
		"prefer-template": "error",
		"operator-assignment": "error",
		"typescript/prefer-for-of": "error",
		"typescript/no-explicit-any": "error",
		"typescript/require-await": "error",
		// `no-explicit-any` catches the `any` this repo writes; the `no-unsafe-*` rules catch the `any`
		// that arrives — from a library, from `JSON.parse`, from an untyped `vi.fn()`.
		"typescript/no-unsafe-call": "error",
		"typescript/no-unsafe-assignment": "error",
		"typescript/no-unsafe-argument": "error",
		"typescript/no-unsafe-return": "error",
		"typescript/no-unsafe-member-access": "error",
		// Without it, `!` is an unchecked way to make the claim `no-unsafe-type-assertion` rejects.
		"typescript/no-non-null-assertion": "error",
		// `FC` annotates the binding rather than the props, so it only reaches an arrow assigned to a
		// `const`; its call signature returns `ReactNode | Promise<ReactNode>`, so an accidentally
		// `async` component type-checks; and it has nowhere to bind a type parameter, so a generic
		// component cannot be spelled with it at all.
		"typescript/no-restricted-types": [
			"error",
			{
				"types": {
					"FC": "Annotate the props parameter instead: `function Thing({ a }: ThingProps)`.",
					"React.FC": "Annotate the props parameter instead: `function Thing({ a }: ThingProps)`.",
					"FunctionComponent": "Annotate the props parameter instead.",
					"React.FunctionComponent": "Annotate the props parameter instead."
				}
			}
		],
		// This kit is Base UI, not Radix: a slot is passed as an element through `render=`.
		"react/forbid-component-props": [
			"error",
			{ "forbid": [{ "propName": "asChild", "message": "Base UI slots through `render={<X/>}`." }] }
		],
		"unicorn/prefer-node-protocol": "error",
		// `import.meta.dirname` and `import.meta.filename` are the spelling of what
		// `dirname(fileURLToPath(import.meta.url))` builds by hand, and they need no imports.
		"unicorn/prefer-import-meta-properties": "error",
		"oxc/no-accumulating-spread": "error",
		"react/no-danger": "error",
		// `null == x` is the idiomatic "null or undefined" check and stays allowed.
		"eqeqeq": ["error", "always", { "null": "ignore" }],
		"unicorn/no-abusive-eslint-disable": "error",

		// -- Taken by name out of `pedantic` and `perf` ----------------------------------------------
		"react/rules-of-hooks": "error",
		"react/jsx-no-target-blank": "error",
		"react/display-name": "error",
		"react/checked-requires-onchange-or-readonly": "error",
		"react/no-deriving-state-in-effects": "error",
		"no-fallthrough": "error",
		"no-case-declarations": "error",
		"no-inner-declarations": "error",
		"no-prototype-builtins": "error",
		"no-self-compare": "error",
		"no-shadow": "error",
		"no-throw-literal": "error",
		"no-constructor-return": "error",
		"no-promise-executor-return": "error",
		"no-loop-func": "error",
		"no-new-wrappers": "error",
		"no-object-constructor": "error",
		"no-array-constructor": "error",
		"no-useless-call": "error",
		"prefer-promise-reject-errors": "error",
		"array-callback-return": "error",
		"accessor-pairs": "error",
		"radix": "error",
		"symbol-description": "error",
		"typescript/no-unsafe-function-type": "error",
		"typescript/prefer-enum-initializers": "error",
		"typescript/no-mixed-enums": "error",
		"unicorn/new-for-builtins": "error",
		"unicorn/no-instanceof-array": "error",
		"unicorn/no-immediate-mutation": "error",
		"unicorn/no-this-assignment": "error",
		"unicorn/no-static-only-class": "error",
		"unicorn/no-unreadable-iife": "error",
		"unicorn/no-negation-in-equality-check": "error",
		"unicorn/no-useless-promise-resolve-reject": "error",
		"unicorn/no-unnecessary-array-flat-depth": "error",
		"unicorn/no-unnecessary-array-splice-count": "error",
		"unicorn/no-unnecessary-slice-end": "error",
		"unicorn/consistent-assert": "error",
		"unicorn/consistent-empty-array-spread": "error",
		"unicorn/prefer-array-find": "error",
		"unicorn/prefer-array-flat": "error",
		"unicorn/prefer-array-flat-map": "error",
		"unicorn/prefer-array-some": "error",
		"unicorn/prefer-date-now": "error",
		"unicorn/prefer-dom-node-remove": "error",
		"unicorn/prefer-math-min-max": "error",
		"unicorn/prefer-prototype-methods": "error",
		"unicorn/prefer-regexp-test": "error",
		"unicorn/prefer-single-call": "error",
		"unicorn/prefer-blob-reading-methods": "error",
		"unicorn/require-number-to-fixed-digits-argument": "error",

		// -- Taken by name out of `restriction` ------------------------------------------------------
		"no-proto": "error",
		"no-script-url": "error",
		"no-var": "error",
		"no-empty": "error",
		"typescript/no-namespace": "error",
		"typescript/ban-ts-comment": "error",
		"jsx-a11y/anchor-ambiguous-text": "error",
		"unicorn/prefer-number-properties": "error",
		"unicorn/prefer-array-index-of": "error",
		"react/no-unknown-property": "error",
		"no-alert": "error",
		"no-sequences": "error",
		"no-implicit-globals": "error",
		"no-regex-spaces": "error",
		"no-div-regex": "error",
		"unicode-bom": "error",
		"typescript/no-require-imports": "error",
		"typescript/no-var-requires": "error",
		"typescript/no-empty-object-type": "error",
		"typescript/no-import-type-side-effects": "error",
		"typescript/no-non-null-asserted-nullish-coalescing": "error",
		"typescript/prefer-literal-enum-member": "error",
		"react/no-clone-element": "error",
		"react/no-react-children": "error",
		"react/prefer-function-component": "error",
		"import/no-commonjs": "error",
		"import/no-amd": "error",
		"import/no-dynamic-require": "error",
		"import/no-webpack-loader-syntax": "error",
		"unicorn/no-anonymous-default-export": "error",
		"unicorn/no-process-exit": "error",
		"unicorn/no-length-as-slice-end": "error",
		"unicorn/no-magic-array-flat-depth": "error",
		"unicorn/no-useless-error-capture-stack-trace": "error",
		"oxc/no-const-enum": "error",
		"oxc/bad-bitwise-operator": "error",
		"promise/catch-or-return": "error",
		// -- Taken by name out of `style`, which is not adoptable whole: it holds `sort-keys` and both
		// `no-named-export` and `prefer-default-export` -----------------------------------------------
		"no-template-curly-in-string": "error",
		"no-new-func": "error",
		"no-return-assign": "error",
		"no-multi-assign": "error",
		"no-lone-blocks": "error",
		"no-labels": "error",
		"no-label-var": "error",
		"no-extra-label": "error",
		"no-multi-str": "error",
		"no-useless-computed-key": "error",
		"no-lonely-if": "error",
		"default-case-last": "error",
		"default-param-last": "error",
		"grouped-accessor-pairs": "error",
		"func-name-matching": "error",
		"prefer-regex-literals": "error",
		"prefer-object-has-own": "error",
		"prefer-object-spread": "error",
		"prefer-spread": "error",
		"prefer-rest-params": "error",
		"prefer-numeric-literals": "error",
		"prefer-exponentiation-operator": "error",
		"prefer-arrow-callback": "error",
		// `@/` is the house spelling, and a `../` survives moving the file only by accident.
		"import/no-relative-parent-imports": "error",
		// `import/no-duplicates` accepts a type-only import standing beside a value import from the same
		// module; `no-duplicate-imports` does not, and one import list per module is the point.
		"import/no-duplicates": "error",
		"no-duplicate-imports": "error",
		"import/no-mutable-exports": "error",
		"import/no-named-default": "error",
		"import/no-anonymous-default-export": "error",
		"promise/no-nesting": "error",
		"promise/no-return-wrap": "error",
		"promise/prefer-catch": "error",
		"react/jsx-pascal-case": "error",
		"react/self-closing-comp": "error",
		"react/jsx-fragments": "error",
		"typescript/adjacent-overload-signatures": "error",
		"typescript/ban-tslint-comment": "error",
		"typescript/no-empty-interface": "error",
		"typescript/no-inferrable-types": "error",
		"typescript/no-unnecessary-qualifier": "error",
		"typescript/prefer-function-type": "error",
		"typescript/unified-signatures": "error",
		"typescript/consistent-type-assertions": "error",
		"import/export": "error",
		"import/named": "error",
		"no-unreachable-loop": "error",
		"promise/no-return-in-finally": "error",
		"promise/spec-only": "error",
		"typescript/no-invalid-void-type": "error",
		"typescript/prefer-find": "error",
		"typescript/consistent-type-exports": "error",
		"typescript/related-getter-setter-pairs": "error",
		"typescript/prefer-reduce-type-parameter": "error",
		"typescript/prefer-return-this-type": "error",
		"typescript/restrict-plus-operands": "error",
		"typescript/prefer-readonly": "error",
		// `strictFunctionTypes` only checks property syntax; a method shorthand stays bivariant, so
		// `handler(e: MouseEvent): void` accepts a handler that will be called with something else.
		"typescript/method-signature-style": "error",
		"typescript/prefer-ts-expect-error": "error",
		"unicorn/no-useless-switch-case": "error",
		"unicorn/no-useless-iterator-to-array": "error",
		"unicorn/prefer-event-target": "error",
		"unicorn/prefer-type-error": "error",
		"unicorn/prefer-classlist-toggle": "error",
		"unicorn/prefer-reflect-apply": "error",
		"unicorn/prefer-response-static-json": "error",
		"unicorn/prefer-bigint-literals": "error",
		"unicorn/require-module-attributes": "error",
		"oxc/no-barrel-file": "error",
		"react/no-set-state": "error",
		"react/prefer-es6-class": "error",
		"react/require-render-return": "error",
		"react/state-in-constructor": "error",
		"react/no-redundant-should-component-update": "error",
		"vitest/prefer-called-exactly-once-with": "error",
		"vitest/prefer-to-be-object": "error",
		"vitest/prefer-to-have-been-called-times": "error",
		"vitest/no-large-snapshots": "error",

		"typescript/no-misused-promises": "error",
		"typescript/no-deprecated": "error",
		"typescript/no-misused-spread": "error",
		// Where a blank string should fall through, the question is asked by name (`hasText` /
		// `firstNonBlank` in `@/lib/text`), so `ignorePrimitives` stays off.
		"typescript/prefer-nullish-coalescing": "error",
		"typescript/require-array-sort-compare": "error",
		"typescript/prefer-promise-reject-errors": "error",
		"typescript/no-meaningless-void-operator": "error",
		"typescript/no-unnecessary-template-expression": "error",
		// Truthful only with `noUncheckedIndexedAccess` (`tsconfig.json`), which is what makes an array
		// index nullable. A finding is as often a type claiming more than the wire delivers — fix the
		// type, keep the guard — as it is a dead branch.
		"typescript/no-unnecessary-condition": "error",
		"typescript/switch-exhaustiveness-check": [
			"error",
			{ "considerDefaultExhaustiveForUnions": true }
		],
		// TanStack Router signals redirects and 404s by throwing them; everything else must be an Error.
		"typescript/only-throw-error": [
			"error",
			{
				"allow": [
					{ "from": "package", "package": "@tanstack/router-core", "name": "Redirect" },
					{ "from": "package", "package": "@tanstack/router-core", "name": "NotFoundError" }
				]
			}
		],
		"unicorn/error-message": "error",
		"unicorn/throw-new-error": "error",
		"unicorn/no-array-method-this-argument": "error",
		"unicorn/no-unreadable-array-destructuring": "error",
		"unicorn/consistent-date-clone": "error",
		"unicorn/prefer-keyboard-event-key": "error",
		"unicorn/require-array-join-separator": "error",
		"unicorn/no-useless-collection-argument": "error",
		"unicorn/explicit-timer-delay": "error",
		"unicorn/prefer-structured-clone": "error",
		"unicorn/prefer-dom-node-text-content": "error",
		"unicorn/prefer-modern-dom-apis": "error",
		"unicorn/switch-case-break-position": "error",
		"unicorn/prefer-object-from-entries": "error",
		"unicorn/prefer-includes": "error",
		"unicorn/prefer-logical-operator-over-ternary": "error",
		"unicorn/prefer-string-trim-start-end": "error",
		"unicorn/consistent-template-literal-escape": "error",
		"unicorn/text-encoding-identifier-case": "error",
		"vitest/no-identical-title": "error",
		"vitest/no-duplicate-hooks": "error",
		"vitest/no-alias-methods": "error",
		"vitest/no-test-prefixes": "error",
		"vitest/no-test-return-statement": "error",
		"vitest/no-import-node-test": "error",
		"vitest/no-mocks-import": "error",
		"vitest/no-interpolation-in-snapshots": "error",
		"vitest/no-unneeded-async-expect-function": "error",
		"vitest/prefer-each": "error",
		"vitest/prefer-todo": "error",
		"vitest/prefer-hooks-on-top": "error",
		"vitest/prefer-hooks-in-order": "error",
		"vitest/prefer-comparison-matcher": "error",
		"vitest/prefer-equality-matcher": "error",
		"vitest/prefer-to-be": "error",
		"vitest/prefer-to-contain": "error",
		"vitest/prefer-to-have-length": "error",
		"vitest/prefer-mock-promise-shorthand": "error",
		"vitest/prefer-mock-return-shorthand": "error",
		"vitest/consistent-vitest-vi": "error",
		"vitest/prefer-strict-equal": "error",
		"vitest/prefer-strict-boolean-matchers": "error",
		// Reaches `&&`, `||`, `??` and `?.` in a test body too: `getAttribute("href") ?? ""` turns a
		// missing attribute into an empty string the assertion then accepts. Setup that really does
		// branch belongs in the mock handler, not the test body.
		"vitest/no-conditional-in-test": "error",

		// -- Off -------------------------------------------------------------------------------------
		// React 19's automatic JSX runtime.
		"react/react-in-jsx-scope": "off",
		// Every effect it reports here lists a value it deliberately does not read — a ref reset keyed on
		// the location, focus keyed on the wizard step — which reads to the rule as an extra dependency.
		// Dropping one changes when the effect fires, which is the reason it is listed.
		"react/exhaustive-effect-dependencies": "off",
		// It maps a role to a tag without asking whether that tag's other semantics fit: `<output>` for
		// `role="status"` carries a form association a live region does not, `<li>` for `role="listitem"`
		// is only valid inside a list, and `<img>` for `role="img"` would replace the inline SVG that role
		// exists to name. Every role it reports here fails the same way.
		"jsx-a11y/prefer-tag-over-role": "off",
		// Base UI passes the control through `render=` and keeps the label in the wrapper's children,
		// where no jsx-a11y rule can see it. It also does not model `<datalist>`, where a valueless
		// `<option>` is the correct spelling. Expect this from any rule that inspects children.
		"jsx-a11y/control-has-associated-label": "off",
		// Same shape, plus `renderPageLink`: the `<a>`'s content comes from whoever renders it.
		"jsx-a11y/anchor-has-content": "off",
		// Both want ES2023 `toSorted`/`toReversed`, which this package's `tsconfig.json` does not declare
		// — its `lib` is `ES2022`. (The Node trees are on `ES2023`, so this reason does not travel to the
		// root config.) Copy before sorting an array a caller can observe — that mutation is the bug they
		// describe.
		"unicorn/no-array-sort": "off",
		"unicorn/no-array-reverse": "off",
		// Its two shapes here are both things TypeScript has already settled: an effect that bails early
		// and otherwise returns a cleanup, which is React's idiom, and an annotated `switch` that returns
		// from every arm of a union. TS2366 is what catches a return that is genuinely missing, and it
		// stays silent on an exhaustive switch — so every report here is one TypeScript declined to make.
		"typescript/consistent-return": "off",
		// `toHaveBeenCalledWith` is not type-narrowed by this Vitest/TS setup — a wrong argument against
		// `vi.fn<(open: boolean) => void>()` type-checks clean — so the parameter buys nothing.
		"vitest/require-mock-type-parameters": "off",
		// Flags `const Icon = iconFor(kind)`, where the helper returns one of a fixed set of
		// module-level icons. `react/no-unstable-nested-components` still catches a component defined
		// inside another's body.
		"react/static-components": "off",
		// The diagnostic names the helper but points at the *enclosing* function, so the line it sends you
		// to is a component or a `describe` that is not the thing to change. What it finds is a helper
		// deliberately scoped to the block that owns it; hoisting one widens what it is visible to and
		// buys nothing.
		"unicorn/consistent-function-scoping": "off",
		// Server field names (`_id`), test hooks (`__resetSessionRecoveryForTests`), the runtime config
		// global (`__ENV__`), exhaustiveness bindings (`_exhaustive`) and XSS sentinels a test has to name.
		"no-underscore-dangle": "off",

		// -- Options ---------------------------------------------------------------------------------
		// Every `autoFocus` here is spelled on a component — `<Input>`, `<Textarea>`, `<Calendar>` — so
		// `ignoreNonDOM: true` would make the rule blind to all of them. Each already carries a
		// suppression stating why, and `reportUnusedDisableDirectives` would then fail every one.
		"jsx-a11y/no-autofocus": ["error", { "ignoreNonDOM": false }],
		// TanStack Table column defs are `cell: ({ row }) => <Badge …/>` — a component passed as a prop.
		"react/no-unstable-nested-components": ["error", { "allowAsProps": true }],
		// `void somePromise.then(sideEffect)` is fire-and-forget; only a chain's interior needs a return.
		"promise/always-return": ["error", { "ignoreLastCallback": true }],
		// Vitest's `expect(actual, message)` takes a second argument, which the default of 1 rejects. A
		// literal message is tolerated even at 1, so this is load-bearing only where the label is
		// computed — which is every assertion inside a loop, the shape that needs a label most.
		"vitest/valid-expect": ["error", { "maxArgs": 2 }],
		// CSS side effects and module augmentation.
		"import/no-unassigned-import": [
			"error",
			{ "allow": ["**/*.css", "@tanstack/react-router", "react"] }
		],
		// A Testing Library query IS the assertion: `getBy*` throws when it finds nothing. Supplying
		// this option replaces oxlint's defaults rather than extending them, so the first four restate
		// its list — drop one and a plain `expect()` stops counting.
		"vitest/expect-expect": [
			"error",
			{
				"assertFunctionNames": [
					"expect",
					"expectTypeOf",
					"assert",
					"assertType",
					"getBy*",
					"**.getBy*",
					"getAllBy*",
					"**.getAllBy*",
					"findBy*",
					"**.findBy*",
					"findAllBy*",
					"**.findAllBy*"
				]
			}
		],
		"no-console": "error",
		// A circular import leaves one side reading `undefined` at module-init time, and which side
		// depends on entry order.
		"import/no-cycle": "error",
		// `AGENTS.md` § Testing states the query priority. A `data-testid` skips straight past it, and
		// the accessible name it stands in for is the thing a screen reader needs anyway.
		"react/forbid-dom-props": ["error", { "forbid": ["data-testid"] }],
		// Import `cn()` directly from `cn`; see `AGENTS.md` § Styling. Do not restore the
		// previous class-composition dependencies. Every override that sets `no-restricted-imports`
		// restates these restrictions because options replace rather than merge.
		"no-restricted-imports": [
			"error",
			{
				"paths": [
					{
						"name": "react",
						"importNames": ["useMemo", "useCallback", "memo", "forwardRef"],
						"allowTypeImports": true,
						"message": "React Compiler memoises at build time; `ref` is a plain prop in React 19."
					},
					{ "name": "clsx", "message": "Compose classes with `cn()` from `cn`." },
					{ "name": "tailwind-merge", "message": "Compose classes with `cn()` from `cn`." }
				]
			}
		],
		// `varsIgnorePattern` buys less than it looks: tsc's `noUnusedLocals` (`tsconfig.json`) still
		// fails an unused `_local`. Only the parameter and caught-error escapes hold on both sides.
		"no-unused-vars": [
			"error",
			{
				"argsIgnorePattern": "^_",
				"varsIgnorePattern": "^_",
				"caughtErrorsIgnorePattern": "^_"
			}
		],

		// -- House rules, defined in `tools/oxlint/` --------------------------------------------------
		// Each states in its own `meta.docs.description` what it asks and why no shipped rule does.
		"hephaestus/no-manual-query-key": "error",
		"hephaestus/no-non-ascii-filename": "error",
		"hephaestus/no-nondeterministic-render": "error",
		"hephaestus/no-redundant-in-the-document": "error",
		"hephaestus/svg-needs-accessible-name": "error"
		// The other four read a Storybook story object and are scoped to story files in `overrides`.
	},

	// Never configure one rule for the same file from two entries: where two overrides match a file,
	// the later one's copy of a rule REPLACES the earlier one's options instead of merging with them.
	// Entries whose globs overlap but set different rules are fine, and there are several below.
	"overrides": [
		{
			// `@/` maps to `src/`, so nothing here can spell a sibling any other way. This is a
			// self-contained tool, not part of the app tree.
			"files": ["tools/**"],
			"rules": { "import/no-relative-parent-imports": "off" }
		},
		{
			"files": ["src/lib/**", "src/stores/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"paths": [
							{
								"name": "react",
								"importNames": ["useMemo", "useCallback", "memo", "forwardRef"],
								"allowTypeImports": true,
								"message": "React Compiler memoises at build time; `ref` is a plain prop in React 19."
							},
							{ "name": "clsx", "message": "Compose classes with `cn()` from `cn`." },
							{
								"name": "tailwind-merge",
								"message": "Compose classes with `cn()` from `cn`."
							}
						],
						"patterns": [
							{
								"group": ["@/components/**"],
								"message": "Logic and state must not reach into the view layer."
							},
							{
								"group": ["@/routes/**"],
								"message": "Logic and state must not reach into the router."
							}
						]
					}
				]
			}
		},
		{
			"files": ["src/components/ui/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"paths": [
							{
								"name": "react",
								"importNames": ["useMemo", "useCallback", "memo", "forwardRef"],
								"allowTypeImports": true,
								"message": "React Compiler memoises at build time; `ref` is a plain prop in React 19."
							},
							{ "name": "clsx", "message": "Compose classes with `cn()` from `cn`." },
							{
								"name": "tailwind-merge",
								"message": "Compose classes with `cn()` from `cn`."
							}
						],
						"patterns": [
							{
								"group": ["@/routes/**"],
								"message": "A UI primitive cannot depend on a route. Take what it needs as a prop."
							},
							{
								"group": ["@/components/**", "!@/components/ui/**"],
								"message": "A UI primitive cannot depend on a feature component; the dependency runs the other way."
							}
						]
					}
				]
			}
		},
		{
			// A UI primitive gets the stricter entry above instead; `excludeFiles` keeps the two apart.
			"files": ["src/components/**"],
			"excludeFiles": ["src/components/ui/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"paths": [
							{
								"name": "react",
								"importNames": ["useMemo", "useCallback", "memo", "forwardRef"],
								"allowTypeImports": true,
								"message": "React Compiler memoises at build time; `ref` is a plain prop in React 19."
							},
							{ "name": "clsx", "message": "Compose classes with `cn()` from `cn`." },
							{
								"name": "tailwind-merge",
								"message": "Compose classes with `cn()` from `cn`."
							}
						],
						"patterns": [
							{
								"group": ["@/routes/**"],
								"message": "A component cannot import a route; routes compose components."
							}
						]
					}
				]
			}
		},
		{
			// SPA source only. E2E and build tooling may use globals that do not belong in a bundled module.
			"files": ["src/**"],
			"rules": {
				// `AGENTS.md` § Data fetching: server data is the generated client plus TanStack Query, which
				// is also what attaches the CSRF header (`applyStateChangingHeaders`). A bare request skips
				// the header, the cache and the shared error handling at once.
				"no-restricted-globals": [
					"error",
					{
						"name": "fetch",
						"message": "Server data goes through the generated client and TanStack Query."
					},
					{
						"name": "XMLHttpRequest",
						"message": "Server data goes through the generated client and TanStack Query."
					}
				],
				// Vite substitutes `import.meta.env`, never `process.env`, and an unsubstituted
				// `process.env.X` is not a build error — it reads as `undefined` in the browser, so the
				// failure surfaces wherever the value was needed rather than here. The two legitimate
				// sources are separate: `import.meta.env` carries the build-time mode flags (`DEV`), while
				// runtime configuration reaches the bundle through `window.__ENV__`, wrapped by
				// `@/environment` and filled in by the container entrypoint.
				"no-restricted-properties": [
					"error",
					{
						"object": "process",
						"property": "env",
						"message": "Not substituted in the browser bundle. Build mode is `import.meta.env`; runtime configuration is `@/environment`."
					},
					{
						"object": "Date",
						"property": "now",
						"message": "Component code takes the time from `use-now`, a story from `story-clock`; scheduling and persistence read it directly and say so in a suppression."
					}
				]
			}
		},
		{
			// The directories this repo writes by hand; `AGENTS.md` § File naming is the rule itself.
			"files": ["src/components/**", "src/lib/**", "src/hooks/**", "src/integrations/**"],
			"rules": {
				"unicorn/filename-case": ["error", { "cases": { "kebabCase": true, "pascalCase": true } }]
			}
		},
		{
			// A test that asserts a `javascript:` URL is rejected has to name one. And jest-dom is not
			// registered in the Vitest project (`vite.config.ts` sets up `setup-msw.ts` alone), so its
			// matchers throw `Invalid Chai property` at runtime with `tsc` perfectly happy.
			"files": ["**/*.test.ts", "**/*.test.tsx"],
			"rules": {
				"no-script-url": "off",
				"vitest/no-restricted-matchers": [
					"error",
					{
						"toBeInTheDocument": "Not registered here. Use `expect(el).not.toBeNull()`, or `queryBy*` with `toBeNull()` for absence.",
						"toHaveAttribute": "Not registered here. Read the attribute and assert on it.",
						"toBeDisabled": "Not registered here. Query with the element type and read `.disabled`.",
						"toBeVisible": "Not registered here. Assert on the value you mean.",
						"toHaveTextContent": "Not registered here. Assert on `el.textContent`.",
						"toHaveClass": "Not registered here. Assert on `el.className`."
					}
				]
			}
		},
		{
			// A double for an async API is `async` so it returns a promise like the real thing; having
			// nothing to await is the point.
			"files": ["**/*.test.ts", "**/*.test.tsx", "**/*.stories.tsx", "src/test/**", "src/mocks/**"],
			"rules": { "typescript/require-await": "off" }
		},
		{
			// All four read a Storybook story object, and only a story file holds one. `parameters.a11y`
			// is also how `.storybook/preview.tsx` sets the project-wide bar none of them may lower; a
			// `play` property elsewhere belongs to a media element; `canvasElement` exists only inside a
			// play; and `meta`/`Meta` are recognised by name, which is Storybook's convention and
			// nobody else's promise.
			"files": ["**/*.stories.tsx"],
			"rules": {
				// `vitest/expect-expect` cannot see these: a play is a property on a story object, not a
				// body inside `test()`. This rule carries its own list, which is `assertFunctionNames`
				// above widened to the `expect*` and `assert*` prefixes that reach `src/test/`'s helpers,
				// so anything counted there is counted here. A literal cannot be shared across JSON and
				// TypeScript, so it is that relation `play-must-assert.test.ts` pins.
				"hephaestus/play-must-assert": "error",
				// The file path is the component tree's source of truth. An explicit title is only for a
				// deliberate reader-facing relocation, never a differently-cased copy of that path.
				"hephaestus/prefer-auto-story-title": "error",
				// One story quietly exempting itself leaves the whole suite green.
				"hephaestus/no-story-a11y-override": "error",
				"hephaestus/no-within-canvas-element": "error",
				"hephaestus/typed-story-meta": "error"
			}
		},
		{
			// Playwright names its fixture callback `use`, which the React plugin reads as the hook.
			"files": ["e2e/**"],
			"rules": { "react-hooks/rules-of-hooks": "off" }
		}
	]
}
