{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	// Shared test conventions for the web and native clients. Platform-specific matchers stay in each tree.
	"plugins": ["vitest"],
	"rules": {
		// -- Tests -----------------------------------------------------------------------------------
		"vitest/prefer-called-once": "error",
		"vitest/prefer-called-with": "error",
		"vitest/prefer-called-exactly-once-with": "error",
		"vitest/prefer-to-have-been-called-times": "error",
		"vitest/prefer-expect-resolves": "error",
		"vitest/prefer-expect-type-of": "error",
		"vitest/prefer-spy-on": "error",
		"vitest/prefer-to-be-object": "error",
		"vitest/no-large-snapshots": "error",
		// `it` everywhere: two spellings of the same call are two things to grep for.
		"vitest/consistent-test-it": ["error", { "fn": "it", "withinDescribe": "it" }],
		// A `describe` names the unit under test as written, so only the `it` titles are sentences.
		"vitest/prefer-lowercase-title": ["error", { "ignore": ["describe"] }],
		"vitest/no-identical-title": "error",
		"vitest/no-duplicate-hooks": "error",
		"vitest/no-alias-methods": "error",
		"vitest/no-test-prefixes": "error",
		"vitest/no-test-return-statement": "error",
		"vitest/no-import-node-test": "error",
		"vitest/no-mocks-import": "error",
		"vitest/no-interpolation-in-snapshots": "error",
		"vitest/no-unneeded-async-expect-function": "error",
		"vitest/prefer-each": "error",
		"vitest/prefer-todo": "error",
		"vitest/prefer-hooks-on-top": "error",
		"vitest/prefer-hooks-in-order": "error",
		"vitest/prefer-comparison-matcher": "error",
		"vitest/prefer-equality-matcher": "error",
		"vitest/prefer-to-be": "error",
		"vitest/prefer-to-contain": "error",
		"vitest/prefer-to-have-length": "error",
		"vitest/prefer-mock-promise-shorthand": "error",
		"vitest/prefer-mock-return-shorthand": "error",
		"vitest/consistent-vitest-vi": "error",
		"vitest/prefer-strict-equal": "error",
		"vitest/prefer-strict-boolean-matchers": "error",
		// Reaches `&&`, `||`, `??` and `?.` in a test body too: `getAttribute("href") ?? ""` turns a
		// missing attribute into an empty string the assertion then accepts. Setup that really does
		// branch belongs in the mock handler, not the test body.
		"vitest/no-conditional-in-test": "error",
		// Vitest's `expect(actual, message)` takes a second argument, which the default of 1 rejects. A
		// literal message is tolerated even at 1, so this is load-bearing only where the label is
		// computed — which is every assertion inside a loop, the shape that needs a label most.
		"vitest/valid-expect": ["error", { "maxArgs": 2 }],
		// A Testing Library query IS the assertion: `getBy*` throws when it finds nothing. Supplying
		// this option replaces oxlint's defaults rather than extending them, so the first four restate
		// its list — drop one and a plain `expect()` stops counting.
		"vitest/expect-expect": [
			"error",
			{
				"assertFunctionNames": [
					"expect",
					"expectTypeOf",
					"assert",
					"assertType",
					"getBy*",
					"**.getBy*",
					"getAllBy*",
					"**.getAllBy*",
					"findBy*",
					"**.findBy*",
					"findAllBy*",
					"**.findAllBy*",
				],
			},
		],
		// `toHaveBeenCalledWith` is not type-narrowed by this Vitest/TS setup — a wrong argument against
		// `vi.fn<(open: boolean) => void>()` type-checks clean — so the parameter buys nothing.
		"vitest/require-mock-type-parameters": "off",
	},
}
