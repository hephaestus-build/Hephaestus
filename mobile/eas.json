{
	"cli": {
		"version": "24.7.0",
		"appVersionSource": "remote",
		"requireCommit": true
	},
	"build": {
		"development": {
			"developmentClient": true,
			"distribution": "internal",
			"channel": "development",
			"environment": "development",
			"env": { "APP_VARIANT": "development" }
		},
		"development-simulator": {
			"extends": "development",
			"ios": { "simulator": true }
		},
		"preview": {
			"distribution": "internal",
			"channel": "preview",
			"environment": "preview",
			"env": { "APP_VARIANT": "preview" }
		},
		"production": {
			"channel": "production",
			"environment": "production",
			"autoIncrement": true,
			"env": { "APP_VARIANT": "production" }
		}
	},
	"submit": {
		"production": {}
	}
}
