{
	"title": "Hephaestus: provider events and messaging",
	"filename": "messaging",
	"rows": [
		{
			"title": "Do provider events arrive?",
			"panels": [
				{
					"title": "Events stored, per minute",
					"description": "By provider and outcome.",
					"expr": [
						"sum by (stream, outcome) (rate(webhook_publish_total{job=\"hephaestus\"}[5m])) * 60"
					],
					"alias": ["{{stream}} {{outcome}}"],
					"unit": "/min",
					"showLegend": true,
					"width": 6
				},
				{
					"title": "Events refused, per hour",
					"description": "By reason.",
					"expr": ["sum by (reason) (increase(webhook_rejected_total{job=\"hephaestus\"}[1h]))"],
					"alias": ["{{reason}}"],
					"showLegend": true,
					"width": 6
				},
				{
					"title": "GitHub redeliveries, per hour",
					"description": "By outcome.",
					"expr": [
						"sum by (outcome) (increase(github_webhook_redelivery_total{job=\"hephaestus\"}[1h]))"
					],
					"alias": ["{{outcome}}"],
					"showLegend": true,
					"width": 6
				},
				{
					"title": "Unrecovered GitHub events",
					"description": "Events of the last two hours that failed every attempt.",
					"expr": ["max(github_webhook_unrecovered{job=\"hephaestus\"})"],
					"alias": ["events"],
					"showLegend": true,
					"width": 6
				}
			]
		},
		{
			"title": "How late are events?",
			"panels": [
				{
					"title": "Wait p95, per provider",
					"description": "From the receipt to the first handling. The alert bound is 5 minutes.",
					"expr": [
						"histogram_quantile(0.95, sum by (le, kind) (rate(integration_message_lag_seconds_bucket{job=\"hephaestus\"}[5m])))"
					],
					"alias": ["{{kind}}"],
					"unit": "s",
					"showLegend": true,
					"width": 6
				},
				{
					"title": "Handling p95, per provider",
					"description": "The handling of one delivery.",
					"expr": [
						"histogram_quantile(0.95, sum by (le, kind) (rate(integration_message_process_duration_seconds_bucket{job=\"hephaestus\"}[5m])))"
					],
					"alias": ["{{kind}}"],
					"unit": "s",
					"showLegend": true,
					"width": 6
				}
			]
		},
		{
			"title": "Do consumers keep up?",
			"panels": [
				{
					"title": "Events that wait in the inbox",
					"description": "Queued and leased, per provider.",
					"expr": [
						"max by (provider) (integration_consumer_backlog{job=\"hephaestus\",state=\"QUEUED\"})",
						"max by (provider) (integration_consumer_backlog{job=\"hephaestus\",state=\"LEASED\"})"
					],
					"alias": ["{{provider}} queued", "{{provider}} leased"],
					"showLegend": true,
					"width": 6
				},
				{
					"title": "Oldest due event",
					"description": "Per provider. 0 when no event is due.",
					"expr": ["max by (provider) (integration_consumer_oldest_due_seconds{job=\"hephaestus\"})"],
					"alias": ["{{provider}}"],
					"unit": "s",
					"showLegend": true,
					"width": 6
				},
				{
					"title": "Retries and dead letters, per hour",
					"description": "A retry waits for its backoff. A dead letter waits for an administrator's replay.",
					"expr": [
						"sum(increase(integration_consumer_retry_total{job=\"hephaestus\"}[1h]))",
						"sum(increase(integration_consumer_poison_total{job=\"hephaestus\"}[1h]))"
					],
					"alias": ["retry", "dead letter"],
					"showLegend": true,
					"width": 6
				},
				{
					"title": "Dead letters",
					"description": "Per provider, until their retention ends.",
					"expr": ["max by (provider) (integration_consumer_backlog{job=\"hephaestus\",state=\"DEAD\"})"],
					"alias": ["{{provider}}"],
					"showLegend": true,
					"width": 6
				}
			]
		}
	]
}
