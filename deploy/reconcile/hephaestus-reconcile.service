[Unit]
Description=Reconcile this host to its Hephaestus release channel
Documentation=https://docs.hephaestus.build/admin/pull-based-deployment
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/hephaestus/reconcile.env
StateDirectory=hephaestus
StateDirectoryMode=0750
# The tooling link names the installed verifier. After a verified apply, the reconciler advances
# it and these units only to a descendant source commit. Runtime rollback and startup recovery
# retain newer tooling, including a version the operator installed before the runtime upgrade.
ExecStart=/usr/bin/env node /var/lib/hephaestus/tooling/scripts/reconcile-deployment.ts
TimeoutStartSec=2h
# Helm keeps its cache, configuration and data in the state directory: ProtectHome hides /root.
Environment=HELM_CACHE_HOME=/var/lib/hephaestus/helm/cache
Environment=HELM_CONFIG_HOME=/var/lib/hephaestus/helm/config
Environment=HELM_DATA_HOME=/var/lib/hephaestus/helm/data

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=-/var/lib/node_exporter
ReadWritePaths=/etc/systemd/system
# systemctl uses local Unix sockets to reload the deployed units.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
