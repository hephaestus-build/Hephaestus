{
	"$schema": "../node_modules/oxlint/configuration_schema.json",

	// The application layer owns the shared React Compiler, Vitest and Storybook policy.
	"extends": ["../oxlint.app.jsonc"],

	// Named here because `load-config.ts` drops a base's `jsPlugins` on the object path (`AGENTS.md`
	// § Lint and format).
	"jsPlugins": ["../webapp/tools/oxlint/index.ts"],

	// `webextensions` declares `chrome`; the extension itself reaches the API through `wxt/browser`.
	"env": { "browser": true, "webextensions": true, "es2022": true },
	"settings": { "react": { "version": "19.2" } },

	"ignorePatterns": [
		// Generated.
		"src/api",
		// Build output.
		".output",
		".wxt",
		"playwright-report",
		"storybook-static"
	],

	"overrides": [
		{
			// The configs reach the webapp's lint loader and the root manifest, across the tree boundary
			// no alias spans.
			"files": ["vite.config.ts", "wxt.config.ts"],
			"rules": { "import/no-relative-parent-imports": "off" }
		},
		{
			// UI text follows the writing standard in all of `src`. The next entry turns the rule off
			// for tests, which assert on text.
			"files": ["src/**"],
			"rules": { "hephaestus/ste-ui-text": "error" }
		},
		{
			"files": ["**/*.test.ts", "**/*.test.tsx"],
			"rules": { "hephaestus/ste-ui-text": "off" }
		},
		{
			// Views, content script and worker only; the configs and the Playwright tree run on Node.
			"files": ["src/**"],
			"rules": {
				// Every request goes through the worker's generated client (`src/background/api.ts`).
				"no-restricted-globals": [
					"error",
					{ "name": "fetch", "message": "Requests go through the worker's generated client." },
					{
						"name": "XMLHttpRequest",
						"message": "Requests go through the worker's generated client."
					}
				]
			}
		}
	]
}
