{
	"name": "extension",
	"version": "0.0.0-development",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "wxt --mode development",
		"build": "wxt build",
		"build:dev": "wxt build --mode development",
		"zip": "wxt zip",
		"zip:dev": "wxt zip --mode development",
		"test": "vp test --run --project unit --reporter=default --reporter=junit --outputFile.junit=test-results/junit-unit.xml",
		"test:storybook": "vp test --run --project storybook --reporter=default --reporter=junit --outputFile.junit=test-results/junit-stories.xml",
		"test:e2e": "playwright test",
		"storybook:dev": "storybook dev -p 6007",
		"generate:api": "vp run --filter api-generator generate:extension",
		"build:e2e": "wxt build --mode e2e"
	},
	"dependencies": {
		"@tanstack/react-query": "5.102.8",
		"@wxt-dev/browser": "0.3.7",
		"cn": "0.2.6",
		"lucide-react": "1.41.0",
		"react": "catalog:",
		"react-dom": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@playwright/test": "1.64.1",
		"@storybook/addon-a11y": "10.6.5",
		"@storybook/addon-docs": "10.6.5",
		"@storybook/addon-themes": "10.6.5",
		"@storybook/addon-vitest": "10.6.5",
		"@storybook/react-vite": "10.6.5",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "24.19.2",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vitejs/plugin-react": "6.1.2",
		"@vitest/browser": "catalog:",
		"@vitest/browser-playwright": "catalog:",
		"@webext-core/fake-browser": "2.0.1",
		"jsdom": "30.1.3",
		"oxc-transform-react": "0.152.0",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"playwright": "1.64.1",
		"storybook": "10.6.5",
		"tailwindcss": "4.3.3",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:",
		"wxt": "0.21.5"
	}
}
