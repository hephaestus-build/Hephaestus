{
	"name": "extension",
	"version": "0.0.0-development",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "wxt --mode development",
		"build": "wxt build",
		"build:dev": "wxt build --mode development",
		"zip": "wxt zip",
		"zip:dev": "wxt zip --mode development",
		"test": "vp test --run --project unit --reporter=default --reporter=junit --outputFile.junit=test-results/junit-unit.xml",
		"test:storybook": "vp test --run --project storybook --reporter=default --reporter=junit --outputFile.junit=test-results/junit-stories.xml",
		"test:e2e": "playwright test",
		"storybook:dev": "storybook dev -p 6007",
		"generate:api": "openapi-ts",
		"build:e2e": "wxt build --mode e2e"
	},
	"dependencies": {
		"@tanstack/react-query": "5.102.8",
		"@wxt-dev/browser": "0.3.0",
		"cn": "0.2.6",
		"lucide-react": "1.41.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"zod": "4.5.4"
	},
	"devDependencies": {
		"@hey-api/openapi-ts": "0.0.0-next-20260824173136",
		"@oxlint/plugins": "catalog:",
		"@playwright/test": "1.63.0",
		"@storybook/addon-a11y": "10.6.0",
		"@storybook/addon-docs": "10.6.0",
		"@storybook/addon-themes": "10.6.0",
		"@storybook/addon-vitest": "10.6.0",
		"@storybook/react-vite": "10.6.0",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "24.13.3",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.7",
		"@vitejs/plugin-react": "6.1.1",
		"@vitest/browser": "catalog:",
		"@vitest/browser-playwright": "catalog:",
		"@webext-core/fake-browser": "2.0.1",
		"jsdom": "30.0.1",
		"oxc-transform-react": "0.145.0",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"playwright": "1.63.0",
		"storybook": "10.6.0",
		"tailwindcss": "4.3.3",
		"typescript": "7.0.2",
