{
	"source": "v1.0.0-rc.1",
	"paths": {
		"/auth/client/configuration": {
			"get": {
				"description": "Public. A client that finds no such endpoint is talking to a server without installed-client sign-in.",
				"operationId": "getClientSignInConfiguration",
				"parameters": [
					{
						"in": "query",
						"name": "clientId",
						"required": true,
						"schema": {
							"type": "string",
							"pattern": "^[a-p]{32}$"
						}
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ClientSignInConfiguration"
								}
							}
						},
						"description": "Whether the client is registered"
					},
					"400": {
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/ProblemDetail"
								}
							}
						},
						"description": "The client id is not a Chrome extension id"
					}
				},
				"summary": "Whether this instance lets the given installed client sign in",
				"tags": ["Client session"]
			}
		},
		"/auth/client/logout": {
			"post": {
				"operationId": "logoutClientSession",
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/ClientRefreshRequest"
							}
						}
					},
					"required": true
				},
				"responses": {
					"204": {
						"description": "Signed out, or the secret was already unknown"
					},
					"400": {
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/ProblemDetail"
								}
							}
						},
						"description": "The body is malformed, or a request with a valid CSRF token also carries the browser session cookie"
					},
					"403": {
						"content": {
							"application/json": {}
						},
						"description": "The request carries the browser session cookie without a valid CSRF token. The server refuses it before the endpoint runs."
					},
					"429": {
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/ProblemDetail"
								}
							}
						},
						"description": "This address sent too many installed-client requests. Wait the number of seconds in the Retry-After header, then try again."
					}
				},
				"summary": "End the session its refresh secret belongs to",
				"tags": ["Client session"]
			}
		},
		"/auth/client/refresh": {
			"post": {
				"operationId": "refreshClientSession",
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/ClientRefreshRequest"
							}
						}
					},
					"required": true
				},
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ClientSessionTokens"
								}
							}
						},
						"description": "Rotated"
					},
					"400": {
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/ProblemDetail"
								}
							}
						},
						"description": "The body is malformed, or a request with a valid CSRF token also carries the browser session cookie"
					},
					"401": {
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/ProblemDetail"
								}
							}
						},
						"description": "The session has ended. Sign in again."
					},
					"403": {
						"content": {
							"application/json": {}
						},
						"description": "The request carries the browser session cookie without a valid CSRF token. The server refuses it before the endpoint runs."
					},
					"429": {
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/ProblemDetail"
								}
							}
						},
						"description": "This address sent too many installed-client requests. Wait the number of seconds in the Retry-After header, then try again."
					}
				},
				"summary": "Rotate the session's access token and refresh secret",
				"tags": ["Client session"]
			}
		},
		"/identity-providers": {
			"get": {
				"operationId": "listIdentityProviders",
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"type": "array",
									"items": {
										"$ref": "#/components/schemas/IdentityProviderView"
									}
								}
							}
						},
						"description": "OK"
					}
				},
				"summary": "List available identity providers",
				"tags": ["Auth discovery"]
			}
		},
		"/user": {
			"get": {
				"operationId": "getCurrentUser",
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/CurrentUserView"
								}
							}
						},
						"description": "OK"
					}
				},
				"summary": "Get the current user",
				"tags": ["Account"]
			}
		},
		"/user/consent": {
			"get": {
				"operationId": "getConsentStatus",
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ConsentStatus"
								}
							}
						},
						"description": "OK"
					}
				},
				"summary": "Get the current consent notice and status",
				"tags": ["Consent"]
			}
		},
		"/workspaces": {
			"get": {
				"operationId": "listWorkspaces",
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"type": "array",
									"items": {
										"$ref": "#/components/schemas/WorkspaceListItem"
									}
								}
							}
						},
						"description": "Workspace list"
					}
				},
				"summary": "List all workspaces",
				"tags": ["workspace-registry"]
			}
		},
		"/workspaces/{workspaceSlug}": {
			"get": {
				"operationId": "getWorkspace",
				"parameters": [
					{
						"description": "Workspace slug",
						"in": "path",
						"name": "workspaceSlug",
						"required": true,
						"schema": {
							"type": "string",
							"maxLength": 51,
							"minLength": 3,
							"pattern": "^(?!.*--)[a-z0-9][a-z0-9-]{1,49}[a-z0-9]$"
						}
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Workspace"
								}
							}
						},
						"description": "Workspace returned"
					}
				},
				"summary": "Fetch a workspace by slug",
				"tags": ["workspace"]
			}
		},
		"/workspaces/{workspaceSlug}/practices/feedback/on-work": {
			"get": {
				"description": "Read-only metadata for up to 50 in-context pieces of feedback addressed to the caller with recorded provider comments, newest delivery first. Uses the exact connected-provider work lookup. Only recorded successful deliveries are included, even when the remaining delivery failed. Incomplete reviews omit draft practice metadata. No bodies, private conversations or replaced feedback; admin status does not broaden the recipient. Permalinks are recorded provider links, not live existence checks.",
				"operationId": "getOwnDeliveredWorkFeedback",
				"parameters": [
					{
						"description": "Workspace slug",
						"in": "path",
						"name": "workspaceSlug",
						"required": true,
						"schema": {
							"type": "string",
							"maxLength": 51,
							"minLength": 3,
							"pattern": "^(?!.*--)[a-z0-9][a-z0-9-]{1,49}[a-z0-9]$"
						}
					},
					{
						"in": "query",
						"name": "url",
						"required": true,
						"schema": {
							"type": "string",
							"maxLength": 2048,
							"minLength": 0
						}
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/DeliveredWorkFeedback"
								}
							}
						},
						"description": "OK"
					}
				},
				"summary": "The caller's recorded feedback comments on this work",
				"tags": ["Practice feedback"]
			}
		},
		"/workspaces/{workspaceSlug}/practices/items/{itemId}/own-trace": {
			"get": {
				"operationId": "getOwnItemTrace",
				"parameters": [
					{
						"description": "Workspace slug",
						"in": "path",
						"name": "workspaceSlug",
						"required": true,
						"schema": {
							"type": "string",
							"maxLength": 51,
							"minLength": 3,
							"pattern": "^(?!.*--)[a-z0-9][a-z0-9-]{1,49}[a-z0-9]$"
						}
					},
					{
						"in": "path",
						"name": "itemId",
						"required": true,
						"schema": {
							"type": "string",
							"maxLength": 19,
							"pattern": "^[1-9][0-9]*$"
						}
					},
					{
						"in": "query",
						"name": "reviewId",
						"required": true,
						"schema": {
							"type": "string",
							"format": "uuid"
						}
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/OwnItemTrace"
								}
							}
						},
						"description": "OK"
					}
				},
				"summary": "Trace your results from an item review",
				"tags": ["item-trace"]
			}
		},
		"/workspaces/{workspaceSlug}/practices/items/{itemId}/reviews": {
			"get": {
				"operationId": "listOwnItemReviews",
				"parameters": [
					{
						"description": "Workspace slug",
						"in": "path",
						"name": "workspaceSlug",
						"required": true,
						"schema": {
							"type": "string",
							"maxLength": 51,
							"minLength": 3,
							"pattern": "^(?!.*--)[a-z0-9][a-z0-9-]{1,49}[a-z0-9]$"
						}
					},
					{
						"in": "path",
						"name": "itemId",
						"required": true,
						"schema": {
							"type": "string",
							"maxLength": 19,
							"pattern": "^[1-9][0-9]*$"
						}
					},
					{
						"in": "query",
						"name": "page",
						"required": false,
						"schema": {
							"type": "integer",
							"format": "int32",
							"default": 0
						}
					},
					{
						"in": "query",
						"name": "size",
						"required": false,
						"schema": {
							"type": "integer",
							"format": "int32",
							"default": 20
						}
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/PageResponseDTOProfileReview"
								}
							}
						},
						"description": "OK"
					}
				},
				"summary": "List your reviews of an item",
				"tags": ["item"]
			}
		},
		"/workspaces/{workspaceSlug}/practices/results": {
			"get": {
				"description": "Paginated results for the authenticated developer with optional filters",
				"operationId": "listOwnResults",
				"parameters": [
					{
						"description": "Workspace slug",
						"in": "path",
						"name": "workspaceSlug",
						"required": true,
						"schema": {
							"type": "string",
							"maxLength": 51,
							"minLength": 3,
							"pattern": "^(?!.*--)[a-z0-9][a-z0-9-]{1,49}[a-z0-9]$"
						}
					},
					{
						"in": "query",
						"name": "practiceSlug",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"in": "query",
						"name": "groupSlug",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"in": "query",
						"name": "outcome",
						"required": false,
						"schema": {
							"type": "string",
							"enum": ["MET", "NOT_MET", "DOES_NOT_APPLY", "COULD_NOT_DETERMINE"]
						}
					},
					{
						"in": "query",
						"name": "itemKind",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"in": "query",
						"name": "itemId",
						"required": false,
						"schema": {
							"type": "string",
							"maxLength": 19,
							"pattern": "^[1-9][0-9]*$"
						}
					},
					{
						"in": "query",
						"name": "severity",
						"required": false,
						"schema": {
							"type": "array",
							"items": {
								"type": "string",
								"enum": ["CRITICAL", "MAJOR", "MINOR", "TRIVIAL"]
							}
						}
					},
					{
						"in": "query",
						"name": "displayableOnly",
						"required": false,
						"schema": {
							"type": "boolean"
						}
					},
					{
						"in": "query",
						"name": "sort",
						"required": false,
						"schema": {
							"type": "string",
							"enum": ["NEWEST", "OLDEST", "ACTIONABILITY"]
						}
					},
					{
						"in": "query",
						"name": "page",
						"required": false,
						"schema": {
							"type": "integer",
							"format": "int32"
						}
					},
					{
						"in": "query",
						"name": "size",
						"required": false,
						"schema": {
							"type": "integer",
							"format": "int32"
						}
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/PageResponseDTOResultList"
								}
							}
						},
						"description": "Paginated results returned"
					}
				},
				"summary": "List results for current developer",
				"tags": ["Practice Results"]
			}
		},
		"/workspaces/{workspaceSlug}/practices/review-context": {
			"get": {
				"description": "Reads the address only: nothing is fetched from it. The address must be on the server this workspace is connected to. Every way of not finding the work — not mirrored, not monitored here, another server, deleted or confidential — is the same 404.",
				"operationId": "resolveReviewContext",
				"parameters": [
					{
						"description": "Workspace slug",
						"in": "path",
						"name": "workspaceSlug",
						"required": true,
						"schema": {
							"type": "string",
							"maxLength": 51,
							"minLength": 3,
							"pattern": "^(?!.*--)[a-z0-9][a-z0-9-]{1,49}[a-z0-9]$"
						}
					},
					{
						"description": "The provider page's address, as the browser shows it",
						"in": "query",
						"name": "url",
						"required": true,
						"schema": {
							"type": "string",
							"maxLength": 2048,
							"minLength": 0
						}
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ReviewContext"
								}
							}
						},
						"description": "The work, and what the caller may do about it"
					},
					"400": {
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/ProblemDetail"
								}
							}
						},
						"description": "Not an HTTPS address, or not the page of a pull request, merge request or issue"
					},
					"403": {
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/ProblemDetail"
								}
							}
						},
						"description": "The caller is not a member of this workspace"
					},
					"404": {
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/ProblemDetail"
								}
							}
						},
						"description": "This workspace has no reviewed work at this address"
					}
				},
				"summary": "Find the reviewed work a provider page shows",
				"tags": ["Practice review requests"]
			}
		},
		"/workspaces/{workspaceSlug}/practices/review-requests": {
			"post": {
				"operationId": "requestReview",
				"parameters": [
					{
						"description": "Workspace slug",
						"in": "path",
						"name": "workspaceSlug",
						"required": true,
						"schema": {
							"type": "string",
							"maxLength": 51,
							"minLength": 3,
							"pattern": "^(?!.*--)[a-z0-9][a-z0-9-]{1,49}[a-z0-9]$"
						}
					}
				],
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/CreateReviewRequest"
							}
						}
					},
					"required": true
				},
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ReviewRequestOutcome"
								}
							}
						},
						"description": "OK"
					}
				},
				"summary": "Ask for a review of an item",
				"tags": ["review-request"]
			}
		}
	},
	"components": {
		"schemas": {
			"ClientSignInConfiguration": {
				"type": "object",
				"properties": {
					"registered": {
						"type": "boolean"
					}
				},
				"required": ["registered"]
			},
			"ProblemDetail": {
				"type": "object",
				"properties": {
					"detail": {
						"type": "string"
					},
					"instance": {
						"type": "string",
						"format": "uri"
					},
					"properties": {
						"type": "object",
						"additionalProperties": {}
					},
					"status": {
						"type": "integer",
						"format": "int32"
					},
					"title": {
						"type": "string"
					},
					"type": {
						"type": "string",
						"format": "uri"
					}
				}
			},
			"ClientRefreshRequest": {
				"type": "object",
				"properties": {
					"refreshToken": {
						"type": "string",
						"pattern": "^[A-Za-z0-9_-]{43}$"
					}
				},
				"required": ["refreshToken"]
			},
			"ClientSessionTokens": {
				"type": "object",
				"properties": {
					"accessToken": {
						"type": "string"
					},
					"accessTokenExpiresAt": {
						"type": "string",
						"format": "date-time"
					},
					"refreshToken": {
						"type": "string"
					},
					"sessionExpiresAt": {
						"type": "string",
						"format": "date-time"
					}
				},
				"required": ["accessToken", "accessTokenExpiresAt", "refreshToken", "sessionExpiresAt"]
			},
			"IdentityProviderView": {
				"type": "object",
				"description": "One row per sign-in option. <code>providerType</code> drives the SPA's icon choice; <code>baseUrl</code> is\n the OAuth instance origin (scheme + host[:port]) of the authorization endpoint, so the\n workspace-creation wizard can match a target instance to its login.\n\n <p><b>baseUrl is the OAuth origin, not the SCM API origin.</b> It is only meaningful for GitLab rows,\n where the OAuth origin and the API origin coincide (e.g. <code>https://gitlab.example.com</code>). For a\n GitHub row it is <code>https://github.com</code> (the OAuth host), NOT <code>https://api.github.com</code>; the\n sole consumer (the workspace wizard) matches GitLab self-hosted origins and never relies on the GitHub\n value, so the discrepancy is harmless. Do not treat this as an SCM API base URL.",
				"properties": {
					"baseUrl": {
						"type": "string"
					},
					"displayName": {
						"type": "string"
					},
					"providerType": {
						"type": "string"
					},
					"registrationId": {
						"type": "string"
					}
				}
			},
			"CurrentUserView": {
				"type": "object",
				"properties": {
					"accessTokenExpiresAt": {
						"type": "integer",
						"format": "int64"
					},
					"appRole": {
						"type": "string"
					},
					"avatarUrl": {
						"type": "string"
					},
					"displayName": {
						"type": "string"
					},
					"gitProviderId": {
						"type": "string"
					},
					"id": {
						"type": "integer",
						"format": "int64"
					},
					"identityProvider": {
						"type": "string"
					},
					"linkedProviders": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/LinkedProvider"
						}
					},
					"primaryEmail": {
						"type": "string"
					},
					"profileUrl": {
						"type": "string"
					},
					"roles": {
						"type": "array",
						"items": {
							"type": "string"
						}
					},
					"status": {
						"type": "string"
					},
					"username": {
						"type": "string"
					}
				}
			},
			"LinkedProvider": {
				"type": "object",
				"description": "A provider instance the current user is linked to: its type + server-url origin.",
				"properties": {
					"serverUrl": {
						"type": "string"
					},
					"type": {
						"type": "string"
					}
				}
			},
			"ConsentStatus": {
				"type": "object",
				"properties": {
					"completed": {
						"type": "boolean"
					},
					"noticeVersion": {
						"type": "string",
						"description": "Version of the first-login wording the client must be rendering"
					},
					"participateInResearch": {
						"type": "boolean"
					},
					"researchOrganization": {
						"type": "string",
						"description": "Organization that runs the optional research program, or null when this instance runs none"
					}
				},
